+            write_worker_bundle(
+                run_id=run_id,
+                worker="A_worker",
+                changes=[make_change("apps/demo/shared.ts", sha256="a")],
+                allow_shared_paths=[],
+            )
+            write_worker_bundle(
+                run_id=run_id,
+                worker="B_worker",
+                changes=[make_change("apps/demo/shared.ts", sha256="b")],
+                allow_shared_paths=[],
