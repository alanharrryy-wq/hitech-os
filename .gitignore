# Node / PNPM / Turbo
node_modules/
.pnpm-store/
.npm/
.turbo/

# Build outputs
dist/
build/
out/
coverage/
*.tsbuildinfo

# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.venv/
venv/

# Environment / secrets
.env
.env.*
!.env.example

# Logs and temp
*.log
*.tmp
*.temp
*.cache
.cache/

# OS/editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# Dangerous artifacts and dumps
**/src/**/*.zip
**/src/**/*.7z
**/src/**/*.rar
**/src/**/*.tar
**/src/**/*.gz
**/src/**/*.sql
**/src/**/*.sqlite
**/src/**/*.dump
**/src/**/*DUMP*
**/src/**/*OUT*
**/src/**/*.bak*
**/src/**/*.png
**/src/**/*.jpg
**/src/**/*.jpeg
**/src/**/*.bmp

# Allow deterministic generated schemas only
!packages/contracts/schemas/generated/*.json

# --- Codex/Factory run artifacts (DO NOT TRACK) ---
tools/codex/runs/
tools/codex/runs/**
tools/codex/**/LOGS/
tools/codex/**/LOGS/**
**/worktrees/
**/worktrees/**
*.log.txt
*.sha256
# root artifacts that should not be tracked (generated outputs)
DIFF.patch
FILES_CREATED.txt
FILES_MODIFIED.txt
COMMANDS_TO_RUN.txt
STATUS.json
FINAL_REPORT*.txt
FINAL_REPORT.txt
# OS / editor junk
*.swp
