    "hydration:scan": "python tools/hydration_sentinel/sentinel.py --repo-root . --output-dir _reports/hydration_sentinel",
    "hydration:scan:smoke": "python tools/hydration_sentinel/sentinel.py --repo-root . --output-dir _reports/hydration_sentinel --max-files 250",
    "hydration:scan:strict": "python tools/hydration_sentinel/sentinel.py --repo-root . --output-dir _reports/hydration_sentinel --strict",
    "keystone:scene:proof:ci": "pnpm --filter @hitech/keystone keystone:scene:proof:ci",
    "keystone:scene:proof:gate": "pnpm --filter @hitech/keystone keystone:scene:proof:gate",
