{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://prisma.local/schemas/support-resolution-action.schema.json",
  "title": "PRISMA Support Resolution Action",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "label", "mode", "mutates", "requiresDryRun", "requiresConfirmation", "safeByDefault", "blockedWhen"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "label": { "type": "string", "minLength": 1 },
    "mode": { "enum": ["diagnose", "simulate", "apply", "export", "handoff", "onsite"] },
    "mutates": { "type": "boolean" },
    "requiresDryRun": { "type": "boolean" },
    "requiresConfirmation": { "type": "boolean" },
    "safeByDefault": { "type": "boolean" },
    "blockedWhen": { "type": "array", "items": { "type": "string" } }
  }
}
