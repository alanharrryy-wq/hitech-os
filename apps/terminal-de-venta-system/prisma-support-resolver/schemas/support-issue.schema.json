{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://prisma.local/schemas/support-issue.schema.json",
  "title": "PRISMA SupportIssue",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "code",
    "category",
    "severity",
    "surface",
    "humanTitle",
    "humanExplanation",
    "technicalExplanation",
    "evidence",
    "detectedBy",
    "canAutoResolve",
    "canRemoteResolve",
    "requiresSetupCode",
    "requiresAdminToken",
    "requiresCloudDeploy",
    "requiresD1Migration",
    "requiresCodex",
    "requiresOnsite",
    "safeActions",
    "blockedActions",
    "recommendedAction",
    "nextStep",
    "operatorMessage",
    "resultCode",
    "secretsExposed"
  ],
  "properties": {
    "code": { "type": "string", "minLength": 1 },
    "category": { "type": "string", "minLength": 1 },
    "severity": { "enum": ["info", "warning", "blocked", "critical"] },
    "surface": { "enum": ["tablet", "pc", "mobile", "cloud-center", "cloud-gateway", "local-runtime"] },
    "customerId": { "type": ["string", "null"] },
    "businessId": { "type": ["string", "null"] },
    "storeId": { "type": ["string", "null"] },
    "deviceId": { "type": ["string", "null"] },
    "terminalId": { "type": ["string", "null"] },
    "licenseId": { "type": ["string", "null"] },
    "setupCode": { "type": ["string", "null"] },
    "humanTitle": { "type": "string", "minLength": 1 },
    "humanExplanation": { "type": "string", "minLength": 1 },
    "technicalExplanation": { "type": "string", "minLength": 1 },
    "evidence": { "type": "array", "items": { "type": "object", "additionalProperties": true } },
    "detectedBy": { "type": "string", "minLength": 1 },
    "canAutoResolve": { "type": "boolean" },
    "canRemoteResolve": { "type": "boolean" },
    "requiresSetupCode": { "type": "boolean" },
    "requiresAdminToken": { "type": "boolean" },
    "requiresCloudDeploy": { "type": "boolean" },
    "requiresD1Migration": { "type": "boolean" },
    "requiresCodex": { "type": "boolean" },
    "requiresOnsite": { "type": "boolean" },
    "safeActions": { "type": "array", "items": { "type": "string" } },
    "blockedActions": { "type": "array", "items": { "type": "string" } },
    "recommendedAction": { "type": "string", "minLength": 1 },
    "nextStep": { "type": "string", "minLength": 1 },
    "operatorMessage": { "type": "string", "minLength": 1 },
    "resultCode": { "type": "string", "minLength": 1 },
    "secretsExposed": { "const": false }
  }
}
