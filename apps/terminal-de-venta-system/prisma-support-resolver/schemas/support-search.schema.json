{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://prisma.local/schemas/support-search.schema.json",
  "title": "PRISMA Support Search Request",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "query": { "type": "string" },
