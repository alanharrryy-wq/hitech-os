{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://prisma.local/schemas/surface-status.schema.json",
  "title": "PRISMA SurfaceStatus",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "surface",
    "visibleStatus",
    "operationStatus",
    "licenseStatus",
    "assignmentStatus",
    "primaryIssueCode",
    "issues",
    "supportSummary",
    "nextStep",
    "featuresAllowed",
    "featuresBlocked",
    "source",
    "secretsExposed"
  ],
  "properties": {
    "surface": { "enum": ["tablet", "pc", "mobile"] },
    "visibleStatus": { "type": "string", "minLength": 1 },
    "operationStatus": { "enum": ["ready", "warning", "blocked", "needs_setup", "needs_support", "unknown"] },
    "licenseStatus": { "type": "string" },
    "assignmentStatus": { "type": "string" },
    "customerId": { "type": ["string", "null"] },
    "businessId": { "type": ["string", "null"] },
    "storeId": { "type": ["string", "null"] },
    "deviceId": { "type": ["string", "null"] },
    "terminalId": { "type": ["string", "null"] },
    "licenseId": { "type": ["string", "null"] },
    "plan": { "type": ["string", "null"] },
    "primaryIssueCode": { "type": "string" },
    "issues": { "type": "array", "items": { "$ref": "support-issue.schema.json" } },
    "supportSummary": { "type": "string" },
    "nextStep": { "type": "string" },
    "featuresAllowed": { "type": "integer", "minimum": 0 },
    "featuresBlocked": { "type": "integer", "minimum": 0 },
    "lastRefreshAt": { "type": ["string", "null"] },
    "source": { "type": "string" },
    "secretsExposed": { "const": false }
  }
}
