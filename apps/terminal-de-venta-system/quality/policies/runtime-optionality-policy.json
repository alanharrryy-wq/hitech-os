{
  "schemaVersion": "1.0",
  "version": "phase-2-v6-final-repair",
  "rules": {
    "commit": "runtime services optional",
    "pr": "runtime services optional unless profile override marks required",
    "runtime": "runtime services probed on PRISMA real local ports; missing optional service is S3 diagnostic",
