  "offlineOptionalServiceSeverity": "info",
  "offlineOptionalServiceWarnings": false,
  "confirmedPorts": [
    3000,
    3110,
    3120,
    3130,
    3140,
    3150
  ],
  "runtimeProbePorts": [
    3110,
