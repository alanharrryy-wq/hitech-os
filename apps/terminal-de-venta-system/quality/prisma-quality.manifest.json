{
  "schemaVersion": "1.0",
  "systemName": "PRISMA Quality Operating System",
  "systemVersion": "2.0.6-phase-2-v6-final-repair",
  "phase": "phase-2-runtime-gates-operational-health",
  "repoName": "terminal-de-venta-system",
  "dbSafetyMode": "real-db-inspect-only",
  "cloudflareMode": "optional-profile-only",
  "defaultOutDir": "F:\\descargasf",
  "layers": [
    "Tablet",
    "PC",
    "Mobile",
    "Core",
    "Control",
    "Cloudflare",
    "Quality"
  ],
  "profiles": [
    "cloudflare",
    "commit",
    "diagnose",
    "pr",
    "release",
    "runtime",
    "watch"
  ],
  "gates": [
    "Q0",
    "Q1",
    "Q11",
    "Q13",
    "Q14",
    "Q15",
    "Q2",
    "Q3",
    "Q4",
    "Q5",
    "Q6",
    "Q7",
    "Q8",
    "Q9"
  ],
  "contracts": [
    "CONTRACT_TABLET_SOVEREIGNTY",
    "CONTRACT_IDEMPOTENT_SYNC",
    "CONTRACT_MOBILE_TRUTHFULNESS",
    "CONTRACT_CONTROL_AUDIT_ONLY",
    "CONTRACT_NO_FAKE_GREEN",
    "CONTRACT_NO_DESTRUCTIVE_TESTING_ON_REAL_DB",
    "CONTRACT_CLOUDFLARE_OPTIONAL_BASE",
    "CONTRACT_SCHEMA_MIGRATION_PARITY",
    "CONTRACT_TRACEABLE_OPERATION",
    "CONTRACT_RELEASE_EVIDENCE_REQUIRED",
    "CONTRACT_PRISMA_NOT_POS_ONLY"
  ],
  "writeAllowlist": [
    "F:\\descargasf\\PRISMA_QUALITY_OS_<runId>"
  ],
  "phaseExitRules": {
    "noFakeGreen": true,
    "tabletSovereigntyIsS0": true,
    "cloudflareCannotBlockBase": true,
    "realDbIsInspectOnly": true,
    "everyPassRequiresEvidence": true,
    "criticalSkippedGateBlocks": true
  },
  "calibration": {
    "version": "v4",
    "description": "Boundary scanner blocks hard runtime dependencies while treating plain vocabulary and documentation as evidence-only.",
    "policy": "quality/policies/boundary-scan-policy.json"
  },
  "phase2": {
    "name": "Runtime Gates & Operational Health",
    "runtimeManifest": "quality/runtime/runtime-port-manifest.json",
    "serviceOptionality": "quality/runtime/service-optionality.json",
    "cloudflareStillOptional": true,
    "startsServices": false,
    "mutatesDatabase": false,
    "newGates": [
      "Q5",
      "Q7",
      "Q8",
      "Q11",
      "Q14"
    ],
    "version": "v6-final-repair",
    "portPolicy": "Use PRISMA real local ports only. Do not invent generic Next.js ports.",
    "expectedPrismaPorts": {
      "engine": 3100,
      "prisma-web-eit": 3110,
      "tablet": 3120,
      "pc": 3130,
      "mobile": 3140,
      "control-center": 3150,
      "forms": 3200
    },
    "disabledUntilDiscovered": [
      "chart-lab"
    ],
    "cliNoTopLevelAwait": true,
    "cliKeepAliveWatchdog": true,
    "cliEntryPoint": "quality/bin/prisma-quality.mjs",
    "forbiddenGenericNextPorts": [
      3000,
      3001,
      3002,
      3003
    ]
  }
}
