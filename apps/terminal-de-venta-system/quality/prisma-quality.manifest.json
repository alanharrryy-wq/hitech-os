    "CONTRACT_PRISMA_NOT_POS_ONLY"
  ],
  "writeAllowlist": [
    "F:\\descargasf\\PRISMA_QUALITY_OS_<runId>"
  ],
  "phaseExitRules": {
    "noFakeGreen": true,
    "tabletSovereigntyIsS0": true,
    "cloudflareCannotBlockBase": true,
    "realDbIsInspectOnly": true,
    "everyPassRequiresEvidence": true,
    "criticalSkippedGateBlocks": true
  },
  "calibration": {
    "version": "v4",
    "description": "Boundary scanner blocks hard runtime dependencies while treating plain vocabulary and documentation as evidence-only.",
    "policy": "quality/policies/boundary-scan-policy.json"
  },
  "phase2": {
    "name": "Runtime Gates & Operational Health",
    "runtimeManifest": "quality/runtime/runtime-port-manifest.json",
    "serviceOptionality": "quality/runtime/service-optionality.json",
    "cloudflareStillOptional": true,
    "startsServices": false,
    "mutatesDatabase": false,
    "newGates": [
      "Q5",
      "Q7",
      "Q8",
      "Q11",
      "Q14"
    ],
    "version": "v6-final-repair",
    "portPolicy": "Use PRISMA real local ports only. Do not invent generic Next.js ports.",
    "expectedPrismaPorts": {
      "engine": 3100,
      "prisma-web-eit": 3110,
      "tablet": 3120,
      "pc": 3130,
      "mobile": 3140,
      "control-center": 3150,
      "forms": 3200
    },
    "disabledUntilDiscovered": [
      "chart-lab"
    ],
    "cliNoTopLevelAwait": true,
    "cliKeepAliveWatchdog": true,
    "cliEntryPoint": "quality/bin/prisma-quality.mjs",
    "forbiddenGenericNextPorts": [
      3000,
      3001,
      3002,
      3003
    ]
  },
  "phase3": {
    "name": "Scenario Gates & Operational Playbooks",
    "scenarioManifest": "quality/scenarios/scenario-manifest.json",
    "scenarioRunner": "quality/core/scenario-runner.mjs",
    "newGates": [
      "Q16",
      "Q17",
      "Q18",
      "Q19",
      "Q20"
    ],
    "mutatesData": false,
    "startsServices": false,
    "requiresCloudflare": false,
    "fakeGreenForbidden": true,
    "industrialCRSIncluded": true
  },
  "phase4": {
    "name": "Data Truth, Evidence Ledger & Audit Hardening",
    "dataContractRegistry": "quality/data/data-contract-registry.json",
    "dataTruthPolicy": "quality/policies/data-truth-policy.json",
    "evidenceLedgerPolicy": "quality/policies/evidence-ledger-policy.json",
    "newGates": [
      "Q21",
      "Q22",
      "Q23",
      "Q24",
      "Q25"
    ],
    "mutatesData": false,
    "startsServices": false,
    "requiresCloudflare": false,
    "fakeGreenForbidden": true,
    "dataContractEnforced": true,
    "evidenceLedgerImmutable": true,
    "auditTrailRequired": true,
    "corePrinciple": "Tablet opera. PC gobierna. Mobile supervisa. Core registra. Control audita."
  },
  "phase5": {
    "id": "phase5-release-operator-readiness",
    "name": "PRISMA PQOS Phase 5: Release & Operator Readiness",
    "gates": [
      "Q26",
      "Q27",
      "Q28",
      "Q29",
      "Q30",
      "Q31"
    ],
    "docs": [
      "quality/docs/phase-5-release-operator-readiness.md"
    ],
    "outputs": [
      "F:/descargasf/PRISMA_PQOS_PHASE5_RELEASE_OPERATOR_READINESS_*_RESULT.zip"
    ],
    "rules": [
      "No fake green",
      "Optional local services offline are evidence, not warnings",
      "Required services offline are blockers",
      "Missing official launchers/wrappers block when Control Center is active",
      "Legacy launcher run paths are warnings by default and blockers only under PRISMA_QUALITY_STRICT_PHASE5=1",
      "Automation improvement claims must be machine-readable and verified by Q31"
    ],
    "automationCatalog": "quality/automation/automation-improvements.json",
    "installerPolicy": {
      "qualityReplacementVerify": "self-test + automation are mandatory; phase5 repo readiness is advisory unless --strict-phase5 is passed to the installer",
      "strictEnv": "PRISMA_QUALITY_STRICT_PHASE5=1"
    }
  },
  "automation": {
    "name": "Automation Hardening",
    "catalog": "quality/automation/automation-improvements.json",
    "minimumRequired": 100,
    "gate": "Q31",
    "fakeGreenForbidden": true
  },
  "version": "5.4.0",
  "releaseChannel": "install-safe-plus-warning-repair",
  "phase5WarningRepair": {
    "script": "scripts/repair_phase5_warnings.py",
    "externalScope": "prisma-control-center launchers/wrappers and operator docs",
    "defaultMode": "explicit opt-in",
    "safety": [
      "dry-run",
      "apply",
      "verify",
      "rollback",
      "backup"
    ]
  }
}
