  ],
  "conflictCodes": [
    "product_discontinued",
    "old_local_price",
    "negative_stock",
    "duplicate_event",
    "terminal_not_registered",
    "sale_outside_shift",
    "inconsistent_sequence",
    "invalid_schema",
    "unknown_topic",
    "wrong_scope",
    "payload_hash_mismatch",
    "idempotency_payload_mismatch",
    "unsupported_event_version",
    "unsupported_schema_version",
    "stale_sequence",
    "batch_checksum_mismatch"
  ],
  "envelopeFields": [
    "eventId",
    "source",
    "subject",
    "eventType",
    "topic",
    "eventVersion",
    "schemaVersion",
    "tenantId",
