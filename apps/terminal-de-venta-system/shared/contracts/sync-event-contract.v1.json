    "supplier.created",
    "supplier.updated",
    "supplier.disabled",
    "product.supplier.linked",
    "product.supplier.unlinked",
    "product.supplier.updated"
  ],
  "outboxStates": [
    "pending",
    "sent",
    "failed",
    "acked",
    "conflict",
    "dead_letter"
  ],
  "lifecycleStates": [
    "created_local",
    "queued",
