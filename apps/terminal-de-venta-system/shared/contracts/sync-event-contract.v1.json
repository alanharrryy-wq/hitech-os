      "status": "deprecated"
    },
    {
      "alias": "sync.succeeded",
      "canonical": "sync.event.sent",
      "status": "deprecated"
    },
    {
      "alias": "sync.failed",
      "canonical": "sync.event.failed",
      "status": "deprecated"
    },
    {
      "alias": "outbox.enqueued",
      "canonical": "sync.event.sent",
      "status": "deprecated"
    },
    {
      "alias": "outbox.dispatched",
      "canonical": "sync.event.sent",
      "status": "deprecated"
    },
    {
      "alias": "catalog.updated",
      "canonical": "catalog.product.updated",
      "status": "deprecated"
    },
    {
      "alias": "stock.received",
      "canonical": "stock.adjusted",
      "status": "deprecated"
    },
    {
      "alias": "return.created",
      "canonical": "sale.refunded",
      "status": "deprecated"
    }
  ]
}
