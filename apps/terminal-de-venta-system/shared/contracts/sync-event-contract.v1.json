{
  "contractId": "PRISMA_SYNC_EVENT_CONTRACT_V1",
  "schemaVersion": "1.0.0",
  "sourceOfTruth": "shared/contracts/sync-event-contract.v1.json",
  "eventTopics": [
    "sale.created",
    "sale.completed",
    "ticket.closed",
    "stock.decremented",
    "inventory.low_stock_detected",
    "sale.cancelled",
    "sale.refunded",
    "cash.session.opened",
    "cash.movement.recorded",
    "shift.opened",
    "shift.closed",
    "stock.adjusted",
    "catalog.product.created",
    "catalog.product.updated",
    "sync.event.sent",
    "sync.event.failed",
    "sync.conflict.detected",
    "sync.conflict.resolved",
    "supplier.created",
    "supplier.updated",
    "supplier.disabled",
    "product.supplier.linked",
    "product.supplier.unlinked",
    "product.supplier.updated"
  ],
  "outboxStates": [
    "pending",
    "sent",
    "failed",
    "acked",
    "conflict"
  ],
  "lifecycleStates": [
    "created_local",
    "queued",
    "sent",
    "received",
    "validated",
    "accepted",
    "projected",
    "recognized_not_projected",
    "reconciled",
    "conflict",
    "failed",
    "dead_letter"
  ],
  "conflictCodes": [
    "product_discontinued",
    "old_local_price",
    "negative_stock",
    "duplicate_event",
    "terminal_not_registered",
    "sale_outside_shift",
    "inconsistent_sequence",
    "invalid_schema",
    "unknown_topic"
  ],
  "envelopeFields": [
    "eventId",
    "eventType",
    "topic",
    "idempotencyKey",
    "businessId",
    "terminalId",
    "actorId",
    "source",
    "occurredAt",
    "payload",
    "schemaVersion",
    "correlationId"
  ],
  "compatibilityMappings": [
    {
      "legacy": "topic",
      "canonical": "eventType",
      "meaning": "topic remains accepted for existing Tablet and PC code; eventType is the semantic event name required by the PRISMA event contract."
    },
    {
      "legacy": "acked",
      "canonical": "reconciled",
      "meaning": "acked is a compatibility outbox status and only means reconciled when lifecycleStatus is reconciled after validation, acceptance, projection, and reconciliation."
    },
    {
      "legacy": "shift.opened",
      "canonical": "cash.session.opened",
      "meaning": "shift.opened is accepted as a legacy cash-session-opened event."
    },
    {
      "legacy": "shift.closed",
      "canonical": "cash.movement.recorded",
      "meaning": "shift.closed is accepted as a legacy cash-movement/cash-session close event when payload has cash movement data."
    }
  ],
  "deprecatedAliases": [
    {
      "alias": "sync.conflict_detected",
      "canonical": "sync.conflict.detected",
      "status": "deprecated"
    },
    {
      "alias": "sync.conflict_resolved",
      "canonical": "sync.conflict.resolved",
      "status": "deprecated"
    },
    {
      "alias": "sync.started",
