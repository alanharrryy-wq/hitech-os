  ],
  "requiredTransportFields": [
    "eventId",
    "source",
    "subject",
    "eventType",
    "topic",
    "eventVersion",
    "schemaVersion",
    "tenantId",
    "businessId",
    "storeId",
    "terminalId",
    "deviceId",
    "actorId",
    "aggregateId",
    "originRecordId",
    "idempotencyKey",
    "sequence",
    "correlationId",
    "causationId",
    "traceId",
    "occurredAt",
    "capturedAt",
    "payloadHash",
    "batchId",
    "batchChecksum",
    "payload"
  ],
  "scopeFields": [
    "tenantId",
    "customerId",
    "businessId",
    "storeId",
    "terminalId",
    "deviceId",
    "actorId"
  ],
  "timestampPolicy": {
    "transportFormat": "ISO-8601 UTC",
    "acceptedInputFormats": [
      "ISO-8601",
      "epoch-milliseconds",
      "epoch-seconds"
    ],
    "normalizationRequired": true,
    "clockSkewMustBeObserved": true
  },
  "integrityPolicy": {
    "payloadHash": "sha256(stable-json(payload))",
    "batchChecksum": "sha256(stable-json([{eventId,payloadHash,sequence}]))",
    "sameIdempotencyKeyDifferentPayload": "conflict",
    "checkpointAdvance": "accepted-or-duplicate-only"
  },
  "compatibilityMappings": [
    {
      "legacy": "topic",
      "canonical": "eventType",
      "meaning": "topic remains accepted for existing Tablet and PC code; eventType is the semantic event name required by the PRISMA event contract."
    },
    {
      "legacy": "acked",
      "canonical": "reconciled",
      "meaning": "acked is a compatibility outbox status and only means reconciled when lifecycleStatus is reconciled after validation, acceptance, projection, and reconciliation."
    },
    {
      "legacy": "shift.opened",
      "canonical": "cash.session.opened",
      "meaning": "shift.opened is accepted as a legacy cash-session-opened event."
    },
    {
      "legacy": "shift.closed",
      "canonical": "cash.movement.recorded",
      "meaning": "shift.closed is accepted as a legacy cash-movement/cash-session close event when payload has cash movement data."
    }
  ],
  "deprecatedAliases": [
    {
      "alias": "sync.conflict_detected",
      "canonical": "sync.conflict.detected",
      "status": "deprecated"
    },
    {
