{
  "contractId": "PRISMA_SYNC_EVENT_CONTRACT_V1",
  "schemaVersion": "1.1.0",
  "eventVersion": "1.0.0",
  "sourceOfTruth": "shared/contracts/sync-event-contract.v1.json",
  "eventTopics": [
    "sale.created",
    "sale.completed",
    "ticket.closed",
    "stock.decremented",
