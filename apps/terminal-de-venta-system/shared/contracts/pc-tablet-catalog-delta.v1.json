    "Product",
    "ProductSupplier",
    "PriceList",
    "PriceListItem",
    "PromotionRule",
    "DiscountPolicy",
    "PricingAuthorizationRule",
    "DropdownCatalog",
    "DropdownOption"
  ],
  "requiredEnvelopeFields": [
    "contractId",
    "schemaVersion",
    "stream",
    "mode",
    "businessId",
    "generatedAt",
    "scope",
    "cursor",
    "changes",
    "counts",
    "diagnostics"
  ],
  "requiredChangeFields": [
    "changeId",
    "entityType",
    "entityId",
    "businessId",
    "operation",
    "occurredAt",
    "cursor",
    "payload"
  ],
  "failureCodes": [
    "duplicate_change",
    "invalid_schema",
    "missing_dependency",
    "stale_cursor",
    "unknown_entity"
