        "FAIL_VALIDATION"
      ]
    },
    "generatedAt": {
      "type": "string"
    },
    "finalReleaseZip": {
      "type": "string"
    },
    "finalReleaseSha256": {
      "type": "string"
    },
    "packageResults": {
      "type": "array"
    },
    "validationErrors": {
      "type": "array"
    },
    "tabletSoloPolicy": {
      "type": "object"
    }
  }
}