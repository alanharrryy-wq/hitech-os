    "neverInferForSeedCustomer": ["vertical", "subvertical", "business_size", "operation_mode", "acquisition_channel", "country", "state_mx", "city", "zone", "contact_role"],
    "otherPolicy": "Other is accepted only with manual text and is automatically queued for catalog review."
