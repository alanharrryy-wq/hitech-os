generator client { provider = "prisma-client-js" }

datasource db { provider = "sqlite" url = "file:../data/prisma-command-center.db" }

model Catalog { id String @id @default(cuid()) code String @unique label String description String? mode String @default("governed") allowOther Boolean @default(false) sortOrder Int @default(100) createdAt DateTime @default(now()) updatedAt DateTime @updatedAt options CatalogOption[] others CatalogOtherSubmission[] }
model CatalogOption { id String @id @default(cuid()) catalogId String code String label String description String? metadata Json? active Boolean @default(true) sortOrder Int @default(100) createdAt DateTime @default(now()) updatedAt DateTime @updatedAt catalog Catalog @relation(fields:[catalogId], references:[id], onDelete:Cascade) @@unique([catalogId, code]) @@index([catalogId, active]) }
model CatalogOtherSubmission { id String @id @default(cuid()) catalogId String manualText String normalized String? status String @default("pending_catalog_review") context Json? createdBy String @default("local_operator") createdAt DateTime @default(now()) reviewedAt DateTime? reviewedBy String? catalog Catalog @relation(fields:[catalogId], references:[id], onDelete:Cascade) @@index([catalogId, status]) }
model IdentitySequence { id String @id @default(cuid()) kind String year Int prefix String lastNumber Int @default(0) createdAt DateTime @default(now()) updatedAt DateTime @updatedAt @@unique([kind, year]) }
model GeneratedIdentity { id String @id @default(cuid()) kind String internalId String @unique humanCode String @unique prefix String year Int sequence Int metadata Json? createdAt DateTime @default(now()) @@index([kind, year]) }
model CommandClient { id String @id @default(cuid()) internalId String @unique humanCode String @unique displayName String legalName String? status String @default("prepared") verticalCode String? subverticalCode String? sizeCode String? operationCode String? cityZoneCode String? catalogOther Json? cloudTenantId String? createdAt DateTime @default(now()) updatedAt DateTime @updatedAt contacts ClientContact[] notes ClientNote[] licenses LicenseAssignment[] devices ManagedDevice[] drafts ProvisioningDraft[] }
model ClientContact { id String @id @default(cuid()) clientId String role String @default("primary") name String? phone String? email String? createdAt DateTime @default(now()) client CommandClient @relation(fields:[clientId], references:[id], onDelete:Cascade) }
model ClientNote { id String @id @default(cuid()) clientId String noteType String @default("internal") text String createdAt DateTime @default(now()) client CommandClient @relation(fields:[clientId], references:[id], onDelete:Cascade) }
model LicensePlan { id String @id @default(cuid()) code String @unique label String tier Int @default(100) description String? maxDevices Int? maxBranches Int? active Boolean @default(true) modules Json? rules Json? createdAt DateTime @default(now()) updatedAt DateTime @updatedAt assignments LicenseAssignment[] }
model LicenseAssignment { id String @id @default(cuid()) internalId String @unique humanCode String @unique clientId String planId String status String @default("prepared") validFrom DateTime? validUntil DateTime? modules Json? limits Json? cloudLicenseId String? createdAt DateTime @default(now()) updatedAt DateTime @updatedAt client CommandClient @relation(fields:[clientId], references:[id], onDelete:Cascade) plan LicensePlan @relation(fields:[planId], references:[id]) }
model ManagedDevice { id String @id @default(cuid()) internalId String @unique humanCode String @unique clientId String deviceType String roleCode String? status String @default("pending_registration") registerCode String? @unique cloudDeviceId String? lastSeenAt DateTime? createdAt DateTime @default(now()) updatedAt DateTime @updatedAt client CommandClient @relation(fields:[clientId], references:[id], onDelete:Cascade) }
model ProvisioningDraft { id String @id @default(cuid()) internalId String @unique humanCode String @unique clientId String? kind String status String @default("prepared") payload Json createdAt DateTime @default(now()) updatedAt DateTime @updatedAt client CommandClient? @relation(fields:[clientId], references:[id], onDelete:SetNull) }
model DeactivationRequest { id String @id @default(cuid()) internalId String @unique humanCode String @unique targetKind String targetCode String? reasonCode String reasonOther String? status String @default("prepared") impact Json? createdAt DateTime @default(now()) }
model CommandAuditEvent { id String @id @default(cuid()) eventType String actor String @default("local_operator") entityKind String? entityCode String? summary String payload Json? createdAt DateTime @default(now()) @@index([eventType, createdAt]) }
model CommandCenterSettings { id String @id @default(cuid()) key String @unique value Json updatedAt DateTime @updatedAt }
model CloudBridgeStatus { id String @id @default(cuid()) mode String @default("local_prepared") cloudOrigin String @default("https://app.hitechrts.com") tokenState String @default("unknown") lastCheckedAt DateTime? payload Json? }
