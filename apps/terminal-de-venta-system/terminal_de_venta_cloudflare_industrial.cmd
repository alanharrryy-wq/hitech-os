@echo off
setlocal EnableExtensions

REM PRISMA Terminal de Venta - Cloudflare Industrial Launcher
REM Stable Cloudflare tunnel verifier for Tablet, PC, Mobile and EIT.
REM This file intentionally DOES NOT create quick trycloudflare.com tunnels.
REM It DOES NOT edit DNS routes or cloudflared config.yml.

pwsh -NoLogo -NoProfile -ExecutionPolicy Bypass -Command "& { $ErrorActionPreference = 'Stop'; Set-StrictMode -Version Latest; $RepoRoot = 'F:\repos\hitech-os'; $TerminalRoot = Join-Path $RepoRoot 'apps\terminal-de-venta-system'; $EitRoot = Join-Path $RepoRoot 'apps\external_interaction_template'; $Logs = 'F:\descargasf'; $RunId = Get-Date -Format 'yyMMdd_HHmm'; $Log = Join-Path $Logs ('prisma_cloudflare_industrial_' + $RunId + '.log'); $Config = Join-Path $env:USERPROFILE '.cloudflared\config.yml'; New-Item -ItemType Directory -Force -Path $Logs | Out-Null; function Log([string]$Text = '') { $Text | Tee-Object -FilePath $Log -Append }; function Header([string]$Text) { Log ''; Log ('[' + $Text + ']'); Write-Host ('`n[' + $Text + ']') -ForegroundColor Cyan }; function TestUrl([string]$Name, [string]$Url, [int]$TimeoutSec = 15) { try { $r = Invoke-WebRequest -Uri $Url -UseBasicParsing -TimeoutSec $TimeoutSec; $line = 'OK    ' + $Name + '    ' + $r.StatusCode + '    ' + $Url + '    bytes=' + $r.RawContentLength; Write-Host $line -ForegroundColor Green; Log $line; return $true } catch { $line = 'FAIL  ' + $Name + '    ' + $Url + '    :: ' + $_.Exception.Message; Write-Host $line -ForegroundColor Red; Log $line; return $false } }; function GetPortOwner([int]$Port) { $conn = Get-NetTCPConnection -LocalPort $Port -State Listen -ErrorAction SilentlyContinue | Select-Object -First 1; if (-not $conn) { return $null }; $proc = Get-CimInstance Win32_Process -Filter ('ProcessId = ' + $conn.OwningProcess) -ErrorAction SilentlyContinue; return [pscustomobject]@{ Port = $Port; Pid = [int]$conn.OwningProcess; CommandLine = [string]$proc.CommandLine } }; function SafeStopEit() { Header 'EIT safe stop'; $owners = @(Get-NetTCPConnection -LocalPort 3110 -ErrorAction SilentlyContinue | Select-Object -ExpandProperty OwningProcess -Unique); foreach ($pid in $owners) { if (-not $pid) { continue }; $proc = Get-CimInstance Win32_Process -Filter ('ProcessId = ' + $pid) -ErrorAction SilentlyContinue; $cmd = [string]$proc.CommandLine; Log ('EIT candidate PID ' + $pid + ' :: ' + $cmd); $low = $cmd.ToLowerInvariant(); if ($low.Contains($EitRoot.ToLowerInvariant()) -or ($low.Contains('external_interaction_template') -and $low.Contains('next')) -or ($low.Contains('next') -and $low.Contains('3110'))) { Write-Host ('Stopping EIT PID ' + $pid) -ForegroundColor Yellow; Log ('STOP PID ' + $pid); Stop-Process -Id $pid -Force -ErrorAction SilentlyContinue } else { Write-Host ('Skip PID ' + $pid + ' because it does not look like EIT.') -ForegroundColor DarkYellow; Log ('SKIP PID ' + $pid + ' not EIT') } }; $procs = Get-CimInstance Win32_Process -ErrorAction SilentlyContinue | Where-Object { $_.CommandLine -and $_.CommandLine.ToLowerInvariant().Contains($EitRoot.ToLowerInvariant()) }; foreach ($p in $procs) { Write-Host ('Stopping EIT process PID ' + $p.ProcessId) -ForegroundColor Yellow; Log ('STOP EIT CMD PID ' + $p.ProcessId); Stop-Process -Id $p.ProcessId -Force -ErrorAction SilentlyContinue }; Start-Sleep -Seconds 2 }; function StartEit() { Header 'Starting EIT local 3110'; if (-not (Test-Path -LiteralPath $EitRoot)) { Log ('FAIL missing EIT root: ' + $EitRoot); return $false }; if (-not (Test-Path -LiteralPath (Join-Path $EitRoot 'package.json'))) { Log ('FAIL missing EIT package.json'); return $false }; SafeStopEit; Remove-Item -Recurse -Force (Join-Path $EitRoot '.next') -ErrorAction SilentlyContinue; Remove-Item -Recurse -Force (Join-Path $EitRoot 'node_modules\.cache') -ErrorAction SilentlyContinue; $pnpm = (Get-Command pnpm.cmd -ErrorAction SilentlyContinue).Source; if (-not $pnpm) { $pnpm = (Get-Command pnpm -ErrorAction Stop).Source }; Start-Process -FilePath $pnpm -ArgumentList @('-C', $EitRoot, 'exec', 'next', 'dev', '-p', '3110', '--webpack') -WorkingDirectory $EitRoot -RedirectStandardOutput (Join-Path $Logs 'eit-3110.out.log') -RedirectStandardError (Join-Path $Logs 'eit-3110.err.log') -WindowStyle Hidden; Start-Sleep -Seconds 8; for ($i = 1; $i -le 35; $i++) { if (TestUrl 'EIT local' 'http://127.0.0.1:3110/' 20) { return $true }; Start-Sleep -Seconds 3 }; Log 'EIT failed to respond after restart.'; if (Test-Path -LiteralPath (Join-Path $Logs 'eit-3110.err.log')) { Log '--- EIT ERR tail ---'; Get-Content -LiteralPath (Join-Path $Logs 'eit-3110.err.log') -Tail 80 | Tee-Object -FilePath $Log -Append | Out-Null }; if (Test-Path -LiteralPath (Join-Path $Logs 'eit-3110.out.log')) { Log '--- EIT OUT tail ---'; Get-Content -LiteralPath (Join-Path $Logs 'eit-3110.out.log') -Tail 80 | Tee-Object -FilePath $Log -Append | Out-Null }; return $false }; function EnsureMainApps() { Header 'Checking local Tablet PC Mobile'; $tablet = TestUrl 'Tablet local' 'http://127.0.0.1:3120/' 8; $pc = TestUrl 'PC local' 'http://127.0.0.1:3130/' 8; $mobile = TestUrl 'Mobile local' 'http://127.0.0.1:3140/' 8; if ($tablet -and $pc -and $mobile) { return $true }; $startAll = Join-Path $TerminalRoot 'terminal_de_venta_start_all.cmd'; if (-not (Test-Path -LiteralPath $startAll)) { Log ('FAIL missing start_all launcher: ' + $startAll); return $false }; Header 'Starting Tablet PC Mobile via start_all'; Start-Process -FilePath $startAll -WorkingDirectory $TerminalRoot -WindowStyle Normal; Start-Sleep -Seconds 12; for ($i = 1; $i -le 20; $i++) { $tablet = TestUrl 'Tablet local' 'http://127.0.0.1:3120/' 8; $pc = TestUrl 'PC local' 'http://127.0.0.1:3130/' 8; $mobile = TestUrl 'Mobile local' 'http://127.0.0.1:3140/' 8; if ($tablet -and $pc -and $mobile) { return $true }; Start-Sleep -Seconds 3 }; return $false }; function OpenUrl([string]$Url) { try { Start-Process $Url; Log ('OPEN ' + $Url) } catch { Log ('WARN open failed ' + $Url + ' :: ' + $_.Exception.Message) } }; 'PRISMA Cloudflare Industrial Launcher - ' + (Get-Date) | Tee-Object -FilePath $Log; Log '================================================='; Log 'Mode: stable industrial Cloudflare service. No trycloudflare.com quick tunnels.'; Log ('Log: ' + $Log); Header 'Preflight'; if (-not (Test-Path -LiteralPath $TerminalRoot)) { throw ('Missing terminal root: ' + $TerminalRoot) }; if (-not (Get-Command cloudflared -ErrorAction SilentlyContinue)) { throw 'cloudflared not found in PATH.' }; if (-not (Test-Path -LiteralPath $Config)) { throw ('Missing cloudflared config: ' + $Config) }; $svc = Get-Service cloudflared -ErrorAction SilentlyContinue; if (-not $svc) { throw 'cloudflared service is not installed.' }; Log (($svc | Format-List Name,Status,DisplayName | Out-String)); if ($svc.Status -ne 'Running') { Write-Host 'cloudflared service is stopped. Starting...' -ForegroundColor Yellow; Start-Service cloudflared; Start-Sleep -Seconds 4 }; Header 'Validating cloudflared config'; $raw = Get-Content -LiteralPath $Config -Raw; $required = @(@{Host='tablet.hitechrts.com';Service='http://127.0.0.1:3120'}, @{Host='pc.hitechrts.com';Service='http://127.0.0.1:3130'}, @{Host='prisma.hitechrts.com';Service='http://127.0.0.1:3140'}, @{Host='eit.hitechrts.com';Service='http://127.0.0.1:3110'}); $configOk = $true; foreach ($r in $required) { if ($raw -match ('hostname:\s*' + [regex]::Escape($r.Host)) -and $raw -match ('service:\s*' + [regex]::Escape($r.Service))) { Log ('OK config route ' + $r.Host + ' -> ' + $r.Service) } else { Write-Host ('FAIL config route missing ' + $r.Host + ' -> ' + $r.Service) -ForegroundColor Red; Log ('FAIL config route missing ' + $r.Host + ' -> ' + $r.Service); $configOk = $false } }; if ($raw -notmatch '(?m)^\s{2}-\sservice:\shttp_status:404\s*$') { Write-Host 'FAIL config fallback is missing or badly indented.' -ForegroundColor Red; Log 'FAIL config fallback is missing or badly indented.'; $configOk = $false } else { Log 'OK config fallback indentation' }; $mainLocalOk = EnsureMainApps; $eitLocalOk = TestUrl 'EIT local' 'http://127.0.0.1:3110/' 20; if (-not $eitLocalOk) { $eitLocalOk = StartEit }; Header 'Testing public URLs'; $tabletPublic = TestUrl 'Tablet public' 'https://tablet.hitechrts.com/' 20; $pcPublic = TestUrl 'PC public' 'https://pc.hitechrts.com/' 20; $mobilePublic = TestUrl 'Mobile public' 'https://prisma.hitechrts.com/' 20; $installPublic = TestUrl 'Mobile WhatsApp install' 'https://prisma.hitechrts.com/prisma-app/install?from=whatsapp' 20; $eitPublic = TestUrl 'EIT public' 'https://eit.hitechrts.com/' 25; if ($mainLocalOk -and $eitLocalOk -and (-not ($tabletPublic -and $pcPublic -and $mobilePublic -and $installPublic -and $eitPublic))) { Header 'Public failed while local is OK. Restarting cloudflared once'; try { Restart-Service cloudflared -Force; Start-Sleep -Seconds 6 } catch { Log ('WARN cloudflared restart failed: ' + $_.Exception.Message) }; $tabletPublic = TestUrl 'Tablet public retry' 'https://tablet.hitechrts.com/' 20; $pcPublic = TestUrl 'PC public retry' 'https://pc.hitechrts.com/' 20; $mobilePublic = TestUrl 'Mobile public retry' 'https://prisma.hitechrts.com/' 20; $installPublic = TestUrl 'Mobile WhatsApp install retry' 'https://prisma.hitechrts.com/prisma-app/install?from=whatsapp' 20; $eitPublic = TestUrl 'EIT public retry' 'https://eit.hitechrts.com/' 25 }; Header 'Opening stable URLs'; if ($tabletPublic) { OpenUrl 'https://tablet.hitechrts.com/' }; if ($pcPublic) { OpenUrl 'https://pc.hitechrts.com/' }; if ($mobilePublic) { OpenUrl 'https://prisma.hitechrts.com/' }; if ($installPublic) { OpenUrl 'https://prisma.hitechrts.com/prisma-app/install?from=whatsapp' }; if ($eitPublic) { OpenUrl 'https://eit.hitechrts.com/' }; Header 'Result'; $ready = $configOk -and $mainLocalOk -and $eitLocalOk -and $tabletPublic -and $pcPublic -and $mobilePublic -and $installPublic -and $eitPublic; if ($ready) { Log '[RESULT] READY'; Write-Host '[RESULT] READY' -ForegroundColor Green; exit 0 }; if ($mainLocalOk -and $eitLocalOk) { Log '[RESULT] READY_WITH_CAVEATS'; Write-Host '[RESULT] READY_WITH_CAVEATS - Local apps OK, but at least one public URL/config check failed.' -ForegroundColor Yellow; Write-Host ('Log: ' + $Log) -ForegroundColor Yellow; exit 1 }; Log '[RESULT] BLOCKED'; Write-Host '[RESULT] BLOCKED - One or more local apps failed.' -ForegroundColor Red; Write-Host ('Log: ' + $Log) -ForegroundColor Yellow; exit 2 }"

set EXITCODE=%ERRORLEVEL%
echo.
echo Exit code: %EXITCODE%
exit /b %EXITCODE%
