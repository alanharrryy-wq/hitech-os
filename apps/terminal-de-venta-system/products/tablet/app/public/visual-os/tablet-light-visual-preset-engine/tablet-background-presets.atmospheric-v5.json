{
  "schema": "prisma.tablet.background.atmospheric.v5",
  "created": "2026-05-25",
  "surface": "tablet",
  "route": "/visual-os/tablet-background-gallery",
  "policy": {
    "tabletDefaultTone": "light",
    "lightPresetId": "tablet-soft-gray-clouds",
    "darkPresetsAreShowcaseOnly": true,
    "doNotApplyDarkToProductiveTabletByDefault": true,
    "doNotTouchPos": true,
    "sourceUpdatesAutoReflectInRoute": true,
    "notes": [
      "The route loads docs/design/tablet-light-visual-preset-engine first, so future changes to these assets update the gallery without productive POS mutation.",
      "Dark presets are explicitly experimental showcase backgrounds requested by the user, not Tablet default skins.",
      "V5 fixes V4 washed-out render by moving background layers above the stage base plane and adding per-preset background variables."
    ]
  },
  "presets": [
    {
      "id": "tablet-soft-gray-clouds",
      "title": "Tablet Soft Gray Clouds",
      "tone": "light",
      "kind": "svg-image-layer-plus-css-motion",
      "defaultCandidate": true,
      "applyDefault": true,
      "lightOnlySafe": true,
      "description": "Fondo claro perla con nubes grises visibles, borrosas pero con forma, diseñado para Tablet luminosa y táctil.",
      "asset": "assets/backgrounds/tablet-soft-gray-clouds.svg",
      "motion": {
        "type": "slow cloud drift",
        "cycleSeconds": 108,
        "reducedMotion": "static premium frame"
      },
      "visualBudget": {
        "background": 0.46,
        "motion": 0.14,
        "glass": 0.58,
        "glow": 0.06,
        "rim": 0.12,
        "webgl": 0.0
      },
      "tokens": {
        "--atm-bg0": "#eef2f5",
        "--atm-bg1": "#f7f8fa",
        "--atm-cloud": "rgba(118,128,138,.14)",
        "--atm-glass": "rgba(255,255,255,.74)"
      }
    },
    {
      "id": "obsidian-cloud-motion",
      "title": "Obsidian Cloud Motion",
      "tone": "dark-showcase",
      "kind": "svg-image-layer-plus-css-motion",
      "defaultCandidate": false,
      "applyDefault": false,
      "lightOnlySafe": false,
      "darkShowcase": true,
      "description": "Nube mineral oscura con humo lento y textura viva, sólo para galería/showcase, no default productivo de Tablet.",
      "asset": "assets/backgrounds/obsidian-cloud-motion.svg",
      "motion": {
        "type": "deep mist drift",
        "cycleSeconds": 128,
