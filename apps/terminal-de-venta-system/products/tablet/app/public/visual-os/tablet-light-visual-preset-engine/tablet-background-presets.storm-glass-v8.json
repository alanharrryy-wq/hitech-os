{
  "schema": "prisma.tablet.background.presets",
  "version": "8.0.0-storm-glass-cards",
  "galleryDefault": "storm-cloud-operations-real",
  "policy": {
    "visualOsOnly": true,
    "doNotMutatePos": true,
    "productLightPresetId": "tablet-soft-gray-clouds",
    "darkShowcaseDefault": "storm-cloud-operations-real",
    "note": "The dark storm image is for Visual OS review only. It is not applied to productive Tablet POS."
  },
  "assets": {
    "stormImage": "assets/backgrounds/storm-cloud-operations-real.jpg"
  },
  "presets": [
    {
      "id": "storm-cloud-operations-real",
      "name": "Storm Cloud Operations Real",
      "tone": "dark-showcase",
      "darkShowcase": true,
      "applyDefault": false,
      "imageAsset": "assets/backgrounds/storm-cloud-operations-real.jpg",
      "visualRole": "reference dark showcase with real storm background and liquid glass cards",
      "motion": {
        "kind": "slow-image-drift",
        "seconds": 138,
        "reducedMotion": "freeze"
      },
      "glass": {
        "material": "G3/G4",
        "rim": "hydro selective",
        "blurPx": 22,
        "touchTargetPx": 48
      }
    },
    {
      "id": "liquid-operations-smoke",
      "name": "Liquid Operations Smoke",
      "tone": "dark-showcase",
      "darkShowcase": true,
      "applyDefault": false,
      "visualRole": "procedural dark fallback"
    },
    {
      "id": "tablet-soft-gray-clouds",
      "name": "Tablet Soft Gray Clouds",
      "tone": "light-tablet-safe",
      "darkShowcase": false,
      "applyDefault": false,
      "visualRole": "light-first product candidate"
    },
    {
      "id": "obsidian-cloud-motion",
      "name": "Obsidian Cloud Motion",
      "tone": "dark-showcase",
      "darkShowcase": true,
      "applyDefault": false,
      "visualRole": "dark cloud comparison"
    },
    {
      "id": "aurora-slate-veil",
      "name": "Aurora Slate Veil",
      "tone": "dark-showcase",
      "darkShowcase": true,
      "applyDefault": false,
      "visualRole": "dark aurora comparison"
    }
  ],
  "validations": [
    "json-parse",
    "storm-image-exists",
    "reduced-motion",
    "touch-target-48px",
    "no-pos-mutation",
    "dark-showcase-not-product-default"
  ]
}