{
  "schema": "prisma.tablet.codex.native.gallery.demo.v1",
  "created": "2026-05-25",
  "surface": "tablet",
  "theme": "light-only",
  "intent": "Scrollable codex-native visual gallery with multiple panels and effects.",
  "codexAlignment": {
    "usesCodexPresetIds": true,
    "lightAdapter": "tablet-light-no-dark",
    "hardLimits": [
      "No G5/R3F in routine dense tables.",
      "No strong glow in more than one primary CTA per viewport.",
      "No hydro rim on every card.",
      "Motion must be ignorable and reduced-motion safe."
    ]
  },
  "panels": [
    {
      "id": "g1-quiet-work-glass",
      "title": "G1 Quiet Work Glass",
      "group": "glass",
      "codex": "layer.glass.g1_quiet_work_glass",
      "library": [
        "css_custom_properties",
        "tailwind_v4",
        "cva"
      ],
      "variant": "quiet",
      "desc": "Inputs, toolbars, filas y lectura densa. Vidrio bajo, sin carnaval.",
      "class": "panel-g1 quiet"
    },
    {
      "id": "g1-frosted-row-tint",
      "title": "G1 Frosted Row Tint",
      "group": "glass",
      "codex": "layer.glass.g1_frosted_row_tint",
      "library": [
        "css_custom_properties",
        "tanstack_table"
      ],
      "variant": "operational",
      "desc": "Hover/selected rows con glass apenas visible para tablas.",
      "class": "panel-g1 row-tint"
    },
    {
      "id": "g2-executive-card",
      "title": "G2 Executive Card Glass",
      "group": "glass",
      "codex": "layer.glass.g2_executive_card_glass",
      "library": [
        "cva",
        "clsx",
        "tailwind_merge"
      ],
      "variant": "standard",
      "desc": "Card base premium: blur medio, sombra suave, highlight interno.",
      "class": "panel-g2 executive"
    },
    {
      "id": "g2-dense-evidence",
      "title": "G2 Dense Evidence Glass",
      "group": "glass",
      "codex": "layer.glass.g2_dense_evidence_glass",
      "library": [
        "radix_accordion",
        "tanstack_table"
      ],
      "variant": "evidence",
      "desc": "Detalle técnico colapsado y evidencia: legible antes que show.",
      "class": "panel-g2 evidence"
    },
    {
      "id": "g3-double-stage",
      "title": "G3 Double Glass Stage",
      "group": "glass",
      "codex": "layer.glass.g3_double_glass_stage",
      "library": [
        "css_custom_properties",
        "motion_for_react"
      ],
      "variant": "premium",
      "desc": "Hero, major frame o decision header: doble vidrio visible.",
      "class": "panel-g3 double-stage hydro"
