  "targetFirstFiltering": {
    "version": "tabflt1-0707-2137",
    "principle": "La cabina se filtra por target.kind + intent + role.controls antes de mostrar packs o perillas; lo incompatible desaparece.",
    "hardFilter": true,
    "uiRule": "No dejar controles incompatibles visibles/disabled; ocultarlos completamente y sugerir el target correcto.",
    "validationCases": [
      {
        "case": "text + Texto",
        "expectedVisible": [
          "Typography"
        ],
        "mustHide": [
          "Shape",
          "Background",
          "Tables",
          "Buttons"
        ]
      },
      {
        "case": "headingText + Texto",
        "expectedVisible": [
          "Typography"
        ],
        "mustHide": [
          "Background",
          "Shape"
        ]
      },
      {
        "case": "buttonText + Texto",
        "expectedVisible": [
          "Typography"
        ],
        "mustHide": [
          "Buttons",
          "Background",
          "Tables"
        ]
      },
      {
        "case": "button + Botón",
        "expectedVisible": [
          "Buttons",
          "Motion"
        ],
        "mustHide": [
          "Background",
          "Tables",
          "Typography"
        ]
      },
      {
        "case": "panel + Material",
        "expectedVisible": [
          "Glass",
          "Depth"
        ],
        "mustHide": [
          "Typography",
          "Tables"
        ]
      },
      {
        "case": "table/tableCell + Tabla",
        "expectedVisible": [
          "Tables"
        ],
        "mustHide": [
          "Background",
          "Buttons"
        ]
      },
      {
        "case": "background + Fondo",
        "expectedVisible": [
          "Background"
        ],
        "mustHide": [
          "Typography",
          "Buttons",
          "Tables"
        ]
      }
    ],
