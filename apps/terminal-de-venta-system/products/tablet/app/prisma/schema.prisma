generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Product {
  id          String   @id
  sku         String   @unique
  name        String
  category    String
  barcode     String?
  priceCents  Int
  costCents   Int
  stockOnHand Int
  isActive    Boolean  @default(true)
  updatedAt   DateTime @updatedAt
}

model Shift {
  id        String    @id
  cashierId String
  cashier   String
  openedAt  DateTime
  closedAt  DateTime?
  cashStart Int
  cashEnd   Int?
  variance  Int?
}

model Sale {
  id          String     @id
  folio       String     @unique
  cashier     String
  totalCents  Int
  createdAt   DateTime
  status      String
  lines       SaleLine[]
}

model SaleLine {
  id         String @id
  saleId     String
  sku        String
  product    String
  qty        Int
  priceCents Int
  sale       Sale   @relation(fields: [saleId], references: [id])
}

model SaleReturn {
  id          String   @id
  saleFolio   String
  reason      String
  amountCents Int
  createdAt   DateTime
  cashier     String
}

model OutboxEvent {
  id          String   @id
  topic       String
  aggregateId String
  payloadJson String
  status      String
  createdAt   DateTime
  sentAt      DateTime?
}
