{
  "name": "@hitech/prisma-chart-lab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 -p 3000",
    "dev:public-safe": "node scripts/run-chart-lab-public-safe-dev.mjs",
    "build": "next build --webpack",
    "start": "next start --hostname 127.0.0.1 -p 3000",
    "typecheck": "tsc --noEmit",
    "verify": "node scripts/verify-chart-lab.mjs",
    "verify:controls": "node scripts/verify-chart-lab-controls.mjs",
    "verify:chart-source-modes": "node scripts/verify-chart-source-modes.mjs",
    "verify:maps": "node scripts/verify-chart-lab-maps.mjs",
    "verify:passports": "node scripts/verify-chart-lab-passports.mjs",
    "verify:cloudflare": "node scripts/verify-chart-lab-cloudflare.mjs",
    "verify:promotion": "node scripts/verify-chart-lab-promotion.mjs",
    "verify:no-leaks": "node scripts/verify-chart-lab-no-leaks.mjs",
    "verify:promotion-readiness": "node scripts/verify-promotion-readiness.mjs",
    "verify:cloudflare-smoke": "node scripts/verify-chart-lab-cloudflare-smoke.mjs",
    "verify:echarts-boundary": "node scripts/verify-chart-lab-echarts-boundary.mjs",
    "verify:all": "node scripts/verify-chart-lab-all.mjs",
    "runtime:prepare-db": "py -3 ../../../tools/prisma/prisma_chart_runtime_snapshot.py --repo-root ../../.. --prepare-runtime-db --refresh-runtime-db",
    "runtime:refresh": "py -3 ../../../tools/prisma/prisma_chart_runtime_snapshot.py --repo-root ../../.. --collect-only",
    "runtime:status": "py -3 ../../../tools/prisma/prisma_chart_runtime_snapshot.py --repo-root ../../.. --status-only",
    "runtime:verify": "py -3 ../../../tools/prisma/prisma_chart_runtime_snapshot.py --repo-root ../../.. --status-only && pnpm run verify:chart-source-modes",
    "cf:build": "node scripts/run-chart-lab-cf-build.mjs",
    "cf:preview": "node scripts/run-chart-lab-cf-preview.mjs",
    "cf:deploy": "node scripts/deploy-cloudflare-pages.mjs",
    "cf:verify": "node scripts/verify-chart-lab-cloudflare.mjs",
    "tunnel:config": "node scripts/print-chart-lab-tunnel-config.mjs",
    "tunnel:run": "pwsh -NoProfile -ExecutionPolicy Bypass -File scripts/run-chart-lab-tunnel.ps1",
    "tunnel:doctor": "pwsh -NoProfile -ExecutionPolicy Bypass -File scripts/doctor-chart-lab-tunnel.ps1",
    "promote": "node scripts/promote-chart.mjs",
    "handoff:pack": "node scripts/export-chart-lab-handoff-pack.mjs",
    "scaffold:chart": "node scripts/create-chart-lab-entry.mjs",
    "visual-baseline-readiness": "node scripts/visual-baseline-readiness.mjs"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "echarts": "5.6.0",
    "monaco-editor": "^0.55.1",
    "next": "16.1.6",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/node": "22.13.9",
    "@types/react": "19.2.14",
    "typescript": "5.8.2",
    "wrangler": "4.90.0"
  },
  "engines": {
    "node": ">=20.0.0 <26.0.0"
  }
}
