generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Product {
  id          String   @id
  sku         String   @unique
  name        String
  category    String
  priceCents  Int
  costCents   Int
  isActive    Boolean  @default(true)
  updatedAt   DateTime @updatedAt
  barcodes    Barcode[]
  snapshots   StockSnapshot[]
}

model Barcode {
  id        String   @id
  productId String
  code      String   @unique
  createdAt DateTime
  product   Product  @relation(fields: [productId], references: [id])
}

model StockSnapshot {
  id           String   @id
  productId    String
  location     String
  onHand       Int
  reserved     Int
  available    Int
  daysCover    Float
  snapshotAt   DateTime
  product      Product  @relation(fields: [productId], references: [id])
}

model StockMovement {
  id          String   @id
  productId   String
  movement    String
  qty         Int
  reason      String
  location    String
  createdAt   DateTime
}

model PurchaseOrder {
  id         String   @id
  folio      String   @unique
  supplier   String
  status     String
  createdAt  DateTime
  expectedAt DateTime
}

model ReceivingReceipt {
  id         String   @id
  purchaseId String
  supplier   String
  receivedAt DateTime
  lines      Int
  status     String
}

model AuditCount {
  id         String   @id
  location   String
  countedBy  String
  variance   Int
  status     String
  countedAt  DateTime
}

model ReplenishmentSignal {
  id          String   @id
  productId   String
  location    String
  suggestedQty Int
  priority    String
  createdAt   DateTime
}

model OutboxEvent {
  id          String   @id
  topic       String
  aggregateId String
  payloadJson String
  status      String
  createdAt   DateTime
  sentAt      DateTime?
}
