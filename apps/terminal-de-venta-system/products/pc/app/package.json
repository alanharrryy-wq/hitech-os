{
  "name": "@hitech/pc",
  "version": "6.1.1",
  "private": true,
  "type": "module",
  "scripts": {
    "prisma:generate": "python ../../../tooling/scripts/generate_prisma_canonical.py pc",
    "dev": "pnpm run prisma:generate && next dev -p 3130",
    "build": "pnpm run prisma:generate && node ../../../tools/run-next-build.mjs",
    "start": "next start -p 3130",
    "typecheck": "pnpm run prisma:generate && tsc --noEmit",
    "check:package": "python tools/validate_package.py .",
    "check:all": "python tools/validate_package.py . && pnpm run typecheck",
    "db:canonical:generate": "python ../../../tooling/scripts/generate_prisma_canonical.py pc",
    "db:canonical:migrate": "python ../../../tooling/scripts/migrate_prisma_canonical.py",
    "db:canonical:seed": "node ../../../prisma/seed.mjs",
    "db:canonical:validate": "python ../../../tooling/scripts/validate_prisma_canonical.py",
    "db:summary": "python tools/db_summary.py ../../../../../tools/_local/data/terminal-de-venta-system/canonical.db",
    "db:pc:mass-catalog": "node scripts/pc-seed-mass-catalog-04d.mjs",
    "verify:pc:mass-catalog": "node tools/verify_pc_mass_catalog_04d.mjs",
    "verify:visual-os-pc-binding-00j": "node tools/verify_prisma_visual_os_pc_binding_00j.mjs",
    "verify:pc-ingest-idempotency": "node tools/verify_pc_ingest_idempotency_01.mjs",
    "verify:pc-uiux-300": "node tools/verify_pc_uiux_300_addendum.mjs",
    "verify:supplier-sync-contract": "node tools/verify_supplier_sync_contract_01.mjs",
    "verify:supplier-projectors": "node tools/verify_supplier_projectors_01.mjs",
    "verify:pc-uiux-ansi-nav-gate": "node tools/verify_pc_uiux_ansi_nav_gate.mjs --root ../../.. --out .",
    "verify:pc-uiux-route-adoption": "node tools/verify_pc_uiux_route_adoption_gate_v02.mjs --root ../../..",
    "verify:pc-uiux-robust": "node tools/verify_pc_uiux_route_adoption_gate_v02.mjs --root ../../..",
    "verify:pc-uiux-visual": "node tools/visual/verify_pc_uiux_visual_gate_v03.mjs --root ../../..",
    "verify:pc-uiux-visual:static": "node tools/visual/verify_pc_uiux_visual_gate_v03_static.mjs --root ../../..",
    "verify:glass-capsules": "node tools/verify_prisma_glass_capsules_0206.mjs",
    "verify:glass-capsules:proof": "node tools/verify_prisma_glass_capsules_optical_bench_0206.mjs"
  },
  "dependencies": {
    "@prisma/client": "5.21.1",
    "next": "16.1.6",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/node": "22.13.9",
    "@types/react": "19.2.14",
    "prisma": "5.21.1",
    "typescript": "5.8.2"
  },
  "engines": {
    "node": ">=20.0.0 <26.0.0"
  }
}
