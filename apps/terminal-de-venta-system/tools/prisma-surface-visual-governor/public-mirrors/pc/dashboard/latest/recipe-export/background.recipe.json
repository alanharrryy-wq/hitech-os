      "preset": "Tablet Light Cloudglass",
      "light_first": true,
      "allows_real_image_field": "subtle",
      "webgl": "no",
      "pixi_vapor": "no_default"
    },
    "mobile": {
      "preset": "Mobile Thin Mist",
      "battery_friendly": true,
      "motion": "micro_or_none"
    },
    "pos": {
      "blocked_for_now": true,
      "future_policy": "light_only_touch_first_no_webgl_no_heavy_blur"
    }
  },
  "readability_rules": [
    "Background must not compete with labels, tables, inputs, product lists or checkout actions.",
