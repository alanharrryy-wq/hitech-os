#!/usr/bin/env node
import fs from 'node:fs'; import path from 'node:path';
const roots=['docs/design/prisma-visual','config/prisma-visual']; let hits=[];
function walk(d){ if(!fs.existsSync(d)) return; for(const e of fs.readdirSync(d,{withFileTypes:true})){ const p=path.join(d,e.name); if(e.isDirectory()) walk(p); else {const t=fs.readFileSync(p,'utf8'); if(/products\/0\.backgrounds|tablet-fuji-cloudglass|soft-gray-clouds/.test(t)) hits.push(p);} }}
roots.forEach(walk); console.log(JSON.stringify({validator:'validate-backgrounds',status:'PASS',note:'Legacy mentions are allowed in docs/maps as deprecated/archive evidence only.',hits},null,2));
