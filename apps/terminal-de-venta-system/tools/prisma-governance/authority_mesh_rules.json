  "change_types": {
    "visual": {
      "keywords": [
        "visual",
        "ui",
        "ux",
        "css",
        "premium",
        "glass",
        "liquid",
        "pill",
        "cloudglass",
        "background",
        "fondo",
        "layout",
        "interfaz",
        "diseño",
        "look",
        "polish"
      ],
      "authority": [
        "docs/design/**",
        "config/prisma-visual/**",
        "config/prisma-visual-system/**",
        "config/prisma-visual-os/**",
        "products/shared-ui/prisma/**",
        "products/0.backgrounds/**",
        "quality/contracts/no-fake-green.contract.json",
        "quality/contracts/release-evidence-required.contract.json"
      ],
      "required_gates": [
        "visual_manifest_required",
        "visual_evidence_required",
        "layer_budget_required",
        "no_fake_green"
      ]
    },
    "liquid_glass": {
      "keywords": [
        "liquid",
        "glass",
        "pill",
        "cloudglass",
        "capsule",
        "capsules",
        "crystal",
        "prismaglasscard"
      ],
      "authority": [
        "docs/prismo-ui1p-scaffold/**",
        "products/shared-ui/prisma/components/PrismaGlassCard.tsx",
        "products/shared-ui/prisma/**",
        "config/prisma-visual/recipe-map.json",
        "config/prisma-visual/authority-map.json"
      ],
      "runtime_scan": [
        "**/*liquid*",
        "**/*glass*",
        "**/*pill*",
        "**/*cloudglass*",
        "**/*capsule*"
      ],
      "required_gates": [
        "liquid_runtime_scan_required",
        "surface_adapter_required",
        "layer_budget_required"
      ]
    },
    "ops_hot_injection": {
      "keywords": [
        "hot",
        "inyectar",
        "injection",
        "live",
        "servidor levantado",
        "dev server",
        "procesos vivos"
      ],
      "authority": [
        "docs/ops/PRISMA_FIELD_MANUAL_APRENDIZAJE_OPERATIVO.md",
        "docs/PRISMA_OPERATIONAL_SAFETY_RULES.md",
        "quality/contracts/traceable-operation.contract.json"
      ],
      "forbidden_actions": [
        "kill processes",
        "free ports",
        "start dev server",
        "regenerate prisma hot",
        "pc:typecheck hot"
      ]
    },
    "data_sync": {
      "keywords": [
        "sync",
        "sincron",
        "database",
        "schema",
        "prisma",
        "migration",
        "seed",
        "tablet pc",
        "pc tablet",
        "catalog delta"
      ],
      "authority": [
        "docs/prisma/**",
        "docs/sync/**",
        "prisma/**",
        "quality/contracts/schema-migration-parity.contract.json",
        "quality/contracts/idempotent-sync.contract.json",
        "quality/contracts/no-destructive-testing-on-real-db.contract.json"
      ],
      "required_gates": [
        "real_db_destructive_tests_forbidden",
        "schema_parity_required",
        "sync_fixture_required"
      ]
    }
  },
  "reserved_or_future_surfaces": [
    "kiosk",
    "customer-display",
    "warehouse-scanner",
    "manager-console",
    "training-mode",
    "demo-mode",
    "public-display"
  ],
  "forbidden_default_actions": [
    "kill dev processes",
    "free occupied ports",
    "start app/dev server",
    "regenerate Prisma hot",
    "delete files permanently",
    "force push",
    "global CSS blast without manifest"
  ],
  "runtime_scan_excludes": [
    ".git",
    "node_modules",
    ".next",
    "dist",
    "build",
    "coverage",
    ".prisma_installer_backups",
    "__pycache__"
  ],
  "max_runtime_matches_per_pattern": 200
}