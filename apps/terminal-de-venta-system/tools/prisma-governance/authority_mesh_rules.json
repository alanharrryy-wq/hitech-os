{
  "schema_version": "1.0.0",
  "name": "PRISMA Authority Mesh Rules",
  "principle": "Single operational authority entrypoint; many live sources; mandatory readset lock before patches.",
  "global_required": [
    {
      "id": "current_state_json",
      "glob": "docs/PRISMA_CURRENT_STATE.json",
      "critical": true
    },
    {
      "id": "current_state_md",
      "glob": "docs/PRISMA_CURRENT_STATE.md",
      "critical": true
    },
    {
      "id": "precedence_rules",
      "glob": "docs/PRISMA_DOCUMENT_PRECEDENCE_RULES.md",
      "critical": true
    },
    {
      "id": "master_doc_index",
      "glob": "docs/PRISMA_MASTER_DOC_INDEX.md",
      "critical": true
    },
    {
      "id": "operational_safety",
      "glob": "docs/PRISMA_OPERATIONAL_SAFETY_RULES.md",
      "critical": true
    },
    {
      "id": "field_manual",
      "glob": "docs/ops/PRISMA_FIELD_MANUAL_APRENDIZAJE_OPERATIVO.md",
      "critical": true
    },
    {
      "id": "atlas_registry",
      "glob": "docs/atlas/atlas.registry.json",
      "critical": true
    },
    {
      "id": "governor_atlas_map",
      "glob": "docs/atlas/governor.atlas-map.json",
      "critical": true
    },
    {
      "id": "governor_atlas_location",
      "glob": "docs/atlas/GOVERNOR_ATLAS_LOCATION.md",
      "critical": true
    },
    {
      "id": "quality_manifest",
      "glob": "quality/prisma-quality.manifest.json",
      "critical": true
    },
    {
      "id": "no_fake_green",
      "glob": "quality/contracts/no-fake-green.contract.json",
      "critical": true
    },
    {
      "id": "traceable_operation",
      "glob": "quality/contracts/traceable-operation.contract.json",
      "critical": true
    },
    {
      "id": "release_evidence_required",
      "glob": "quality/contracts/release-evidence-required.contract.json",
      "critical": true
    }
  ],
