{
  "schemaVersion": "1.0",
  "activeProfile": "standard",
  "profiles": {
    "standard": {
      "connectTimeoutSeconds": 2.5,
      "httpTimeoutSeconds": 8,
      "publicHttpTimeoutSeconds": 15,
      "publicProbeAttempts": 2,
      "publicProbeIntervalSeconds": 0.5,
      "startupTimeoutSeconds": 65,
      "startupPollSeconds": 2,
      "acceptedHttpStatuses": [
        200,
        201,
        202,
        204,
        301,
        302,
        307,
        308,
        401,
        403,
        404
      ],
      "healthyHttpStatuses": [
        200,
        201,
        202,
        204,
        301,
        302,
        307,
        308
      ],
      "lanCheckEnabled": true,
      "publicCheckEnabled": true,
      "contentProbeMaxBytes": 262144,
      "autoRefreshSeconds": 6
    }
  }
}
