  "forbidden_ui_controls": [
    {
      "id": "scene",
      "reason": "El usuario no debe elegir el formato. Auto Render Ensemble elige la mejor composición."
    },
    {
      "id": "output_format",
      "reason": "Evita fricción y aprovecha render_plan."
    },
    {
      "id": "safe_mode_toggle",
      "reason": "Seguridad interna, no etiqueta de producto."
    }
  ],
  "auto_render_ensemble": {
    "contract": "render_plan returns ordered blocks[] with priority, surfaceFit, confidence, collapseDefault, visualPreset and actions.",
    "default_block_order": [
      "hero_response",
      "executive_brief",
      "next_best_action",
      "protocol_ladder",
      "procedural_steps",
      "risk_matrix",
      "timeline",
      "flow_diagram",
      "evidence_board",
      "memory_trace",
      "technical_drawer",
      "action_bar"
    ],
    "selection_policy": {
      "diagnose": [
        "hero_response",
        "executive_brief",
        "risk_matrix",
        "procedural_steps",
        "evidence_board",
        "technical_drawer",
        "action_bar"
      ],
      "explain": [
        "hero_response",
        "executive_brief",
        "flow_diagram",
        "memory_trace",
        "evidence_board",
        "technical_drawer",
        "action_bar"
      ],
      "recommend": [
        "hero_response",
        "next_best_action",
        "protocol_ladder",
        "procedural_steps",
        "risk_matrix",
        "evidence_board",
        "action_bar"
      ],
      "compare": [
        "hero_response",
        "comparison_board",
        "risk_matrix",
        "evidence_board",
        "technical_drawer",
        "action_bar"
      ],
      "audit": [
        "hero_response",
        "timeline",
        "governance_notice",
        "evidence_board",
        "memory_trace",
        "technical_drawer",
        "action_bar"
      ],
      "prepare_action": [
        "hero_response",
        "next_best_action",
        "procedural_steps",
        "protocol_ladder",
        "risk_matrix",
        "technical_drawer",
        "action_bar"
      ],
      "investigate": [
        "hero_response",
        "flow_diagram",
        "evidence_board",
        "timeline",
        "memory_trace",
        "technical_drawer",
        "action_bar"
      ],
      "summarize": [
        "hero_response",
        "executive_brief",
        "next_best_action",
        "insight_chips",
        "action_bar"
      ]
    },
    "surface_policy": {
      "pc_ui": "render rich preview cards + visual acceptance + implementation checklist",
      "learning": "render protocol ladder + evidence board + memory trace",
      "sync": "render status timeline + risk matrix + retry/prep actions",
      "chart_lab": "render chart_spec_preview + visual recipe + export readiness",
      "governance": "render governance notice + trace + risk matrix"
    },
    "main_surface_limits": {
      "max_blocks": 8,
      "max_evidence_cards": 5,
      "max_actions": 6,
      "max_visible_badges": 5
    },
    "detail_surface": "technical_drawer always available when traces/evidence exist",
    "empty_block_rule": "Nunca mostrar tabs/panels vacíos ni próximamente."
  },
  "text_inputs": {
    "free_text": {
      "required": false,
      "placeholder": "Dile a PRISMO qué necesitas diagnosticar, decidir, explicar o preparar..."
    },
    "context_note": {
      "required": false,
      "placeholder": "Ruta, síntoma, pantalla, zip, módulo, evidencia, error..."
    }
  },
  "smart_chips": {
    "source": "generated_by_objective_domain_lens_and_runtime_status",
    "max_visible": 6,
    "examples": [
      "Qué falta para dejarlo listo",
      "Qué evidencia soporta esto",
      "Qué protocolo conviene",
      "Qué riesgo hay",
      "Prepara plan con rollback",
      "Muéstrame detalle técnico"
    ]
  }
