{
  "schema": "prisma.ui.panel.contract.v1",
  "panel_id": "tablet.pos.search-card",
  "status": "SEED_UNCERTIFIED",
  "surface": "tablet",
  "route": "/pos",
  "title": "Tablet POS search card",
  "certification_rule": "Do not treat this seed contract as CERTIFIED until anchors, owners and selectors validate on the local repo.",
  "owner_component": null,
  "owner_css_module": null,
  "canonical_selectors": [
    ".posPremiumSearchCard",
    ".searchCard",
    ".posSearch"
  ],
  "required_anchors": [
    {
      "attribute": "data-prisma-panel",
      "value": "tablet.pos.search-card"
    },
    {
      "attribute": "data-prisma-surface",
      "value": "tablet"
    }
  ],
  "allowed_files": [
    "products/tablet/app/components/pos/**",
    "apps/terminal-de-venta-system/products/tablet/app/components/pos/**"
  ],
  "forbidden_surfaces": [
    "chart-lab",
    "web",
    "pc",
    "mobile",
    "control-center"
  ],
  "target_strings": [
    "Search",
    "posPremiumSearchCard",
    "searchCard"
  ],
  "default_probe": {
    "surface": "tablet",
    "route": "/pos",
    "point": {
      "x": 1160,
      "y": 420
    }
  },
  "required_checks": [
    "pnpm run ui:certainty:self-test",
    "pnpm run ui:certify -- --panel tablet.pos.search-card",
    "pnpm run ui:scope",
    "pnpm run ui:zero-important"
  ],
  "visual_evidence": {
    "preferred": "Mamastrophic point-probe + screenshot/diff when server is online",
    "fallback": "fresh posctx/surface context + ownership report"
  }
}