    "web",
    "data-prisma-surface=\"web\""
  ],
  "default_probe": {
    "surface": "web",
    "route": "/",
    "point": {
      "x": 640,
      "y": 420
    }
  },
  "required_checks": [
    "pnpm run ui:certainty:self-test",
    "pnpm run ui:certify -- --panel web.workspace",
    "pnpm run ui:scope",
    "pnpm run ui:zero-important"
  ],
  "visual_evidence": {
    "preferred": "Mamastrophic point-probe + screenshot/diff when server is online",
    "fallback": "fresh posctx/surface context + ownership report"
  }
