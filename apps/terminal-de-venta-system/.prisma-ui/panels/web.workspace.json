{
  "schema": "prisma.ui.panel.contract.v1",
  "panel_id": "web.workspace",
  "status": "SEED_UNCERTIFIED",
  "surface": "web",
  "route": "/",
  "title": "Web/EIT workspace",
  "certification_rule": "Do not treat this seed contract as CERTIFIED until anchors, owners and selectors validate on the local repo.",
  "owner_component": null,
  "owner_css_module": null,
  "canonical_selectors": [
    "[data-prisma-panel=\"web.workspace\"]"
  ],
