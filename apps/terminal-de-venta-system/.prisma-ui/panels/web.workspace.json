    },
    {
      "attribute": "data-prisma-surface",
      "value": "web"
    }
  ],
  "allowed_files": [
    "products/web/**",
    "apps/terminal-de-venta-system/products/web/**",
    "apps/terminal-de-venta-system/app/**",
    "apps/terminal-de-venta-system/src/**"
  ],
  "forbidden_surfaces": [
    "chart-lab",
    "tablet",
    "pc",
    "mobile",
    "control-center"
  ],
  "target_strings": [
