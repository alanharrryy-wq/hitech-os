{
  "schema": "prisma.local-first-data-custody-contract.v1",
  "version": "1.0.0",
  "status": "SOURCE_READY",
  "managedBy": "custodia",
  "decision": {
    "architecture": "local-first",
    "defaultOperationalCustodian": "customer",
    "providerOperationalDataAccess": "none_by_default",
    "providerOperationalDataStorage": "prohibited_by_default",
    "providerOperationalDataReplication": "prohibited_by_default",
    "runtimeNoEgressCertified": false,
    "legalComplianceCertified": false
  },
  "customerOperationalData": [
    "sales",
    "sale_lines",
    "tickets",
    "inventory",
    "catalog",
    "customer_records",
    "employee_and_cashier_records",
    "suppliers",
    "cash_sessions",
    "fiscal_fields",
    "operational_audit",
    "outbox_payloads",
    "canonical_projections",
    "databases",
    "backups",
    "exports",
    "attachments",
    "operational_logs"
  ],
  "allowedRemoteMetadataByDefault": [
    "licenseId",
    "plan",
    "entitlements",
    "licenseStatus",
    "offlineGraceState",
    "appVersion",
    "releaseChannel",
    "technicalDeviceId",
    "declaredSurface",
    "activationTimestamp",
    "minimalHeartbeat",
    "sanitizedHealthSummary"
  ],
  "deniedRemotePayloadByDefault": [
    "database_files",
    "database_rows",
    "sales",
    "customers",
    "employees",
    "inventory_details",
    "outbox_payloads",
    "tickets",
    "receipts",
    "sql_dumps",
    "backups",
    "raw_logs",
    "screenshots",
    "attachments",
    "fiscal_identifiers",
    "contact_details_from_operations",
    "arbitrary_database_queries"
  ],
  "supportExceptionRequirements": [
    "explicit_customer_authorization",
    "specific_incident_and_purpose",
    "defined_data_scope",
    "time_limit",
    "named_authorized_technician",
    "minimum_privilege",
    "redaction",
    "auditable_access",
    "retention_limit",
    "deletion_or_return",
    "revocation",
    "closure_evidence"
  ],
  "customerControls": [
    "storage_account",
    "credentials",
    "encryption_keys_when_applicable",
    "users_and_permissions",
    "backups",
    "export",
    "retention",
    "deletion"
  ],
  "allowedClaimsAtSourceReady": [
    "designed_with_local_first_architecture",
    "operational_data_intended_for_customer_controlled_storage",
    "license_service_does_not_require_sales_customer_or_inventory_payloads",
    "support_exposing_data_requires_authorization"
  ],
  "forbiddenClaimsUntilRuntimeCertification": [
    "never_transmits_any_data",
    "zero_custody_certified",
    "zero_telemetry_everywhere",
    "full_legal_compliance_guaranteed",
    "no_third_party_can_receive_data",
    "all_endpoints_certified"
  ],
  "nextGate": "RUNTIME_DATA_EGRESS_AND_SUPPORT_BUNDLE_CERTIFICATION",
  "relatedAuthorities": [
    "PRISMA_DATA_OUTSIDE_REPO_POLICY.md",
    "PRISMA_CUSTOMER_RUNTIME_LAYOUT_CONTRACT.md",
    "PRISMA_SECURITY_PRIVACY_BASELINE.md",
    "PRISMA_REMOTE_OPS_ARCHITECTURE.md",
    "PRISMA_SUPPORT_BUNDLE_LOCAL_04_DATA_ALLOWLIST.md",
    "PRISMA_NO_PAYMENT_PROCESSING_BOUNDARY.md"
  ]
}
