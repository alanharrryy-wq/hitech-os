      "name": "activate",
      "method": "POST",
      "path": "/api/licenses/activate",
      "body": {
        "licenseKey": "DUMMY-LICFLOW3-TEST-KEY",
        "deviceId": "dummy-device-id",
        "tenantId": "dummy-tenant",
        "app": "terminal-de-venta-system"
