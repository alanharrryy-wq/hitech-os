        "licenseKey": "DUMMY-LICFLOW3-TEST-KEY",
        "deviceId": "dummy-device-id",
        "tenantId": "dummy-tenant"
      },
      "expected_status_any_of": [
        200,
        201,
        400,
        401,
        403,
        422
      ]
