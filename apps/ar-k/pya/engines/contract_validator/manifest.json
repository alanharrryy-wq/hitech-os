      "violation_count",
      "error_count",
      "critical_count"
    ]
  },
  "inputs_declared": [
    "module_registry",
    "boundary_registry",
    "contract_registry",
    "switch_registry",
    "switch_resolutions",
    "query_index"
  ],
  "observability_contract": {
