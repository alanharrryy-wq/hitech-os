{
  "area": "validation",
  "compatibility": {
    "contracts": {
      "boundary_entry": "1.0.0",
      "contract_health_summary": "1.0.0",
      "contract_registry_entry": "1.0.0",
      "execution_summary": "1.0.0",
      "module_registry_entry": "1.0.0",
      "query_index": "1.0.0",
      "switch_registry_entry": "1.0.0",
      "switch_resolution": "1.0.0",
      "validation_violation": "1.0.0"
    },
    "kernel": "^1.0.0"
  },
  "dependencies": [
    "switch_engine"
  ],
  "engine_id": "contract_validator",
  "engine_type": "contract_validator",
  "entrypoint": "pya.engines.contract_validator.engine:ContractValidatorEngine",
  "error_contract": {
    "typed_errors": [
      "ValueError"
    ]
  },
  "events_emitted": [
    "contract_validator.started",
    "contract_validator.completed"
  ],
  "execution_modes": [
    "batch"
  ],
  "feature_flags_used": [],
