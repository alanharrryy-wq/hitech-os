{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "target": "ES2022",
    "jsx": "preserve",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "allowJs": false,
    "strict": true,
    "noEmit": true,
    "incremental": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "types": ["node", "vitest/globals", "react", "react-dom"],
    "paths": {},
    "skipLibCheck": true,
    "isolatedModules": true,
    "plugins": [
      {
        "name": "next"
      }
    ]
  },
  "include": [
    "next-env.d.ts",
    "styled-jsx.local.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "components/live-scene-composer/authoring-workbench-v1/types/react-shim.d.ts",
    "app/dev/scene-studio/**",
    "app/pitch/**",
    "components/dev-console/**",
    "components/pitch/**",
    "components/scene-studio/**",
    "lib/pitch/**",
    "lib/scene-studio.ts",
    "lib/scene-studio/**",
    "tests/dev-console*.test.*",
    "tests/dev-routes-smoke.test.tsx",
    "tests/floating-window-drag-policy.test.ts",
    "tests/pitch*.test.*",
    "tests/scene-studio*.test.*",
    "tests/ui-improvement-workflow.test.ts"
  ]
}
