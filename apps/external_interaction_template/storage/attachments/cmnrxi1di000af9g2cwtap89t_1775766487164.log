import re
import sys
from pathlib import Path

root = Path(sys.argv[1]).resolve()
sys.path.insert(0, str(root))

from visuals.common.helpers import ensure_app
from visuals.common.types import TemplateConsoleConfig
from visuals.style.stylesheet import build_stylesheet
from visuals.screens.template_console import TemplateConsoleWindow

app = ensure_app()
font = app.font()
point_size = int(font.pointSize())
pixel_size = int(font.pixelSize())
if point_size <= 0 and pixel_size <= 0:
    raise RuntimeError(f"La fuente global sigue inválida: point={point_size}, pixel={pixel_size}")

stylesheet = build_stylesheet("silver_frost_cyan", "100")
bad_sizes = [int(x) for x in re.findall(r"font-size:\s*(-?\d+)px", stylesheet)]
if any(size <= 0 for size in bad_sizes):
    raise RuntimeError(f"El stylesheet todavía genera font-size inválidos: {bad_sizes}")

window = TemplateConsoleWindow(TemplateConsoleConfig())
window.resize(1200, 800)
window.show()
app.processEvents()
window.close()
app.processEvents()
print("runtime validation ok")
