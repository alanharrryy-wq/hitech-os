{
  "version": 2,
  "policyName": "Zero Priority Override Gate",
  "behavior": {
    "failOnAnyFinding": true,
    "scanModeDefault": "tracked",
    "explainByDefault": false,
    "maxConsoleFindings": 60
  },
  "report": {
    "writeJson": true,
    "writeMarkdown": true,
    "writeCsv": true
  },
  "includeDocs": true,
  "includeExtensionless": false,
  "maxFileBytes": 2000000,
  "excludeDirs": [
    ".git",
    "node_modules",
    ".next",
    ".turbo",
    "dist",
    "build",
    "coverage",
    "out",
    ".cache",
    ".parcel-cache",
    ".vite",
    "__pycache__",
    ".venv",
    "venv",
    "vendor",
    "target",
    ".gradle"
  ],
  "excludeGlobs": [
    "**/.git/**",
    "**/node_modules/**",
    "**/.next/**",
    "**/dist/**",
    "**/build/**",
    "**/coverage/**",
    "**/.turbo/**",
    "**/out/**"
  ],
  "includedExtensions": [
    ".css",
    ".scss",
    ".sass",
    ".less",
    ".pcss",
    ".postcss",
    ".ts",
    ".tsx",
    ".js",
    ".jsx",
    ".mjs",
    ".cjs",
    ".html",
    ".htm",
    ".mdx",
    ".md",
    ".json",
    ".jsonc",
    ".svg",
    ".yml",
    ".yaml",
    ".vue",
    ".svelte",
    ".astro",
    ".py"
  ]
}
