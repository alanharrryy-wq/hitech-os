{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "hitech.meta.federation_status.v1",
  "title": "Federation Status",
  "type": "object",
  "additionalProperties": false,
  "required": ["federation", "repos", "blockers", "debt", "next_actions", "determinism"],
  "properties": {
    "federation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["run_id", "timestamp_iso", "timezone", "status", "summary_counts"],
      "properties": {
        "run_id": {
          "type": "string"
        },
        "timestamp_iso": {
          "type": "string"
        },
        "timezone": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": ["OK", "BLOCKED", "DEGRADED"]
        },
        "summary_counts": {
          "type": "object"
        }
      }
    },
    "repos": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "path",
          "online",
          "status",
          "docs_doctor",
          "mandatory_first_read",
          "blockers",
          "debt_items",
          "last_report_excerpt"
        ]
      }
    },
    "blockers": {
      "type": "object",
      "additionalProperties": false,
      "required": ["constitutional", "policy", "tooling"],
      "properties": {
        "constitutional": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "policy": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "tooling": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "debt": {
      "type": "object",
      "required": ["global_debt_items", "totals"]
    },
    "next_actions": {
      "type": "object",
      "required": ["immediate", "suggested"]
    },
    "determinism": {
      "type": "object",
      "required": ["inputs_hash", "outputs_hash", "stable_sort_rules"]
    }
  }
}
