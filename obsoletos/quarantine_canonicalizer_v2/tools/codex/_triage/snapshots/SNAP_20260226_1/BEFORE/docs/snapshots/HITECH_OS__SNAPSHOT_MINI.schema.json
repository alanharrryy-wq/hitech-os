{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hitech-os.local/docs/snapshots/HITECH_OS__SNAPSHOT_MINI.schema.json",
  "title": "HITECH_OS Snapshot Mini",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "workspace_manager",
    "root_scripts",
    "factory_modules",
    "factory_contracts",
    "factory_configs",
    "smoke",
    "health_checks",
    "notes_unknowns"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "workspace_manager": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "package_manager",
        "workspace_file",
        "workspace_file_state",
        "workspace_packages"
      ],
      "properties": {
        "package_manager": {
          "type": "string",
          "minLength": 1
        },
        "workspace_file": {
          "type": "string",
          "minLength": 1
        },
        "workspace_file_state": {
          "$ref": "#/$defs/state"
        },
        "workspace_packages": {
          "$ref": "#/$defs/string_list"
        }
      }
    },
    "root_scripts": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "minLength": 1
      },
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "factory_modules": {
      "type": "object",
      "additionalProperties": false,
      "required": ["A_core", "B_tooling", "C_features", "D_validation", "Z_aggregator"],
      "properties": {
        "A_core": {
          "$ref": "#/$defs/module_entry"
        },
        "B_tooling": {
          "$ref": "#/$defs/module_entry"
        },
        "C_features": {
          "$ref": "#/$defs/module_entry"
        },
        "D_validation": {
          "$ref": "#/$defs/module_entry"
        },
        "Z_aggregator": {
          "$ref": "#/$defs/module_entry"
        }
      }
    },
    "factory_contracts": {
      "$ref": "#/$defs/file_group"
    },
    "factory_configs": {
      "$ref": "#/$defs/file_group"
    },
    "smoke": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tests_smoke_state",
        "tests_smoke_files",
        "run_factory_smoke_ps1_state",
        "smoke_commands"
      ],
      "properties": {
        "tests_smoke_state": {
          "$ref": "#/$defs/state"
        },
        "tests_smoke_files": {
          "$ref": "#/$defs/string_list"
        },
        "run_factory_smoke_ps1_state": {
          "$ref": "#/$defs/state"
        },
        "smoke_commands": {
          "$ref": "#/$defs/string_list"
        }
      }
    },
    "health_checks": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "commands", "script_refs"],
      "properties": {
        "state": {
          "$ref": "#/$defs/state"
        },
        "commands": {
          "$ref": "#/$defs/string_list"
        },
        "script_refs": {
          "$ref": "#/$defs/string_list"
        }
      }
    },
    "notes_unknowns": {
      "$ref": "#/$defs/string_list"
    }
  },
  "$defs": {
    "state": {
      "type": "string",
      "enum": ["PRESENT", "MISSING", "UNKNOWN"]
    },
    "string_list": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "module_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "files"],
      "properties": {
        "state": {
          "$ref": "#/$defs/state"
        },
        "files": {
          "$ref": "#/$defs/string_list"
        }
      }
    },
    "file_group": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "files"],
      "properties": {
        "state": {
          "$ref": "#/$defs/state"
        },
        "files": {
          "$ref": "#/$defs/string_list"
        }
      }
    }
  }
}
