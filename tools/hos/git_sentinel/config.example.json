{
  "profile_name": "safe",
  "runtime_artifact_dirs": [
    "tools/codex/worktrees",
    "tools/codex/runs",
    "tools/_local",
    "artifacts",
    "logs"
  ],
  "large_file_threshold_bytes": 10485760,
  "duplicate_hash_max_bytes": 67108864,
  "max_security_scan_files": 15000,
  "ignore_history_path": "tools/_local/git_sentinel/state/ignore_rules_history.json",
  "safe_cleanup_prefixes": [
    "tools/codex/worktrees/",
    "tools/codex/runs/",
    "tools/_local/",
    "artifacts/",
    "logs/",
    "_reports/",
    ".agents/_merge_"
  ],
  "safe_ignore_prefixes": [
    "tools/codex/worktrees/",
    "tools/codex/runs/",
    "tools/_local/",
    "artifacts/",
    "logs/",
    "_reports/",
    ".agents/"
  ],
  "prediction_window": 20,
  "lock_path": "tools/_local/git_sentinel/state/guardian.lock.json",
  "lock_stale_seconds": 7200,
  "retention_enabled": true,
  "retention_max_age_days": 30,
  "retention_max_files_per_dir": 500,
  "alert_health_threshold": 65,
  "alert_webhook_env_var": "GIT_SENTINEL_ALERT_WEBHOOK",
  "false_positive_feedback_path": "tools/_local/git_sentinel/state/false_positive_feedback.json",
  "false_positive_audit_path": "tools/_local/git_sentinel/state/false_positive_audit.json",
  "false_positive_default_ttl_days": 30,
  "security_doc_path_globs": [
    "docs/**",
    "**/docs/**",
    "**/*.md",
    "**/examples/**",
    "**/tests/**",
    "**/fixtures/**",
    "**/golden/**",
    "tools/hos/git_sentinel/golden/**",
    ".agents/**"
  ],
  "security_entropy_min_length": 20,
  "security_entropy_threshold": 3.6,
  "security_eval_dataset_path": "tools/hos/git_sentinel/golden/security_eval_dataset.json",
  "security_eval_min_precision": 0.85,
  "security_eval_min_recall": 0.85,
  "security_eval_min_f1": 0.85,
  "ci_gate_default_base_ref": "origin/main",
  "ci_gate_block_high": true,
  "ci_gate_block_critical": true,
  "default_guardian_interval_seconds": 600,
  "autotune_enabled": false,
  "autotune_min_interval_seconds": 300,
  "autotune_max_interval_seconds": 1800,
  "autotune_high_activity_threshold": 220,
  "autotune_low_activity_threshold": 80
}
