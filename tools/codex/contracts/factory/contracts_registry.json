{
  "factory_name": "HITECH Multi-Codex Factory",
  "feature_flags": {
    "enable_auto_open_report": false,
    "enable_auto_open_vscode": false,
    "enable_ci_hook": false,
    "enable_git_hook": false,
    "enable_optional_repair": false,
    "enable_overlap_blocking": false,
    "enable_preflight_strict_mode": false,
    "enable_run_packaging_zip": false,
    "enable_scope_lock_enforcement": false,
    "enable_smoke_validation_gate": false
  },
  "integrator": "Z_aggregator",
  "notes": [
    "All feature flags default to false.",
    "Deterministic ordering is required for all JSON outputs.",
    "Z_aggregator merges and validates only; no feature invention.",
    "Execution phases are build/validation/integration/post_run with canonical runtime order A_core,B_tooling,C_features,D_validation,Z_aggregator,R_reviewer,E_planner.",
    "Graph-analysis artifacts are required Z_aggregator outputs and JSON artifacts are canonical.",
    "Graph-analysis schemas use semantic schema_version and explicit compatibility metadata.",
    "Canonical worker IDs are supported with explicit legacy aliases for compatibility (A_worker,B_worker,C_worker,D_worker,Z_integrator,E_worker,R_worker).",
    "C_features is the default visual baseline owner.",
    "Worker closeout artifacts are auto-generated and repaired when possible."
  ],
  "required_integrator_files": [
    "STATUS.json",
    "FINAL_REPORT.txt",
    "FILES_CHANGED.json",
    "DIFF.patch",
    "MERGE_PLAN.md",
    "LOGS/INDEX.json",
    "GRAVITY_REPORT.json",
    "PROTECTED_NODES.json",
    "IMPACT_CONE_REPORT.json",
    "DEPENDENCY_DIFF.json",
    "DISPATCH_RECOMMENDATIONS.json",
    "GRAVITY_SUMMARY.md",
    "DISPATCH_RECOMMENDATIONS.md"
  ],
  "required_worker_files": [
    "STATUS.json",
    "SUMMARY.md",
    "FILES_CHANGED.json",
    "DIFF.patch",
    "SUGGESTIONS.md",
    "SCOPE_LOCK.json",
    "HANDOFF_NOTE.json",
    "LOGS/INDEX.json",
    "CODEX_OUTPUT.txt"
  ],
  "required_post_run_files": {
    "E_planner": [
      "TASK_BANK_DELTA.json",
      "TASK_BANK_INGEST_REPORT.json",
      "PLANNER_RECOMMENDATIONS.json",
      "PLANNER_SUMMARY.md"
    ],
    "R_reviewer": [
      "REVIEW_REPORT.json",
      "REVIEW_FINDINGS.json",
      "REVIEW_RECOMMENDATIONS.json",
      "ARCH_REVIEW_SUMMARY.md"
    ]
  },
  "schema_version": 1,
  "schemas": {
    "contracts_registry": "tools/codex/schemas/contracts_registry.schema.json",
    "planner_recommendations": "tools/codex/schemas/planner_recommendations.schema.json",
    "review_findings": "tools/codex/schemas/review_findings.schema.json",
    "review_recommendations": "tools/codex/schemas/review_recommendations.schema.json",
    "review_report": "tools/codex/schemas/review_report.schema.json",
    "task_bank_delta": "tools/codex/schemas/task_bank_delta.schema.json",
    "task_bank_ingest_report": "tools/codex/schemas/task_bank_ingest_report.schema.json",
    "factory_config": "tools/codex/schemas/factory_config.schema.json",
    "files_changed": "tools/codex/schemas/files_changed.schema.json",
    "handoff_note": "tools/codex/schemas/handoff_note.schema.json",
    "integrator_status": "tools/codex/schemas/integrator_status.schema.json",
    "log_index": "tools/codex/schemas/log_index.schema.json",
    "run_ledger": "tools/codex/schemas/run_ledger.schema.json",
    "run_ledger_event": "tools/codex/schemas/run_ledger_event.schema.json",
    "run_manifest": "tools/codex/schemas/run_manifest.schema.json",
    "scope_lock": "tools/codex/schemas/scope_lock.schema.json",
    "worker_bundle_status": "tools/codex/schemas/worker_bundle_status.schema.json",
    "gravity_report": "tools/codex/schemas/gravity_report.schema.json",
    "protected_nodes": "tools/codex/schemas/protected_nodes.schema.json",
    "impact_cone_report": "tools/codex/schemas/impact_cone_report.schema.json",
    "dependency_diff": "tools/codex/schemas/dependency_diff.schema.json",
    "dispatch_recommendations": "tools/codex/schemas/dispatch_recommendations.schema.json"
  },
  "templates": {
    "handoff_note": "tools/codex/templates/factory/handoff_note.template.json",
    "integrator_report": "tools/codex/templates/factory/integrator_final_report.template.txt",
    "log_index": "tools/codex/templates/factory/log_index.template.json",
    "merge_plan": "tools/codex/templates/factory/merge_plan.template.md",
    "scope_lock": "tools/codex/templates/factory/scope_lock.template.json",
    "status": "tools/codex/templates/factory/status.template.json",
    "worker_status": "tools/codex/templates/factory/worker_status.template.json",
    "worker_summary": "tools/codex/templates/factory/worker_summary.template.md",
    "worker_suggestions": "tools/codex/templates/factory/worker_suggestions.template.md"
  },
  "workers": [
    "A_core",
    "B_tooling",
    "C_features",
    "D_validation",
    "Z_aggregator",
    "R_reviewer",
    "E_planner"
  ]
}
