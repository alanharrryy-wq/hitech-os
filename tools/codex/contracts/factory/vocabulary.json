        "A_worker",
        "B_worker",
        "C_worker",
        "D_worker",
        "Z_integrator"
      ]
    },
    "schema_semver_policy": {
      "patch": [
        "documentation clarifications",
        "non-semantic fixes",
        "must not invalidate previously valid payloads"
      ],
      "minor": [
        "additive optional fields",
        "additive sections",
        "enum additions only when reader tolerance is documented"
      ],
      "major": [
        "required-field additions",
        "field removal",
        "field rename without alias",
        "enum contraction",
        "semantic reinterpretation"
      ]
    }
  }
