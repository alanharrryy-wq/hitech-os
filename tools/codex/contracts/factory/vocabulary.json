{
  "schema_version": 2,
  "terms": {
    "auto_closeout": "Automatic worker artifact generation/repair step before bundle validation.",
    "baseline_owner": "Worker assigned to visual baseline update by default (C_features).",
    "blocked": "State where required checks fail.",
    "bundle": "Per-agent output directory for a run.",
    "integrator": "Worker that merges, validates, and reports only.",
    "ledger_watch": "Z_aggregator visibility step over run ledger and watch summary.",
    "ledger": "Machine-readable history of runs.",
    "optional_check": "Validation check that does not block by default.",
    "pass": "State where required checks succeed.",
    "required_check": "Validation gate that must pass.",
    "run_id": "Deterministic id for one execution.",
    "scope_lock": "File ownership contract for a worker.",
    "warning": "Non-blocking issue."
  },
  "graph_analysis": {
    "reason_codes": [
      "ARCH_CENTRALITY_HIGH",
      "TRANSITIVE_DEPENDENCY_HIGH",
      "DIRECT_DEPENDENT_COUNT_HIGH",
      "CROSS_SCOPE_IMPACT",
      "CROSS_WORKER_IMPACT",
      "EXTERNAL_DEPENDENCY_PRESENT",
      "PROTECTED_POLICY_RULE",
      "CONTRACT_SURFACE_CRITICAL",
