      "OWNERSHIP_AMBIGUOUS",
      "SNAPSHOT_NOT_COMPARABLE",
      "BASELINE_DRIFT",
      "HOTSPOT_RECURRING",
      "CHANGE_TOUCHES_PROTECTED_NODE",
      "DISPATCH_REQUIRES_A_CORE",
      "DISPATCH_REQUIRES_D_VALIDATION",
      "DISPATCH_DEFERRED_PENDING_UNBLOCK",
      "DISPATCH_BLOCKED_BY_POLICY",
      "OWNERSHIP_CONFLICT",
