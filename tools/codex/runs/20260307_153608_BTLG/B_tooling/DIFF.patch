+                lowered = line.lower().replace(' ', '')
+                if 'ssr:false' not in lowered:
+                    continue
+                severity = 'medium' if file_facts.probable_tooling_path else 'high'
+                message = 'dynamic(..., { ssr: false }) detected. Confirm this is a narrow client-only boundary.'
