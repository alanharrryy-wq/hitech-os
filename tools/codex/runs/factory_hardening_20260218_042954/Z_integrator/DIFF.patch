+from __future__ import annotations

+

+import datetime as dt

+from dataclasses import dataclass

+

+from .common import UTC, compact_utc

+from .ledger import load_ledger

+

+

+@dataclass(frozen=True)

+class RunIdentity:

+    run_id: str

+    kind: str

+    stamp: str

+    sequence: int

+

+

+def _parse_timestamp(value: str | None) -> dt.datetime:

+    if value:

+        return dt.datetime.strptime(value, "%Y%m%d_%H%M%S").replace(tzinfo=UTC)

+    return dt.datetime.now(UTC)

+

+

+def next_run_identity(kind: str, stamp: str | None = None) -> RunIdentity:

+    dt_value = _parse_timestamp(stamp)

+    compact = compact_utc(dt_value)

+    prefix = f"{kind}_{compact}"

+

+    ledger = load_ledger()

+    current = [entry.get("run_id", "") for entry in ledger.get("runs", [])]

+    matching = [item for item in current if item.startswith(prefix)]

+    sequence = 1

+    if matching:

+        last = sorted(matching)[-1]

+        tail = last.rsplit("_", 1)[-1]

+        if tail.isdigit():

+            sequence = int(tail) + 1

+

+    run_id = f"{prefix}_{sequence:03d}"

+    return RunIdentity(run_id=run_id, kind=kind, stamp=compact, sequence=sequence)


