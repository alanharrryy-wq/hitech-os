+from __future__ import annotations

+

+from pathlib import Path

+from typing import Any

+

+from .common import RUNS_DIR, ensure_dir, iso_utc, read_json, write_json

+from .schemas import validate_payload

+

+LEDGER_PATH = RUNS_DIR / "factory_ledger.json"

+

+

+def _default_ledger() -> dict[str, Any]:

+    return {

+        "schema_version": 1,

+        "updated_at": iso_utc(),

+        "runs": [],

+    }

+

+

+def load_ledger(path: Path | None = None) -> dict[str, Any]:

+    ledger_path = path or LEDGER_PATH

+    if not ledger_path.exists():

+        payload = _default_ledger()

+        save_ledger(payload, path=ledger_path)

+        return payload

+    payload = read_json(ledger_path)

+    if "runs" not in payload:

+        payload["runs"] = []

+    return payload

+

+

+def save_ledger(payload: dict[str, Any], path: Path | None = None) -> None:

+    ledger_path = path or LEDGER_PATH

+    payload = dict(payload)

+    payload["updated_at"] = iso_utc()

+    errors = validate_payload("run_ledger", payload)

+    if errors:

+        joined = "\n".join(errors)

+        raise ValueError(f"run ledger payload invalid:\n{joined}")

+    ensure_dir(ledger_path.parent)

+    write_json(ledger_path, payload)

+

+

+def append_run(record: dict[str, Any], path: Path | None = None) -> dict[str, Any]:

+    ledger = load_ledger(path=path)

+    runs = [entry for entry in ledger.get("runs", []) if entry.get("run_id") != record.get("run_id")]

+    runs.append(record)

+    runs.sort(key=lambda item: (str(item.get("started_at", "")), str(item.get("run_id", ""))))

+    ledger["runs"] = runs

+    save_ledger(ledger, path=path)

+    return ledger

+

+

+def query_runs(

+    *,

+    status: str | None = None,

+    kind: str | None = None,

+    limit: int = 50,

+    path: Path | None = None,

+) -> list[dict[str, Any]]:

+    ledger = load_ledger(path=path)

+    items = list(ledger.get("runs", []))

+    if status:

+        items = [entry for entry in items if str(entry.get("status", "")) == status]

+    if kind:

+        items = [entry for entry in items if str(entry.get("kind", "")) == kind]

+    items = sorted(items, key=lambda item: str(item.get("started_at", "")), reverse=True)

+    return items[: max(1, limit)]


