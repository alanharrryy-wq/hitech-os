+from __future__ import annotations

+

+from typing import Any

+

+from .common import INTEGRATOR, RUNS_DIR, WORKERS, append_log, ensure_dir, iso_utc, read_json, read_text, write_json, write_text

+from .contracts import bundle_dir, scaffold_integrator_bundle, validate_bundle

+from .ledger import append_run

+from .overlap import detect_file_overlaps, detect_scope_violations

+

+

+def _collect_worker_inputs(run_id: str, workers: list[str]) -> list[dict[str, Any]]:

+    collected: list[dict[str, Any]] = []

+    for worker in workers:

+        root = bundle_dir(run_id, worker)

+        record = {

+            "worker": worker,

+            "bundle": root.as_posix(),

+            "status": "MISSING",

+            "validation": validate_bundle(run_id, worker),

+            "files_changed": [],

+            "summary": "",

+            "diff": "",

+        }

+        if root.exists():

+            record["status"] = "PRESENT"

+            files_changed_path = root / "FILES_CHANGED.json"

+            summary_path = root / "SUMMARY.md"

+            diff_path = root / "DIFF.patch"

+            if files_changed_path.exists():

+                payload = read_json(files_changed_path)

+                record["files_changed"] = list(payload.get("changes", []))

+            if summary_path.exists():

+                record["summary"] = read_text(summary_path).strip()

+            if diff_path.exists():

+                record["diff"] = read_text(diff_path)

+        collected.append(record)

+    return collected

+

+

+def _merge_files_changed(run_id: str, collected: list[dict[str, Any]]) -> dict[str, Any]:

+    merged: list[dict[str, Any]] = []

+    for item in collected:

+        for change in item.get("files_changed", []):

+            merged.append(

+                {

+                    "path": change.get("path", ""),

+                    "change_type": change.get("change_type", "modified"),

+                    "owner": item.get("worker"),

+                    "reason": change.get("reason", ""),

+                    "sha256": change.get("sha256", ""),

+                }

+            )

+    merged = sorted(merged, key=lambda entry: (str(entry.get("path", "")), str(entry.get("owner", ""))))

+    return {

+        "schema_version": 1,

+        "run_id": run_id,

+        "owner": INTEGRATOR,

+        "changes": merged,

+    }

+

+

+def _merge_patch(collected: list[dict[str, Any]]) -> str:

+    chunks: list[str] = []

+    for item in collected:

+        worker = item.get("worker", "")

+        patch = str(item.get("diff", ""))

+        if not patch.strip():

+            continue

+        chunks.append(f"# >>> BEGIN {worker}\n{patch.rstrip()}\n# <<< END {worker}\n")

+    return "\n".join(chunks).strip() + ("\n" if chunks else "")

+

+

+def _render_merge_plan(run_id: str, collected: list[dict[str, Any]], overlap_report: dict[str, Any], scope_report: dict[str, Any]) -> str:

+    lines = [

+        f"# Merge Plan: {run_id}",

+        "",

+        "## Worker Inputs",

+    ]

+    for item in collected:

+        validation = item.get("validation", {})

+        lines.append(f"- {item['worker']}: {validation.get('status', 'UNKNOWN')} ({len(validation.get('errors', []))} errors)")

+

+    lines.extend(["", "## Overlap Report"])

+    if overlap_report.get("overlaps"):

+        for overlap in overlap_report["overlaps"]:

+            workers = ", ".join(overlap.get("workers", []))

+            lines.append(f"- {overlap['status']}: {overlap['path']} ({workers})")

+    else:

+        lines.append("- None")

+

+    lines.extend(["", "## Scope Violations"])

+    if scope_report.get("violations"):

+        for violation in scope_report["violations"]:

+            lines.append(f"- {violation['worker']}: {violation['path']} ({violation['rule']})")

+    else:

+        lines.append("- None")

+

+    return "\n".join(lines).rstrip() + "\n"

+

+

+def _render_final_report(

+    run_id: str,

+    collected: list[dict[str, Any]],

+    overlap_report: dict[str, Any],

+    scope_report: dict[str, Any],

+    final_status: str,

+) -> str:

+    lines = [

+        f"# FINAL_REPORT — {run_id}",

+        "",

+        "## Summary",

+        f"- Final status: {final_status}",

+        f"- Worker bundles processed: {len(collected)}",

+        f"- Overlap conflicts: {overlap_report.get('blocked', 0)}",

+        f"- Scope violations: {scope_report.get('blocked', 0)}",

+        "",

+        "## Inputs",

+    ]

+    for item in collected:

+        validation = item.get("validation", {})

+        lines.append(f"- {item['worker']}: {validation.get('status', 'UNKNOWN')} | errors={len(validation.get('errors', []))} | bundle={item['bundle']}")

+

+    lines.extend(["", "## Worker Summaries"])

+    for item in collected:

+        lines.append(f"### {item['worker']}")

+        summary = item.get("summary", "")

+        lines.append(summary if summary else "- No summary provided")

+        lines.append("")

+

+    lines.extend(["## Blocking Conditions"])

+    blockers: list[str] = []

+    for item in collected:

+        for error in item.get("validation", {}).get("errors", []):

+            blockers.append(f"{item['worker']}: {error}")

+    for overlap in overlap_report.get("overlaps", []):

+        if overlap.get("status") == "BLOCKED":

+            blockers.append(f"overlap: {overlap['path']} ({', '.join(overlap.get('workers', []))})")

+    for violation in scope_report.get("violations", []):

+        blockers.append(f"scope: {violation['worker']} {violation['path']}")

+

+    if blockers:

+        for blocker in sorted(blockers):

+            lines.append(f"- {blocker}")

+    else:

+        lines.append("- None")

+

+    lines.extend(

+        [

+            "",

+            "## NEXT ACTION",

+            "- If BLOCKED: resolve overlap/scope issues and rerun integration.",

+            "- If PASS: run project-level validation and publish the run report.",

+        ]

+    )

+

+    return "\n".join(lines).rstrip() + "\n"

+

+

+def integrate_run(run_id: str, workers: list[str] | None = None) -> dict[str, Any]:

+    chosen = workers or list(WORKERS)

+    scaffold_integrator_bundle(run_id)

+

+    z_dir = bundle_dir(run_id, INTEGRATOR)

+    logs_dir = ensure_dir(z_dir / "LOGS")

+    run_log = logs_dir / "integration.log.txt"

+    append_log(run_log, f"[start] run_id={run_id}")

+

+    collected = _collect_worker_inputs(run_id, chosen)

+    overlap_report = detect_file_overlaps(run_id, workers=chosen)

+    scope_report = detect_scope_violations(run_id, workers=chosen)

+    merged_files = _merge_files_changed(run_id, collected)

+    merged_patch = _merge_patch(collected)

+

+    worker_blockers = [item for item in collected if item.get("validation", {}).get("status") != "PASS"]

+    blocked = bool(worker_blockers or overlap_report.get("blocked") or scope_report.get("blocked"))

+    final_status = "BLOCKED" if blocked else "PASS"

+

+    merge_plan = _render_merge_plan(run_id, collected, overlap_report, scope_report)

+    final_report = _render_final_report(run_id, collected, overlap_report, scope_report, final_status)

+

+    write_json(z_dir / "FILES_CHANGED.json", merged_files)

+    write_text(z_dir / "DIFF.patch", merged_patch)

+    write_text(z_dir / "MERGE_PLAN.md", merge_plan)

+    write_text(z_dir / "FINAL_REPORT.txt", final_report)

+

+    status_payload = {

+        "schema_version": 1,

+        "run_id": run_id,

+        "worker_id": INTEGRATOR,

+        "status": final_status,

+        "started_at": iso_utc(),

+        "ended_at": iso_utc(),

+        "required_checks": [

+            {"name": "worker_bundle_validation", "status": "PASS" if not worker_blockers else "BLOCKED"},

+            {"name": "overlap_detection", "status": overlap_report.get("status", "BLOCKED")},

+            {"name": "scope_detection", "status": scope_report.get("status", "BLOCKED")},

+        ],

+        "optional_checks": [],

+        "errors": [

+            {

+                "kind": "bundle",

+                "detail": item,

+            }

+            for item in worker_blockers

+        ],

+        "warnings": [

+            {

+                "kind": "overlap",

+                "detail": overlap,

+            }

+            for overlap in overlap_report.get("overlaps", [])

+            if overlap.get("status") == "WARN"

+        ],

+        "artifacts": [

+            "FINAL_REPORT.txt",

+            "MERGE_PLAN.md",

+            "FILES_CHANGED.json",

+            "DIFF.patch",

+            "LOGS/integration.log.txt",

+        ],

+    }

+    write_json(z_dir / "STATUS.json", status_payload)

+

+    log_index_payload = {

+        "schema_version": 1,

+        "run_id": run_id,

+        "owner": INTEGRATOR,

+        "logs": [

+            {

+                "name": "integration",

+                "path": "LOGS/integration.log.txt",

+                "rc": 0 if final_status == "PASS" else 2,

+            }

+        ],

+    }

+    write_json(z_dir / "LOGS" / "INDEX.json", log_index_payload)

+

+    append_log(run_log, f"[done] final_status={final_status}")

+

+    run_record = {

+        "run_id": run_id,

+        "kind": "factory",

+        "status": final_status,

+        "started_at": status_payload["started_at"],

+        "ended_at": status_payload["ended_at"],

+        "report": (z_dir / "FINAL_REPORT.txt").as_posix(),

+        "path": (RUNS_DIR / run_id).as_posix(),

+        "workers": chosen,

+    }

+    append_run(run_record)

+

+    return {

+        "run_id": run_id,

+        "status": final_status,

+        "z_dir": z_dir.as_posix(),

+        "worker_blockers": len(worker_blockers),

+        "overlap_blockers": overlap_report.get("blocked", 0),

+        "scope_blockers": scope_report.get("blocked", 0),

+    }


