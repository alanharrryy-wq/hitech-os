{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"tools/codex/schemas/protected_nodes.schema.json",
  "title":"Protected Nodes",
  "type":"object",
  "additionalProperties":false,
  "required":["schema_version","schema_family","compatibility_mode","minimum_reader_version","breaking_change","artifact_type","artifact_id","artifact_status","run_id","generated_at_utc","generator","repository","snapshot_lineage","policy","summary","protected_nodes","exemptions","notes"],
  "properties":{
    "schema_version":{"$ref":"#/$defs/semver"},
    "schema_family":{"type":"string","const":"HITECH_GRAPH_ANALYSIS"},
    "compatibility_mode":{"$ref":"#/$defs/compatibilityMode"},
    "minimum_reader_version":{"$ref":"#/$defs/semver"},
    "breaking_change":{"type":"boolean"},
    "artifact_type":{"type":"string","const":"PROTECTED_NODES"},
    "artifact_id":{"$ref":"#/$defs/id"},
    "artifact_status":{"$ref":"#/$defs/artifactStatus"},
    "run_id":{"$ref":"#/$defs/runId"},
    "generated_at_utc":{"type":"string","format":"date-time"},
    "generator":{"$ref":"#/$defs/generator"},
    "repository":{"$ref":"#/$defs/repository"},
    "snapshot_lineage":{"$ref":"#/$defs/snapshotLineage"},
    "policy":{"type":"object","additionalProperties":false,"required":["rule_name","rule_version","default_block_result","required_protocol_steps","explicit_authorization_required","unauthorized_mutation_status"],"properties":{"rule_name":{"$ref":"#/$defs/nonEmpty"},"rule_version":{"$ref":"#/$defs/semver"},"default_block_result":{"$ref":"#/$defs/artifactStatus"},"required_protocol_steps":{"type":"array","minItems":1,"uniqueItems":true,"items":{"$ref":"#/$defs/protocolStep"}},"explicit_authorization_required":{"type":"boolean"},"unauthorized_mutation_status":{"$ref":"#/$defs/artifactStatus"}}},
    "summary":{"type":"object","additionalProperties":false,"required":["protected_count","watched_count","guarded_count","protected_level_count","locked_count","exemption_count","highest_risk_level"],"properties":{"protected_count":{"type":"integer","minimum":0},"watched_count":{"type":"integer","minimum":0},"guarded_count":{"type":"integer","minimum":0},"protected_level_count":{"type":"integer","minimum":0},"locked_count":{"type":"integer","minimum":0},"exemption_count":{"type":"integer","minimum":0},"highest_risk_level":{"$ref":"#/$defs/riskLevel"}}},
    "protected_nodes":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["node_id","display_name","node_type","scope_id","scope","canonical_path","gravity_level","protection_level","owner_worker","affected_workers","dependent_count","transitive_dependent_count","risk_level","reason_codes","required_protocol_steps","required_artifacts","required_reviewers","unauthorized_mutation_result","explicit_exemptions_allowed","dependency_basis","notes"],"properties":{"node_id":{"$ref":"#/$defs/id"},"display_name":{"$ref":"#/$defs/nonEmpty"},"node_type":{"$ref":"#/$defs/nodeType"},"scope_id":{"$ref":"#/$defs/id"},"scope":{"$ref":"#/$defs/scopeRef"},"canonical_path":{"$ref":"#/$defs/path"},"gravity_level":{"type":"string","enum":["HIGH","PROTECTED"]},"protection_level":{"$ref":"#/$defs/protectionLevel"},"owner_worker":{"$ref":"#/$defs/workerId"},"affected_workers":{"type":"array","minItems":1,"uniqueItems":true,"items":{"$ref":"#/$defs/workerId"}},"dependent_count":{"type":"integer","minimum":0},"transitive_dependent_count":{"type":"integer","minimum":0},"risk_level":{"$ref":"#/$defs/riskLevel"},"reason_codes":{"type":"array","minItems":1,"uniqueItems":true,"items":{"$ref":"#/$defs/reasonCode"}},"required_protocol_steps":{"type":"array","minItems":1,"uniqueItems":true,"items":{"$ref":"#/$defs/protocolStep"}},"required_artifacts":{"type":"array","minItems":1,"uniqueItems":true,"items":{"$ref":"#/$defs/protocolArtifact"}},"required_reviewers":{"type":"array","minItems":1,"uniqueItems":true,"items":{"$ref":"#/$defs/reviewerId"}},"unauthorized_mutation_result":{"$ref":"#/$defs/artifactStatus"},"explicit_exemptions_allowed":{"type":"boolean"},"dependency_basis":{"$ref":"#/$defs/dependencyBasis"},"notes":{"$ref":"#/$defs/notes"}}}},
    "exemptions":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["exemption_id","node_id","run_id","granted_by","reason_codes","reason","expires_at_utc","conditions","status"],"properties":{"exemption_id":{"$ref":"#/$defs/id"},"node_id":{"$ref":"#/$defs/id"},"run_id":{"$ref":"#/$defs/runId"},"granted_by":{"$ref":"#/$defs/nonEmpty"},"reason_codes":{"type":"array","minItems":1,"uniqueItems":true,"items":{"$ref":"#/$defs/reasonCode"}},"reason":{"$ref":"#/$defs/nonEmpty"},"expires_at_utc":{"type":"string","format":"date-time"},"conditions":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/nonEmpty"}},"status":{"type":"string","enum":["ACTIVE","EXPIRED","REVOKED"]}}}},
    "deprecation":{"$ref":"#/$defs/deprecation"},
    "notes":{"$ref":"#/$defs/notes"},
    "metadata_extensions":{"$ref":"#/$defs/extensions"}
  },
  "$defs":{
    "nonEmpty":{"type":"string","minLength":1},
    "path":{"type":"string","minLength":1,"pattern":"^(?!\\s*$).+"},
    "runId":{"type":"string","pattern":"^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"},
    "id":{"type":"string","minLength":3,"maxLength":255,"pattern":"^[A-Za-z0-9][A-Za-z0-9._:/-]{2,254}$"},
    "semver":{"type":"string","pattern":"^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"},
    "artifactStatus":{"type":"string","enum":["OK","WARNING","BLOCKED","INCOMPLETE","NOT_COMPARABLE"]},
    "compatibilityMode":{"type":"string","enum":["STRICT_PRODUCER","STRICT_PRODUCER_COMPAT_READER","LEGACY_ALIAS_ACCEPTED"]},
    "riskLevel":{"type":"string","enum":["NONE","LOW","MEDIUM","HIGH","CRITICAL"]},
    "protectionLevel":{"type":"string","enum":["WATCHED","GUARDED","PROTECTED","LOCKED","WATCH","ELEVATED","STRICT"]},
    "nodeType":{"type":"string","enum":["module","package","file","contract","schema","api","service","library","test","pipeline","workspace","other"]},
    "reasonCode":{"type":"string","enum":["ARCH_CENTRALITY_HIGH","TRANSITIVE_DEPENDENCY_HIGH","DIRECT_DEPENDENT_COUNT_HIGH","CROSS_SCOPE_IMPACT","CROSS_WORKER_IMPACT","EXTERNAL_DEPENDENCY_PRESENT","PROTECTED_POLICY_RULE","CONTRACT_SURFACE_CRITICAL","VALIDATION_BURDEN_HIGH","CYCLE_MEMBERSHIP","OWNERSHIP_AMBIGUOUS","SNAPSHOT_NOT_COMPARABLE","BASELINE_DRIFT","HOTSPOT_RECURRING","CHANGE_TOUCHES_PROTECTED_NODE","DISPATCH_REQUIRES_A_CORE","DISPATCH_REQUIRES_D_VALIDATION","DISPATCH_DEFERRED_PENDING_UNBLOCK","DISPATCH_BLOCKED_BY_POLICY","OWNERSHIP_CONFLICT","MISSING_CONTRACT","VALIDATION_GAP","INCOMPARABLE_SNAPSHOT","CONTRACT_BREAKING_CHANGE","HIGH_CHURN"]},
    "workerId":{"type":"string","enum":["A_core","B_tooling","C_features","D_validation","Z_aggregator","R_reviewer","E_planner","A_worker","B_worker","C_worker","D_worker","Z_integrator","R_worker","E_worker","UNASSIGNED"]},
    "reviewerId":{"type":"string","enum":["A_core","D_validation","Z_aggregator","R_reviewer","E_planner","CONTRACT_OWNER","REPO_OWNER","A_worker","D_worker","Z_integrator","R_worker","E_worker"]},
    "protocolStep":{"type":"string","enum":["DECLARE_PROTECTED_CHANGE","GENERATE_IMPACT_CONE_REPORT","GENERATE_DEPENDENCY_DIFF","REQUEST_D_VALIDATION_REVIEW","REQUEST_Z_APPROVAL","ATTACH_EVIDENCE_TO_FINAL_REPORT"]},
    "protocolArtifact":{"type":"string","enum":["IMPACT_CONE_REPORT","DEPENDENCY_DIFF","VALIDATION_EVIDENCE","CONTRACT_DIFF","OWNER_APPROVAL","Z_APPROVAL","DISPATCH_RECOMMENDATIONS"]},
    "generator":{"type":"object","additionalProperties":false,"required":["actor","tool_name","tool_version","execution_mode","invocation_context","source_inputs"],"properties":{"actor":{"$ref":"#/$defs/nonEmpty"},"tool_name":{"$ref":"#/$defs/nonEmpty"},"tool_version":{"$ref":"#/$defs/semver"},"execution_mode":{"type":"string","enum":["analysis","integration","planning","audit","dry_run","ci"]},"invocation_context":{"type":"object","additionalProperties":false,"required":["run_phase","command","working_directory","environment_keys"],"properties":{"run_phase":{"$ref":"#/$defs/nonEmpty"},"command":{"$ref":"#/$defs/nonEmpty"},"working_directory":{"$ref":"#/$defs/path"},"environment_keys":{"type":"array","uniqueItems":true,"items":{"$ref":"#/$defs/nonEmpty"}}}},"source_inputs":{"type":"array","minItems":1,"items":{"type":"object","additionalProperties":false,"required":["input_type","input_id","input_path","input_sha256","input_role"],"properties":{"input_type":{"type":"string","enum":["GRAPH_SNAPSHOT","RUN_BUNDLE","CONTRACT_REGISTRY","SCHEMA","MANUAL_OVERRIDE","OTHER"]},"input_id":{"$ref":"#/$defs/id"},"input_path":{"$ref":"#/$defs/path"},"input_sha256":{"type":["string","null"],"pattern":"^[A-Fa-f0-9]{64}$"},"input_role":{"$ref":"#/$defs/nonEmpty"}}}}}},
    "repository":{"type":"object","additionalProperties":false,"required":["repo_root","base_ref","head_ref","commit_sha","comparison_basis"],"properties":{"repo_root":{"$ref":"#/$defs/path"},"base_ref":{"$ref":"#/$defs/nonEmpty"},"head_ref":{"$ref":"#/$defs/nonEmpty"},"commit_sha":{"type":"string","pattern":"^[0-9a-fA-F]{7,64}$"},"comparison_basis":{"type":"string","enum":["working_tree","base_vs_head","run_snapshot","manual"]}}},
    "snapshotLineage":{"type":"object","additionalProperties":false,"required":["snapshot_id","previous_snapshot_id","baseline_snapshot_id","lineage_mode","graph_build_id"],"properties":{"snapshot_id":{"$ref":"#/$defs/id"},"previous_snapshot_id":{"type":["string","null"],"pattern":"^[A-Za-z0-9][A-Za-z0-9._:/-]{2,254}$"},"baseline_snapshot_id":{"type":["string","null"],"pattern":"^[A-Za-z0-9][A-Za-z0-9._:/-]{2,254}$"},"lineage_mode":{"type":"string","enum":["FULL","INCREMENTAL","REBUILT","NOT_AVAILABLE"]},"graph_build_id":{"$ref":"#/$defs/id"}}},
    "scopeRef":{"type":"object","additionalProperties":false,"required":["scope_id","scope_type","scope_path","owner_worker","parent_scope_id","internal_only"],"properties":{"scope_id":{"$ref":"#/$defs/id"},"scope_type":{"type":"string","enum":["package","service","module_group","contract_surface","workspace","other"]},"scope_path":{"$ref":"#/$defs/path"},"owner_worker":{"$ref":"#/$defs/workerId"},"parent_scope_id":{"type":["string","null"],"pattern":"^[A-Za-z0-9][A-Za-z0-9._:/-]{2,254}$"},"internal_only":{"type":"boolean"}}},
    "dependencyBasis":{"type":"object","additionalProperties":false,"required":["upstream_nodes","downstream_nodes","dependency_count","transitive_dependency_count","graph_scope_reference"],"properties":{"upstream_nodes":{"type":"array","uniqueItems":true,"items":{"$ref":"#/$defs/id"}},"downstream_nodes":{"type":"array","uniqueItems":true,"items":{"$ref":"#/$defs/id"}},"dependency_count":{"type":"integer","minimum":0},"transitive_dependency_count":{"type":"integer","minimum":0},"graph_scope_reference":{"$ref":"#/$defs/nonEmpty"}}},
    "notes":{"type":"array","items":{"type":"string","minLength":1}},
    "deprecation":{"type":"object","additionalProperties":false,"required":["deprecated_fields","replacement_fields","compatibility_notes"],"properties":{"deprecated_fields":{"type":"array","uniqueItems":true,"items":{"$ref":"#/$defs/nonEmpty"}},"replacement_fields":{"type":"object","additionalProperties":{"$ref":"#/$defs/nonEmpty"}},"compatibility_notes":{"$ref":"#/$defs/notes"}}},
    "extensions":{"type":"object","additionalProperties":false,"patternProperties":{"^x_[A-Za-z0-9_.-]+$":{}}}
  }
}


