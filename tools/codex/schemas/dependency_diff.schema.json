{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"tools/codex/schemas/dependency_diff.schema.json",
  "title":"Dependency Diff",
  "type":"object",
  "additionalProperties":false,
  "required":["schema_version","schema_family","compatibility_mode","minimum_reader_version","breaking_change","artifact_type","artifact_id","artifact_status","run_id","generated_at_utc","generator","repository","snapshot_lineage","comparison","summary","nodes_added","nodes_removed","edges_added","edges_removed","classification_changes","cycle_changes","ownership_changes","contract_changes","notes"],
  "properties":{
    "schema_version":{"$ref":"#/$defs/semver"},
    "schema_family":{"type":"string","const":"HITECH_GRAPH_ANALYSIS"},
    "compatibility_mode":{"$ref":"#/$defs/compatibilityMode"},
    "minimum_reader_version":{"$ref":"#/$defs/semver"},
    "breaking_change":{"type":"boolean"},
    "artifact_type":{"type":"string","const":"DEPENDENCY_DIFF"},
    "artifact_id":{"$ref":"#/$defs/id"},
    "artifact_status":{"$ref":"#/$defs/artifactStatus"},
    "run_id":{"$ref":"#/$defs/runId"},
    "generated_at_utc":{"type":"string","format":"date-time"},
    "generator":{"$ref":"#/$defs/generator"},
    "repository":{"$ref":"#/$defs/repository"},
    "snapshot_lineage":{"$ref":"#/$defs/snapshotLineage"},
    "comparison":{"type":"object","additionalProperties":false,"required":["baseline_snapshot_id","current_snapshot_id","baseline_run_id","current_run_id","baseline_ref","current_ref","comparable","incompatibility_reason"],"properties":{"baseline_snapshot_id":{"$ref":"#/$defs/id"},"current_snapshot_id":{"$ref":"#/$defs/id"},"baseline_run_id":{"$ref":"#/$defs/runId"},"current_run_id":{"$ref":"#/$defs/runId"},"baseline_ref":{"$ref":"#/$defs/nonEmpty"},"current_ref":{"$ref":"#/$defs/nonEmpty"},"comparable":{"type":"boolean"},"incompatibility_reason":{"type":"string"}}},
    "summary":{"type":"object","additionalProperties":false,"required":["node_add_count","node_remove_count","edge_add_count","edge_remove_count","classification_change_count","protected_add_count","protected_remove_count","cycle_add_count","cycle_remove_count","ownership_change_count"],"properties":{"node_add_count":{"type":"integer","minimum":0},"node_remove_count":{"type":"integer","minimum":0},"edge_add_count":{"type":"integer","minimum":0},"edge_remove_count":{"type":"integer","minimum":0},"classification_change_count":{"type":"integer","minimum":0},"protected_add_count":{"type":"integer","minimum":0},"protected_remove_count":{"type":"integer","minimum":0},"cycle_add_count":{"type":"integer","minimum":0},"cycle_remove_count":{"type":"integer","minimum":0},"ownership_change_count":{"type":"integer","minimum":0}}},
    "nodes_added":{"type":"array","items":{"$ref":"#/$defs/nodeRef"}},
    "nodes_removed":{"type":"array","items":{"$ref":"#/$defs/nodeRef"}},
    "edges_added":{"type":"array","items":{"$ref":"#/$defs/edgeRef"}},
    "edges_removed":{"type":"array","items":{"$ref":"#/$defs/edgeRef"}},
    "classification_changes":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["node_id","previous_gravity_level","current_gravity_level","previous_gravity_score","current_gravity_score","delta","reason_codes","reason"],"properties":{"node_id":{"$ref":"#/$defs/id"},"previous_gravity_level":{"$ref":"#/$defs/gravityLevel"},"current_gravity_level":{"$ref":"#/$defs/gravityLevel"},"previous_gravity_score":{"type":"number","minimum":0},"current_gravity_score":{"type":"number","minimum":0},"delta":{"type":"number"},"reason_codes":{"type":"array","minItems":1,"uniqueItems":true,"items":{"$ref":"#/$defs/reasonCode"}},"reason":{"$ref":"#/$defs/nonEmpty"}}}},
    "cycle_changes":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["cycle_id","anomaly_type","change_type","member_nodes","severity","reason_codes","notes"],"properties":{"cycle_id":{"$ref":"#/$defs/id"},"anomaly_type":{"type":"string","const":"CYCLE"},"change_type":{"type":"string","enum":["added","removed","changed","ADDED","REMOVED","CHANGED"]},"member_nodes":{"type":"array","minItems":2,"uniqueItems":true,"items":{"$ref":"#/$defs/id"}},"severity":{"$ref":"#/$defs/riskLevel"},"reason_codes":{"type":"array","minItems":1,"uniqueItems":true,"items":{"$ref":"#/$defs/reasonCode"}},"notes":{"$ref":"#/$defs/notes"}}}},
    "ownership_changes":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["node_id","previous_owner","current_owner","reason_codes","reason"],"properties":{"node_id":{"$ref":"#/$defs/id"},"previous_owner":{"$ref":"#/$defs/workerId"},"current_owner":{"$ref":"#/$defs/workerId"},"reason_codes":{"type":"array","minItems":1,"uniqueItems":true,"items":{"$ref":"#/$defs/reasonCode"}},"reason":{"$ref":"#/$defs/nonEmpty"}}}},
    "contract_changes":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["contract_id","change_type","producers_affected","consumers_affected","reason_codes","notes"],"properties":{"contract_id":{"$ref":"#/$defs/id"},"change_type":{"type":"string","enum":["ADDED","REMOVED","MODIFIED_NON_BREAKING","MODIFIED_BREAKING","OWNER_CHANGED","CONSUMER_SET_CHANGED","PRODUCER_SET_CHANGED","added","removed","modified","producer_changed","consumer_changed"]},"producers_affected":{"type":"array","uniqueItems":true,"items":{"$ref":"#/$defs/workerId"}},"consumers_affected":{"type":"array","uniqueItems":true,"items":{"$ref":"#/$defs/workerId"}},"reason_codes":{"type":"array","minItems":1,"uniqueItems":true,"items":{"$ref":"#/$defs/reasonCode"}},"notes":{"$ref":"#/$defs/notes"}}}},
    "deprecation":{"$ref":"#/$defs/deprecation"},
    "notes":{"$ref":"#/$defs/notes"},
    "metadata_extensions":{"$ref":"#/$defs/extensions"}
  },
  "$defs":{
    "nonEmpty":{"type":"string","minLength":1},
    "path":{"type":"string","minLength":1,"pattern":"^(?!\\s*$).+"},
    "runId":{"type":"string","pattern":"^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"},
    "id":{"type":"string","minLength":3,"maxLength":255,"pattern":"^[A-Za-z0-9][A-Za-z0-9._:/-]{2,254}$"},
    "semver":{"type":"string","pattern":"^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"},
    "artifactStatus":{"type":"string","enum":["OK","WARNING","BLOCKED","INCOMPLETE","NOT_COMPARABLE"]},
    "compatibilityMode":{"type":"string","enum":["STRICT_PRODUCER","STRICT_PRODUCER_COMPAT_READER","LEGACY_ALIAS_ACCEPTED"]},
    "gravityLevel":{"type":"string","enum":["LOW","MEDIUM","HIGH","PROTECTED"]},
    "riskLevel":{"type":"string","enum":["NONE","LOW","MEDIUM","HIGH","CRITICAL"]},
    "reasonCode":{"type":"string","enum":["ARCH_CENTRALITY_HIGH","TRANSITIVE_DEPENDENCY_HIGH","DIRECT_DEPENDENT_COUNT_HIGH","CROSS_SCOPE_IMPACT","CROSS_WORKER_IMPACT","EXTERNAL_DEPENDENCY_PRESENT","PROTECTED_POLICY_RULE","CONTRACT_SURFACE_CRITICAL","VALIDATION_BURDEN_HIGH","CYCLE_MEMBERSHIP","OWNERSHIP_AMBIGUOUS","SNAPSHOT_NOT_COMPARABLE","BASELINE_DRIFT","HOTSPOT_RECURRING","CHANGE_TOUCHES_PROTECTED_NODE","DISPATCH_REQUIRES_A_CORE","DISPATCH_REQUIRES_D_VALIDATION","DISPATCH_DEFERRED_PENDING_UNBLOCK","DISPATCH_BLOCKED_BY_POLICY","OWNERSHIP_CONFLICT","MISSING_CONTRACT","VALIDATION_GAP","INCOMPARABLE_SNAPSHOT","CONTRACT_BREAKING_CHANGE","HIGH_CHURN"]},
    "workerId":{"type":"string","enum":["A_core","B_tooling","C_features","D_validation","Z_aggregator","R_reviewer","E_planner","A_worker","B_worker","C_worker","D_worker","Z_integrator","R_worker","E_worker","UNASSIGNED"]},
    "generator":{"type":"object","additionalProperties":false,"required":["actor","tool_name","tool_version","execution_mode","invocation_context","source_inputs"],"properties":{"actor":{"$ref":"#/$defs/nonEmpty"},"tool_name":{"$ref":"#/$defs/nonEmpty"},"tool_version":{"$ref":"#/$defs/semver"},"execution_mode":{"type":"string","enum":["analysis","integration","planning","audit","dry_run","ci"]},"invocation_context":{"type":"object","additionalProperties":false,"required":["run_phase","command","working_directory","environment_keys"],"properties":{"run_phase":{"$ref":"#/$defs/nonEmpty"},"command":{"$ref":"#/$defs/nonEmpty"},"working_directory":{"$ref":"#/$defs/path"},"environment_keys":{"type":"array","uniqueItems":true,"items":{"$ref":"#/$defs/nonEmpty"}}}},"source_inputs":{"type":"array","minItems":1,"items":{"type":"object","additionalProperties":false,"required":["input_type","input_id","input_path","input_sha256","input_role"],"properties":{"input_type":{"type":"string","enum":["GRAPH_SNAPSHOT","RUN_BUNDLE","CONTRACT_REGISTRY","SCHEMA","MANUAL_OVERRIDE","OTHER"]},"input_id":{"$ref":"#/$defs/id"},"input_path":{"$ref":"#/$defs/path"},"input_sha256":{"type":["string","null"],"pattern":"^[A-Fa-f0-9]{64}$"},"input_role":{"$ref":"#/$defs/nonEmpty"}}}}}},
    "repository":{"type":"object","additionalProperties":false,"required":["repo_root","base_ref","head_ref","commit_sha","comparison_basis"],"properties":{"repo_root":{"$ref":"#/$defs/path"},"base_ref":{"$ref":"#/$defs/nonEmpty"},"head_ref":{"$ref":"#/$defs/nonEmpty"},"commit_sha":{"type":"string","pattern":"^[0-9a-fA-F]{7,64}$"},"comparison_basis":{"type":"string","enum":["working_tree","base_vs_head","run_snapshot","manual"]}}},
    "snapshotLineage":{"type":"object","additionalProperties":false,"required":["snapshot_id","previous_snapshot_id","baseline_snapshot_id","lineage_mode","graph_build_id"],"properties":{"snapshot_id":{"$ref":"#/$defs/id"},"previous_snapshot_id":{"type":["string","null"],"pattern":"^[A-Za-z0-9][A-Za-z0-9._:/-]{2,254}$"},"baseline_snapshot_id":{"type":["string","null"],"pattern":"^[A-Za-z0-9][A-Za-z0-9._:/-]{2,254}$"},"lineage_mode":{"type":"string","enum":["FULL","INCREMENTAL","REBUILT","NOT_AVAILABLE"]},"graph_build_id":{"$ref":"#/$defs/id"}}},
    "nodeRef":{"type":"object","additionalProperties":false,"required":["node_id","node_type","scope_id","canonical_path","owner_worker"],"properties":{"node_id":{"$ref":"#/$defs/id"},"node_type":{"type":"string","enum":["module","package","file","contract","schema","api","service","library","test","pipeline","workspace","other"]},"scope_id":{"$ref":"#/$defs/id"},"canonical_path":{"$ref":"#/$defs/path"},"owner_worker":{"$ref":"#/$defs/workerId"}}},
    "edgeRef":{"type":"object","additionalProperties":false,"required":["from_node_id","to_node_id","edge_type","weight"],"properties":{"from_node_id":{"$ref":"#/$defs/id"},"to_node_id":{"$ref":"#/$defs/id"},"edge_type":{"type":"string","enum":["imports","calls","depends_on","produces","consumes","tests","owns","references","other"]},"weight":{"type":"number","minimum":0}}},
    "notes":{"type":"array","items":{"type":"string","minLength":1}},
    "deprecation":{"type":"object","additionalProperties":false,"required":["deprecated_fields","replacement_fields","compatibility_notes"],"properties":{"deprecated_fields":{"type":"array","uniqueItems":true,"items":{"$ref":"#/$defs/nonEmpty"}},"replacement_fields":{"type":"object","additionalProperties":{"$ref":"#/$defs/nonEmpty"}},"compatibility_notes":{"$ref":"#/$defs/notes"}}},
    "extensions":{"type":"object","additionalProperties":false,"patternProperties":{"^x_[A-Za-z0-9_.-]+$":{}}}
  }
}


