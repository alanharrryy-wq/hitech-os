    "generator":{"type":"object","additionalProperties":false,"required":["actor","tool_name","tool_version","execution_mode","invocation_context","source_inputs"],"properties":{"actor":{"$ref":"#/$defs/nonEmpty"},"tool_name":{"$ref":"#/$defs/nonEmpty"},"tool_version":{"$ref":"#/$defs/semver"},"execution_mode":{"type":"string","enum":["analysis","integration","planning","audit","dry_run","ci"]},"invocation_context":{"type":"object","additionalProperties":false,"required":["run_phase","command","working_directory","environment_keys"],"properties":{"run_phase":{"$ref":"#/$defs/nonEmpty"},"command":{"$ref":"#/$defs/nonEmpty"},"working_directory":{"$ref":"#/$defs/path"},"environment_keys":{"type":"array","uniqueItems":true,"items":{"$ref":"#/$defs/nonEmpty"}}}},"source_inputs":{"type":"array","minItems":1,"items":{"type":"object","additionalProperties":false,"required":["input_type","input_id","input_path","input_sha256","input_role"],"properties":{"input_type":{"type":"string","enum":["GRAPH_SNAPSHOT","RUN_BUNDLE","CONTRACT_REGISTRY","SCHEMA","MANUAL_OVERRIDE","OTHER"]},"input_id":{"$ref":"#/$defs/id"},"input_path":{"$ref":"#/$defs/path"},"input_sha256":{"type":["string","null"],"pattern":"^[A-Fa-f0-9]{64}$"},"input_role":{"$ref":"#/$defs/nonEmpty"}}}}}},
    "repository":{"type":"object","additionalProperties":false,"required":["repo_root","base_ref","head_ref","commit_sha","comparison_basis"],"properties":{"repo_root":{"$ref":"#/$defs/path"},"base_ref":{"$ref":"#/$defs/nonEmpty"},"head_ref":{"$ref":"#/$defs/nonEmpty"},"commit_sha":{"type":"string","pattern":"^[0-9a-fA-F]{7,64}$"},"comparison_basis":{"type":"string","enum":["working_tree","base_vs_head","run_snapshot","manual"]}}},
    "snapshotLineage":{"type":"object","additionalProperties":false,"required":["snapshot_id","previous_snapshot_id","baseline_snapshot_id","lineage_mode","graph_build_id"],"properties":{"snapshot_id":{"$ref":"#/$defs/id"},"previous_snapshot_id":{"type":["string","null"],"pattern":"^[A-Za-z0-9][A-Za-z0-9._:/-]{2,254}$"},"baseline_snapshot_id":{"type":["string","null"],"pattern":"^[A-Za-z0-9][A-Za-z0-9._:/-]{2,254}$"},"lineage_mode":{"type":"string","enum":["FULL","INCREMENTAL","REBUILT","NOT_AVAILABLE"]},"graph_build_id":{"$ref":"#/$defs/id"}}},
    "entityRef":{"type":"object","additionalProperties":false,"required":["entity_id","entity_type","canonical_path","protected"],"properties":{"entity_id":{"$ref":"#/$defs/id"},"entity_type":{"type":"string","enum":["node","scope","contract","file","module","schema","api","test","command","other"]},"canonical_path":{"$ref":"#/$defs/path"},"protected":{"type":"boolean"}}},
    "scopeRef":{"type":"object","additionalProperties":false,"required":["scope_id","scope_type","scope_path","owner_worker","parent_scope_id","internal_only"],"properties":{"scope_id":{"$ref":"#/$defs/id"},"scope_type":{"type":"string","enum":["package","service","module_group","contract_surface","workspace","other"]},"scope_path":{"$ref":"#/$defs/path"},"owner_worker":{"$ref":"#/$defs/workerId"},"parent_scope_id":{"type":["string","null"],"pattern":"^[A-Za-z0-9][A-Za-z0-9._:/-]{2,254}$"},"internal_only":{"type":"boolean"}}},
    "dependencyBasis":{"type":"object","additionalProperties":false,"required":["upstream_nodes","downstream_nodes","dependency_count","transitive_dependency_count","graph_scope_reference"],"properties":{"upstream_nodes":{"type":"array","uniqueItems":true,"items":{"$ref":"#/$defs/id"}},"downstream_nodes":{"type":"array","uniqueItems":true,"items":{"$ref":"#/$defs/id"}},"dependency_count":{"type":"integer","minimum":0},"transitive_dependency_count":{"type":"integer","minimum":0},"graph_scope_reference":{"$ref":"#/$defs/nonEmpty"}}},
    "contractTarget":{"type":"object","additionalProperties":false,"required":["target_id","contract_id","owner_worker","rationale_codes"],"properties":{"target_id":{"$ref":"#/$defs/id"},"contract_id":{"$ref":"#/$defs/id"},"owner_worker":{"$ref":"#/$defs/workerId"},"rationale_codes":{"type":"array","minItems":1,"uniqueItems":true,"items":{"$ref":"#/$defs/reasonCode"}}}},
    "testTarget":{"type":"object","additionalProperties":false,"required":["target_id","path","owner_worker","rationale_codes"],"properties":{"target_id":{"$ref":"#/$defs/id"},"path":{"$ref":"#/$defs/path"},"owner_worker":{"$ref":"#/$defs/workerId"},"rationale_codes":{"type":"array","minItems":1,"uniqueItems":true,"items":{"$ref":"#/$defs/reasonCode"}}}},
    "commandTarget":{"type":"object","additionalProperties":false,"required":["target_id","command","owner_worker","rationale_codes"],"properties":{"target_id":{"$ref":"#/$defs/id"},"command":{"$ref":"#/$defs/nonEmpty"},"owner_worker":{"$ref":"#/$defs/workerId"},"rationale_codes":{"type":"array","minItems":1,"uniqueItems":true,"items":{"$ref":"#/$defs/reasonCode"}}}},
    "smokeTarget":{"type":"object","additionalProperties":false,"required":["target_id","path","rationale_codes"],"properties":{"target_id":{"$ref":"#/$defs/id"},"path":{"$ref":"#/$defs/path"},"rationale_codes":{"type":"array","minItems":1,"uniqueItems":true,"items":{"$ref":"#/$defs/reasonCode"}}}},
    "validationTargets":{"type":"object","additionalProperties":false,"required":["contracts","tests","commands","smoke_paths"],"properties":{"contracts":{"type":"array","items":{"$ref":"#/$defs/contractTarget"}},"tests":{"type":"array","items":{"$ref":"#/$defs/testTarget"}},"commands":{"type":"array","items":{"$ref":"#/$defs/commandTarget"}},"smoke_paths":{"type":"array","items":{"$ref":"#/$defs/smokeTarget"}}}},
    "queueItem":{"type":"object","additionalProperties":false,"required":["slice_id","priority","risk_level","reason_codes","reason"],"properties":{"slice_id":{"$ref":"#/$defs/id"},"priority":{"$ref":"#/$defs/priority"},"risk_level":{"$ref":"#/$defs/riskLevel"},"reason_codes":{"type":"array","minItems":1,"uniqueItems":true,"items":{"$ref":"#/$defs/reasonCode"}},"reason":{"$ref":"#/$defs/nonEmpty"}}},
    "decisionRationale":{"type":"object","additionalProperties":false,"required":["rationale_codes","evidence_sources","risk_drivers","dependency_basis","protocol_requirements"],"properties":{"rationale_codes":{"type":"array","minItems":1,"uniqueItems":true,"items":{"$ref":"#/$defs/reasonCode"}},"evidence_sources":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/nonEmpty"}},"risk_drivers":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/nonEmpty"}},"dependency_basis":{"$ref":"#/$defs/dependencyBasis"},"protocol_requirements":{"type":"array","uniqueItems":true,"items":{"type":"string","enum":["DECLARE_PROTECTED_CHANGE","GENERATE_IMPACT_CONE_REPORT","GENERATE_DEPENDENCY_DIFF","REQUEST_D_VALIDATION_REVIEW","REQUEST_Z_APPROVAL","ATTACH_EVIDENCE_TO_FINAL_REPORT"]}}}},
    "blocker":{"type":"object","additionalProperties":false,"required":["blocker_id","blocker_code","risk_level","description","required_owner","required_unblock_action","reason_codes"],"properties":{"blocker_id":{"$ref":"#/$defs/id"},"blocker_code":{"$ref":"#/$defs/blockerCode"},"risk_level":{"$ref":"#/$defs/riskLevel"},"description":{"$ref":"#/$defs/nonEmpty"},"required_owner":{"$ref":"#/$defs/reviewerId"},"required_unblock_action":{"$ref":"#/$defs/nonEmpty"},"reason_codes":{"type":"array","minItems":1,"uniqueItems":true,"items":{"$ref":"#/$defs/reasonCode"}}}},
    "notes":{"type":"array","items":{"type":"string","minLength":1}},
    "deprecation":{"type":"object","additionalProperties":false,"required":["deprecated_fields","replacement_fields","compatibility_notes"],"properties":{"deprecated_fields":{"type":"array","uniqueItems":true,"items":{"$ref":"#/$defs/nonEmpty"}},"replacement_fields":{"type":"object","additionalProperties":{"$ref":"#/$defs/nonEmpty"}},"compatibility_notes":{"$ref":"#/$defs/notes"}}},
    "extensions":{"type":"object","additionalProperties":false,"patternProperties":{"^x_[A-Za-z0-9_.-]+$":{}}}
  }
}
