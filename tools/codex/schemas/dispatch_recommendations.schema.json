  "$defs":{
    "nonEmpty":{"type":"string","minLength":1},
    "path":{"type":"string","minLength":1,"pattern":"^(?!\\s*$).+"},
    "runId":{"type":"string","pattern":"^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"},
    "id":{"type":"string","minLength":3,"maxLength":255,"pattern":"^[A-Za-z0-9][A-Za-z0-9._:/-]{2,254}$"},
    "semver":{"type":"string","pattern":"^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"},
    "artifactStatus":{"type":"string","enum":["OK","WARNING","BLOCKED","INCOMPLETE","NOT_COMPARABLE"]},
    "compatibilityMode":{"type":"string","enum":["STRICT_PRODUCER","STRICT_PRODUCER_COMPAT_READER","LEGACY_ALIAS_ACCEPTED"]},
    "priority":{"type":"string","enum":["P0","P1","P2","P3"]},
    "riskLevel":{"type":"string","enum":["NONE","LOW","MEDIUM","HIGH","CRITICAL"]},
    "changeSize":{"type":"string","enum":["XS","S","M","L","XL"]},
