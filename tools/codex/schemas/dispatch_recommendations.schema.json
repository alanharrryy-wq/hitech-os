{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"tools/codex/schemas/dispatch_recommendations.schema.json",
  "title":"Dispatch Recommendations",
  "type":"object",
  "additionalProperties":false,
  "required":["schema_version","schema_family","compatibility_mode","minimum_reader_version","breaking_change","artifact_type","artifact_id","artifact_status","run_id","generated_at_utc","generator","repository","snapshot_lineage","planning_scope","summary","worker_queues","recommended_slices","deferred_work","blocked_work","notes"],
  "properties":{
    "schema_version":{"$ref":"#/$defs/semver"},
    "schema_family":{"type":"string","const":"HITECH_GRAPH_ANALYSIS"},
    "compatibility_mode":{"$ref":"#/$defs/compatibilityMode"},
    "minimum_reader_version":{"$ref":"#/$defs/semver"},
    "breaking_change":{"type":"boolean"},
    "artifact_type":{"type":"string","const":"DISPATCH_RECOMMENDATIONS"},
