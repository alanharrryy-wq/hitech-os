    "artifact_status":{"$ref":"#/$defs/artifactStatus"},
    "run_id":{"$ref":"#/$defs/runId"},
    "generated_at_utc":{"type":"string","format":"date-time"},
    "generator":{"$ref":"#/$defs/generator"},
    "repository":{"$ref":"#/$defs/repository"},
    "snapshot_lineage":{"$ref":"#/$defs/snapshotLineage"},
    "planning_scope":{"type":"object","additionalProperties":false,"required":["planning_mode","based_on_run_id","based_on_snapshot_id","respects_current_run_ownership","advisory_only","policy_version"],"properties":{"planning_mode":{"type":"string","enum":["next_iteration","adaptive_current_run","manual","backlog_rebalance"]},"based_on_run_id":{"$ref":"#/$defs/runId"},"based_on_snapshot_id":{"$ref":"#/$defs/id"},"respects_current_run_ownership":{"type":"boolean"},"advisory_only":{"type":"boolean"},"policy_version":{"$ref":"#/$defs/semver"}}},
    "summary":{"type":"object","additionalProperties":false,"required":["slice_count","protected_slice_count","blocked_slice_count","deferred_slice_count","high_risk_slice_count","recommended_execution_order","highest_risk_level"],"properties":{"slice_count":{"type":"integer","minimum":0},"protected_slice_count":{"type":"integer","minimum":0},"blocked_slice_count":{"type":"integer","minimum":0},"deferred_slice_count":{"type":"integer","minimum":0},"high_risk_slice_count":{"type":"integer","minimum":0},"recommended_execution_order":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/workerIdCanonical"}},"highest_risk_level":{"$ref":"#/$defs/riskLevel"}}},
    "worker_queues":{"type":"object","additionalProperties":false,"required":["A_core","B_tooling","C_features","D_validation","Z_aggregator"],"properties":{"A_core":{"type":"array","items":{"$ref":"#/$defs/queueItem"}},"B_tooling":{"type":"array","items":{"$ref":"#/$defs/queueItem"}},"C_features":{"type":"array","items":{"$ref":"#/$defs/queueItem"}},"D_validation":{"type":"array","items":{"$ref":"#/$defs/queueItem"}},"Z_aggregator":{"type":"array","items":{"$ref":"#/$defs/queueItem"}}}},
    "recommended_slices":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["slice_id","title","rationale","reason_codes","priority","risk_level","owner_worker","supporting_workers","source_entities","source_scopes","dependency_basis","allowed_paths","forbidden_paths","contracts_to_read","contracts_to_produce","validation_targets","depends_on_slices","protected_nodes_in_scope","estimated_change_size","expected_artifacts","success_criteria","decision_rationale","blockers","notes"],"properties":{"slice_id":{"$ref":"#/$defs/id"},"title":{"$ref":"#/$defs/nonEmpty"},"rationale":{"$ref":"#/$defs/nonEmpty"},"reason_codes":{"type":"array","minItems":1,"uniqueItems":true,"items":{"$ref":"#/$defs/reasonCode"}},"priority":{"$ref":"#/$defs/priority"},"risk_level":{"$ref":"#/$defs/riskLevel"},"owner_worker":{"$ref":"#/$defs/workerId"},"supporting_workers":{"type":"array","uniqueItems":true,"items":{"$ref":"#/$defs/workerId"}},"source_entities":{"type":"array","items":{"$ref":"#/$defs/entityRef"}},"source_scopes":{"type":"array","items":{"$ref":"#/$defs/scopeRef"}},"dependency_basis":{"$ref":"#/$defs/dependencyBasis"},"allowed_paths":{"type":"array","minItems":1,"uniqueItems":true,"items":{"$ref":"#/$defs/path"}},"forbidden_paths":{"type":"array","uniqueItems":true,"items":{"$ref":"#/$defs/path"}},"contracts_to_read":{"type":"array","uniqueItems":true,"items":{"$ref":"#/$defs/id"}},"contracts_to_produce":{"type":"array","uniqueItems":true,"items":{"$ref":"#/$defs/id"}},"validation_targets":{"$ref":"#/$defs/validationTargets"},"depends_on_slices":{"type":"array","uniqueItems":true,"items":{"$ref":"#/$defs/id"}},"protected_nodes_in_scope":{"type":"array","uniqueItems":true,"items":{"$ref":"#/$defs/id"}},"estimated_change_size":{"$ref":"#/$defs/changeSize"},"expected_artifacts":{"type":"array","minItems":1,"uniqueItems":true,"items":{"$ref":"#/$defs/expectedArtifact"}},"success_criteria":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/nonEmpty"}},"decision_rationale":{"$ref":"#/$defs/decisionRationale"},"blockers":{"type":"array","items":{"$ref":"#/$defs/blocker"}},"notes":{"$ref":"#/$defs/notes"}}}},
    "deferred_work":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["slice_id","reason_codes","reason","earliest_next_phase","prerequisites"],"properties":{"slice_id":{"$ref":"#/$defs/id"},"reason_codes":{"type":"array","minItems":1,"uniqueItems":true,"items":{"$ref":"#/$defs/reasonCode"}},"reason":{"$ref":"#/$defs/nonEmpty"},"earliest_next_phase":{"type":"string","enum":["next_iteration","next_release","after_contract_change","after_infra_upgrade","manual_decision"]},"prerequisites":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/nonEmpty"}}}}},
    "blocked_work":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["slice_id","blocking_reason","blocker_code","required_unblock_action","required_owner","reason_codes"],"properties":{"slice_id":{"$ref":"#/$defs/id"},"blocking_reason":{"$ref":"#/$defs/nonEmpty"},"blocker_code":{"$ref":"#/$defs/blockerCode"},"required_unblock_action":{"$ref":"#/$defs/nonEmpty"},"required_owner":{"$ref":"#/$defs/reviewerId"},"reason_codes":{"type":"array","minItems":1,"uniqueItems":true,"items":{"$ref":"#/$defs/reasonCode"}}}}},
    "deprecation":{"$ref":"#/$defs/deprecation"},
    "notes":{"$ref":"#/$defs/notes"},
    "metadata_extensions":{"$ref":"#/$defs/extensions"}
