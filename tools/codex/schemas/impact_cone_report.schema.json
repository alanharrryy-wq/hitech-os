{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"tools/codex/schemas/impact_cone_report.schema.json",
  "title":"Impact Cone Report",
  "type":"object",
  "additionalProperties":false,
  "required":["schema_version","schema_family","compatibility_mode","minimum_reader_version","breaking_change","artifact_type","artifact_id","artifact_status","run_id","generated_at_utc","generator","repository","snapshot_lineage","summary","changed_entities","aggregate_risk","validation_targets","notes"],
  "properties":{
    "schema_version":{"$ref":"#/$defs/semver"},
    "schema_family":{"type":"string","const":"HITECH_GRAPH_ANALYSIS"},
    "compatibility_mode":{"$ref":"#/$defs/compatibilityMode"},
    "minimum_reader_version":{"$ref":"#/$defs/semver"},
    "breaking_change":{"type":"boolean"},
    "artifact_type":{"type":"string","const":"IMPACT_CONE_REPORT"},
    "artifact_id":{"$ref":"#/$defs/id"},
    "artifact_status":{"$ref":"#/$defs/artifactStatus"},
    "run_id":{"$ref":"#/$defs/runId"},
    "generated_at_utc":{"type":"string","format":"date-time"},
    "generator":{"$ref":"#/$defs/generator"},
    "repository":{"$ref":"#/$defs/repository"},
    "snapshot_lineage":{"$ref":"#/$defs/snapshotLineage"},
    "summary":{"type":"object","additionalProperties":false,"required":["changed_entity_count","directly_affected_count","transitively_affected_count","affected_scope_count","affected_contract_count","affected_test_count","protected_entity_count","highest_risk_entities","highest_risk_level"],"properties":{"changed_entity_count":{"type":"integer","minimum":0},"directly_affected_count":{"type":"integer","minimum":0},"transitively_affected_count":{"type":"integer","minimum":0},"affected_scope_count":{"type":"integer","minimum":0},"affected_contract_count":{"type":"integer","minimum":0},"affected_test_count":{"type":"integer","minimum":0},"protected_entity_count":{"type":"integer","minimum":0},"highest_risk_entities":{"type":"array","uniqueItems":true,"items":{"$ref":"#/$defs/id"}},"highest_risk_level":{"$ref":"#/$defs/riskLevel"}}},
    "changed_entities":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["entity_id","entity_type","canonical_path","change_kind","owner_worker","protected","reason_codes","direct_dependents","transitive_dependents","affected_scopes","affected_contracts","affected_tests","affected_validation_commands","affected_workers","impact_radius","risk_level","dependency_basis","recommended_actions","blockers","notes"],"properties":{"entity_id":{"$ref":"#/$defs/id"},"entity_type":{"$ref":"#/$defs/entityType"},"canonical_path":{"$ref":"#/$defs/path"},"change_kind":{"type":"string","enum":["added","modified","deleted","renamed","moved","contract_changed","ownership_changed","other"]},"owner_worker":{"$ref":"#/$defs/workerId"},"protected":{"type":"boolean"},"reason_codes":{"type":"array","minItems":1,"uniqueItems":true,"items":{"$ref":"#/$defs/reasonCode"}},"direct_dependents":{"type":"array","items":{"$ref":"#/$defs/entityRef"}},"transitive_dependents":{"type":"array","items":{"$ref":"#/$defs/entityRef"}},"affected_scopes":{"type":"array","items":{"$ref":"#/$defs/scopeRef"}},"affected_contracts":{"type":"array","items":{"$ref":"#/$defs/contractTarget"}},"affected_tests":{"type":"array","items":{"$ref":"#/$defs/testTarget"}},"affected_validation_commands":{"type":"array","items":{"$ref":"#/$defs/commandTarget"}},"affected_workers":{"type":"array","minItems":1,"uniqueItems":true,"items":{"$ref":"#/$defs/workerId"}},"impact_radius":{"$ref":"#/$defs/impactRadius"},"risk_level":{"$ref":"#/$defs/riskLevel"},"dependency_basis":{"$ref":"#/$defs/dependencyBasis"},"recommended_actions":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/nonEmpty"}},"blockers":{"type":"array","items":{"$ref":"#/$defs/blocker"}},"notes":{"$ref":"#/$defs/notes"}}}},
    "aggregate_risk":{"type":"object","additionalProperties":false,"required":["overall_risk_level","reason_codes","rationale","protected_nodes_touched","validation_burden","recommended_owner_sequence"],"properties":{"overall_risk_level":{"$ref":"#/$defs/riskLevel"},"reason_codes":{"type":"array","minItems":1,"uniqueItems":true,"items":{"$ref":"#/$defs/reasonCode"}},"rationale":{"$ref":"#/$defs/nonEmpty"},"protected_nodes_touched":{"type":"array","uniqueItems":true,"items":{"$ref":"#/$defs/id"}},"validation_burden":{"type":"object","additionalProperties":false,"required":["command_count","test_count","contract_count","estimated_minutes","risk_level"],"properties":{"command_count":{"type":"integer","minimum":0},"test_count":{"type":"integer","minimum":0},"contract_count":{"type":"integer","minimum":0},"estimated_minutes":{"type":"integer","minimum":0},"risk_level":{"$ref":"#/$defs/riskLevel"}}},"recommended_owner_sequence":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/workerId"}}}},
    "validation_targets":{"type":"object","additionalProperties":false,"required":["contracts","tests","commands","smoke_paths"],"properties":{"contracts":{"type":"array","items":{"$ref":"#/$defs/contractTarget"}},"tests":{"type":"array","items":{"$ref":"#/$defs/testTarget"}},"commands":{"type":"array","items":{"$ref":"#/$defs/commandTarget"}},"smoke_paths":{"type":"array","items":{"$ref":"#/$defs/smokeTarget"}}}},
    "deprecation":{"$ref":"#/$defs/deprecation"},
    "notes":{"$ref":"#/$defs/notes"},
    "metadata_extensions":{"$ref":"#/$defs/extensions"}
  },
  "$defs":{
    "nonEmpty":{"type":"string","minLength":1},
    "path":{"type":"string","minLength":1,"pattern":"^(?!\\s*$).+"},
    "runId":{"type":"string","pattern":"^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"},
    "id":{"type":"string","minLength":3,"maxLength":255,"pattern":"^[A-Za-z0-9][A-Za-z0-9._:/-]{2,254}$"},
    "semver":{"type":"string","pattern":"^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"},
    "artifactStatus":{"type":"string","enum":["OK","WARNING","BLOCKED","INCOMPLETE","NOT_COMPARABLE"]},
    "compatibilityMode":{"type":"string","enum":["STRICT_PRODUCER","STRICT_PRODUCER_COMPAT_READER","LEGACY_ALIAS_ACCEPTED"]},
    "riskLevel":{"type":"string","enum":["NONE","LOW","MEDIUM","HIGH","CRITICAL"]},
    "entityType":{"type":"string","enum":["node","scope","contract","file","module","schema","api","test","command","other"]},
    "reasonCode":{"type":"string","enum":["ARCH_CENTRALITY_HIGH","TRANSITIVE_DEPENDENCY_HIGH","DIRECT_DEPENDENT_COUNT_HIGH","CROSS_SCOPE_IMPACT","CROSS_WORKER_IMPACT","EXTERNAL_DEPENDENCY_PRESENT","PROTECTED_POLICY_RULE","CONTRACT_SURFACE_CRITICAL","VALIDATION_BURDEN_HIGH","CYCLE_MEMBERSHIP","OWNERSHIP_AMBIGUOUS","SNAPSHOT_NOT_COMPARABLE","BASELINE_DRIFT","HOTSPOT_RECURRING","CHANGE_TOUCHES_PROTECTED_NODE","DISPATCH_REQUIRES_A_CORE","DISPATCH_REQUIRES_D_VALIDATION","DISPATCH_DEFERRED_PENDING_UNBLOCK","DISPATCH_BLOCKED_BY_POLICY","OWNERSHIP_CONFLICT","MISSING_CONTRACT","VALIDATION_GAP","INCOMPARABLE_SNAPSHOT","CONTRACT_BREAKING_CHANGE","HIGH_CHURN"]},
    "blockerCode":{"type":"string","enum":["PROTECTED_NODE_CROSSING","MISSING_CONTRACT","OWNERSHIP_CONFLICT","VALIDATION_GAP","BASELINE_MISMATCH","INCOMPARABLE_SNAPSHOT"]},
    "workerId":{"type":"string","enum":["A_core","B_tooling","C_features","D_validation","Z_aggregator","R_reviewer","E_planner","A_worker","B_worker","C_worker","D_worker","Z_integrator","R_worker","E_worker","UNASSIGNED"]},
    "generator":{"type":"object","additionalProperties":false,"required":["actor","tool_name","tool_version","execution_mode","invocation_context","source_inputs"],"properties":{"actor":{"$ref":"#/$defs/nonEmpty"},"tool_name":{"$ref":"#/$defs/nonEmpty"},"tool_version":{"$ref":"#/$defs/semver"},"execution_mode":{"type":"string","enum":["analysis","integration","planning","audit","dry_run","ci"]},"invocation_context":{"type":"object","additionalProperties":false,"required":["run_phase","command","working_directory","environment_keys"],"properties":{"run_phase":{"$ref":"#/$defs/nonEmpty"},"command":{"$ref":"#/$defs/nonEmpty"},"working_directory":{"$ref":"#/$defs/path"},"environment_keys":{"type":"array","uniqueItems":true,"items":{"$ref":"#/$defs/nonEmpty"}}}},"source_inputs":{"type":"array","minItems":1,"items":{"type":"object","additionalProperties":false,"required":["input_type","input_id","input_path","input_sha256","input_role"],"properties":{"input_type":{"type":"string","enum":["GRAPH_SNAPSHOT","RUN_BUNDLE","CONTRACT_REGISTRY","SCHEMA","MANUAL_OVERRIDE","OTHER"]},"input_id":{"$ref":"#/$defs/id"},"input_path":{"$ref":"#/$defs/path"},"input_sha256":{"type":["string","null"],"pattern":"^[A-Fa-f0-9]{64}$"},"input_role":{"$ref":"#/$defs/nonEmpty"}}}}}},
    "repository":{"type":"object","additionalProperties":false,"required":["repo_root","base_ref","head_ref","commit_sha","comparison_basis"],"properties":{"repo_root":{"$ref":"#/$defs/path"},"base_ref":{"$ref":"#/$defs/nonEmpty"},"head_ref":{"$ref":"#/$defs/nonEmpty"},"commit_sha":{"type":"string","pattern":"^[0-9a-fA-F]{7,64}$"},"comparison_basis":{"type":"string","enum":["working_tree","base_vs_head","run_snapshot","manual"]}}},
    "snapshotLineage":{"type":"object","additionalProperties":false,"required":["snapshot_id","previous_snapshot_id","baseline_snapshot_id","lineage_mode","graph_build_id"],"properties":{"snapshot_id":{"$ref":"#/$defs/id"},"previous_snapshot_id":{"type":["string","null"],"pattern":"^[A-Za-z0-9][A-Za-z0-9._:/-]{2,254}$"},"baseline_snapshot_id":{"type":["string","null"],"pattern":"^[A-Za-z0-9][A-Za-z0-9._:/-]{2,254}$"},"lineage_mode":{"type":"string","enum":["FULL","INCREMENTAL","REBUILT","NOT_AVAILABLE"]},"graph_build_id":{"$ref":"#/$defs/id"}}},
    "scopeRef":{"type":"object","additionalProperties":false,"required":["scope_id","scope_type","scope_path","owner_worker","parent_scope_id","internal_only"],"properties":{"scope_id":{"$ref":"#/$defs/id"},"scope_type":{"type":"string","enum":["package","service","module_group","contract_surface","workspace","other"]},"scope_path":{"$ref":"#/$defs/path"},"owner_worker":{"$ref":"#/$defs/workerId"},"parent_scope_id":{"type":["string","null"],"pattern":"^[A-Za-z0-9][A-Za-z0-9._:/-]{2,254}$"},"internal_only":{"type":"boolean"}}},
    "entityRef":{"type":"object","additionalProperties":false,"required":["entity_id","entity_type","canonical_path","owner_worker","protected"],"properties":{"entity_id":{"$ref":"#/$defs/id"},"entity_type":{"$ref":"#/$defs/entityType"},"canonical_path":{"$ref":"#/$defs/path"},"owner_worker":{"$ref":"#/$defs/workerId"},"protected":{"type":"boolean"}}},
    "dependencyBasis":{"type":"object","additionalProperties":false,"required":["upstream_nodes","downstream_nodes","dependency_count","transitive_dependency_count","graph_scope_reference"],"properties":{"upstream_nodes":{"type":"array","uniqueItems":true,"items":{"$ref":"#/$defs/id"}},"downstream_nodes":{"type":"array","uniqueItems":true,"items":{"$ref":"#/$defs/id"}},"dependency_count":{"type":"integer","minimum":0},"transitive_dependency_count":{"type":"integer","minimum":0},"graph_scope_reference":{"$ref":"#/$defs/nonEmpty"}}},
    "impactRadius":{"type":"object","additionalProperties":false,"required":["category","direct_count","transitive_count","affected_scope_count","affected_worker_count"],"properties":{"category":{"type":"string","enum":["LOCAL","MULTI_SCOPE","CROSS_WORKER","REPO_WIDE"]},"direct_count":{"type":"integer","minimum":0},"transitive_count":{"type":"integer","minimum":0},"affected_scope_count":{"type":"integer","minimum":0},"affected_worker_count":{"type":"integer","minimum":0}}},
    "contractTarget":{"type":"object","additionalProperties":false,"required":["target_id","contract_id","owner_worker","rationale_codes"],"properties":{"target_id":{"$ref":"#/$defs/id"},"contract_id":{"$ref":"#/$defs/id"},"owner_worker":{"$ref":"#/$defs/workerId"},"rationale_codes":{"type":"array","minItems":1,"uniqueItems":true,"items":{"$ref":"#/$defs/reasonCode"}}}},
    "testTarget":{"type":"object","additionalProperties":false,"required":["target_id","path","owner_worker","rationale_codes"],"properties":{"target_id":{"$ref":"#/$defs/id"},"path":{"$ref":"#/$defs/path"},"owner_worker":{"$ref":"#/$defs/workerId"},"rationale_codes":{"type":"array","minItems":1,"uniqueItems":true,"items":{"$ref":"#/$defs/reasonCode"}}}},
    "commandTarget":{"type":"object","additionalProperties":false,"required":["target_id","command","owner_worker","rationale_codes"],"properties":{"target_id":{"$ref":"#/$defs/id"},"command":{"$ref":"#/$defs/nonEmpty"},"owner_worker":{"$ref":"#/$defs/workerId"},"rationale_codes":{"type":"array","minItems":1,"uniqueItems":true,"items":{"$ref":"#/$defs/reasonCode"}}}},
    "smokeTarget":{"type":"object","additionalProperties":false,"required":["target_id","path","rationale_codes"],"properties":{"target_id":{"$ref":"#/$defs/id"},"path":{"$ref":"#/$defs/path"},"rationale_codes":{"type":"array","minItems":1,"uniqueItems":true,"items":{"$ref":"#/$defs/reasonCode"}}}},
    "blocker":{"type":"object","additionalProperties":false,"required":["blocker_id","blocker_code","risk_level","description","required_owner","required_unblock_action","reason_codes"],"properties":{"blocker_id":{"$ref":"#/$defs/id"},"blocker_code":{"$ref":"#/$defs/blockerCode"},"risk_level":{"$ref":"#/$defs/riskLevel"},"description":{"$ref":"#/$defs/nonEmpty"},"required_owner":{"$ref":"#/$defs/workerId"},"required_unblock_action":{"$ref":"#/$defs/nonEmpty"},"reason_codes":{"type":"array","minItems":1,"uniqueItems":true,"items":{"$ref":"#/$defs/reasonCode"}}}},
    "notes":{"type":"array","items":{"type":"string","minLength":1}},
    "deprecation":{"type":"object","additionalProperties":false,"required":["deprecated_fields","replacement_fields","compatibility_notes"],"properties":{"deprecated_fields":{"type":"array","uniqueItems":true,"items":{"$ref":"#/$defs/nonEmpty"}},"replacement_fields":{"type":"object","additionalProperties":{"$ref":"#/$defs/nonEmpty"}},"compatibility_notes":{"$ref":"#/$defs/notes"}}},
    "extensions":{"type":"object","additionalProperties":false,"patternProperties":{"^x_[A-Za-z0-9_.-]+$":{}}}
  }
}


