{
  "contract_version": 2,
  "feature_flags": {
    "enable_identical_patch_overlap": false,
    "enable_ledger_compaction": false,
    "enable_quarantine": false
  },
  "paths": {
    "repo_root": "F:/repos/hitech-os",
    "runs_dir": "F:/repos/hitech-os/tools/codex/runs",
    "worktrees_dir": "F:/repos/hitech-os/tools/codex/worktrees"
  },
  "run": {
    "allow_identical_patch_overlap": false,
    "auto_closeout_workers": true,
    "auto_preflight_repair": true,
    "auto_repair_missing_folders": true,
    "base_ref": "HEAD",
    "branch_prefix": "codex/factory",
    "chat_hygiene_policy": "clean_start_required",
    "integrator_wait_for_workers": true,
    "integrator_watch_ledger": true,
    "kind": "factory",
    "quarantine_on_suspicious_bundle": true,
    "run_prefix": "factory",
    "strict_collision_mode": true,
    "visual_baseline_owner": "C_features",
    "visual_baseline_update_default": true
  },
  "schema_version": 2,
  "security": {
    "allow_executable_artifacts": false,
    "allow_shell_execution": false,
    "secret_scan_enabled": true
  },
  "workers": {
    "allowlist_globs": {
      "A_core": [
        "apps/**",
        "docs/**",
        "packages/**"
      ],
      "B_tooling": [
        "docs/**",
        "packages/**",
        "tools/**"
      ],
      "C_features": [
        "apps/**",
        "docs/**",
        "packages/**",
        "docs/visual-baselines/**",
        "tools/_local/visual/**"
      ],
      "D_validation": [
        "docs/**",
        "packages/**",
        "tools/**"
      ]
    },
    "denylist_globs": {
      "A_core": [
        ".github/workflows/**",
        ".git/**",
        ".env",
        ".env.*"
      ],
      "B_tooling": [
        ".github/workflows/**",
        ".git/**",
        ".env",
        ".env.*"
      ],
      "C_features": [
        ".github/workflows/**",
        ".git/**",
        ".env",
        ".env.*"
      ],
      "D_validation": [
        ".github/workflows/**",
        ".git/**",
        ".env",
        ".env.*"
      ]
    },
    "required_integrator_files": [
      "STATUS.json",
      "FINAL_REPORT.txt",
      "FILES_CHANGED.json",
      "DIFF.patch",
      "MERGE_PLAN.md",
      "LOGS/INDEX.json"
    ],
    "required_worker_files": [
      "STATUS.json",
      "SUMMARY.md",
      "FILES_CHANGED.json",
      "DIFF.patch",
      "SUGGESTIONS.md",
      "SCOPE_LOCK.json",
      "HANDOFF_NOTE.json",
      "LOGS/INDEX.json",
      "CODEX_OUTPUT.txt"
    ]
  }
}
