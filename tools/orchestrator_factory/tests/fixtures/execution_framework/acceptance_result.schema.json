{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hitech.local/orchestrator_factory/schemas/execution_framework/acceptance_result.schema.json",
  "title": "Acceptance Result Schema",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "project_id",
    "run_id",
    "round_id",
    "generated_at_utc",
    "overall_status",
    "package_results"
  ],
  "properties": {
    "schema_version": {"type": "string"},
    "project_id": {"type": "string"},
    "run_id": {"type": "string"},
    "round_id": {"type": "string"},
    "generated_at_utc": {"type": "string"},
    "overall_status": {"type": "string"},
    "package_results": {"type": "array"},
    "has_bundles": {"type": "boolean"},
    "accepted_bundles": {"type": "array"},
    "rejected_bundles": {"type": "array"},
    "notes": {"type": "array", "items": {"type": "string"}}
  }
}
