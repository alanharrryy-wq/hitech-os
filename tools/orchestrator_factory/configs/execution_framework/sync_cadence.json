{
  "schema_version": "1.0",
  "system_name": "universal_execution_framework",
  "config_name": "sync_cadence",
  "purpose": "Set the formal heartbeat and checkpoint cadence for each round participant.",
  "default_time_zone": "UTC",
  "round_clock_rules": {
    "cadence_starts_at": "round initialization timestamp",
    "cadence_pauses_when_round_status_is": [
      "done"
    ],
    "cadence_grace_period": "PT5M",
    "stale_after_multiplier": 2
  },
  "cadence_profiles": [
    {
      "profile_id": "mission_control",
      "applies_to_chat_ids": [
        "governance-control"
      ],
      "heartbeat_every": "PT10M",
      "checkpoint_every": "PT30M",
      "must_publish_on_events": [
        "ownership reassigned",
        "escalation opened",
        "merge window opened",
        "coordination snapshot refreshed"
      ],
      "silence_policy": {
        "warn_after": "PT15M",
        "escalate_after": "PT20M"
      }
    },
    {
      "profile_id": "profile.01-identity-access-and-trust",
      "applies_to_chat_ids": [
        "chat.01-identity-access-and-trust"
      ],
      "heartbeat_every": "PT15M",
      "checkpoint_every": "PT60M",
      "must_publish_on_events": [
        "status changed to blocked",
        "status changed to done",
        "handoff accepted",
        "dependency requested"
      ],
      "silence_policy": {
        "warn_after": "PT20M",
        "escalate_after": "PT30M"
      }
    },
    {
      "profile_id": "profile.02-domain-data-and-persistence",
      "applies_to_chat_ids": [
        "chat.02-domain-data-and-persistence"
      ],
      "heartbeat_every": "PT15M",
      "checkpoint_every": "PT60M",
      "must_publish_on_events": [
        "status changed to blocked",
        "status changed to done",
        "handoff accepted",
        "dependency requested"
      ],
      "silence_policy": {
        "warn_after": "PT20M",
        "escalate_after": "PT30M"
      }
    },
    {
      "profile_id": "profile.03-service-contracts-and-orchestration",
      "applies_to_chat_ids": [
        "chat.03-service-contracts-and-orchestration"
      ],
      "heartbeat_every": "PT15M",
      "checkpoint_every": "PT60M",
      "must_publish_on_events": [
        "status changed to blocked",
        "status changed to done",
        "handoff accepted",
        "dependency requested"
      ],
      "silence_policy": {
        "warn_after": "PT20M",
        "escalate_after": "PT30M"
      }
    },
    {
      "profile_id": "profile.04-experience-clients-and-interactions",
      "applies_to_chat_ids": [
        "chat.04-experience-clients-and-interactions"
      ],
      "heartbeat_every": "PT15M",
      "checkpoint_every": "PT60M",
      "must_publish_on_events": [
        "status changed to blocked",
        "status changed to done",
        "handoff accepted",
        "dependency requested"
      ],
      "silence_policy": {
        "warn_after": "PT20M",
        "escalate_after": "PT30M"
      }
    },
    {
      "profile_id": "profile.05-platform-infrastructure-and-delivery",
      "applies_to_chat_ids": [
        "chat.05-platform-infrastructure-and-delivery"
      ],
      "heartbeat_every": "PT15M",
      "checkpoint_every": "PT60M",
      "must_publish_on_events": [
        "status changed to blocked",
        "status changed to done",
        "handoff accepted",
        "dependency requested"
      ],
      "silence_policy": {
        "warn_after": "PT20M",
        "escalate_after": "PT30M"
      }
    },
    {
      "profile_id": "profile.06-quality-release-and-operations",
      "applies_to_chat_ids": [
        "chat.06-quality-release-and-operations"
      ],
      "heartbeat_every": "PT15M",
      "checkpoint_every": "PT60M",
      "must_publish_on_events": [
        "status changed to blocked",
        "status changed to done",
        "handoff accepted",
        "dependency requested"
      ],
      "silence_policy": {
        "warn_after": "PT20M",
        "escalate_after": "PT30M"
      }
    }
  ],
  "checkpoint_content_requirements": {
    "planned": [
      "owner_chat_id",
      "status_summary",
      "next_planned_action"
    ],
    "in_progress": [
      "owner_chat_id",
      "status_summary",
      "completed_steps",
      "next_planned_action"
    ],
    "blocked": [
      "owner_chat_id",
      "status_summary",
      "blocker_type",
      "next_action_owner"
    ],
    "done": [
      "owner_chat_id",
      "status_summary",
      "completion_summary",
      "evidence_refs"
    ]
  },
  "heartbeat_content_requirements": [
    "chat_id",
    "run_id",
    "round_id",
    "status",
    "current_item_refs",
    "last_progress_at_utc"
  ],
  "enforcement_actions": [
    {
      "when": "heartbeat is late beyond warn_after",
      "action": "record heartbeat warning in coordination snapshot"
    },
    {
      "when": "heartbeat is late beyond escalate_after",
      "action": "open blocker_report with blocker_type infra and severity sev3 unless stronger evidence exists"
    },
    {
      "when": "checkpoint missing after a status-changing event",
      "action": "mark the item as protocol drift until a compliant checkpoint arrives"
    }
  ]
}
