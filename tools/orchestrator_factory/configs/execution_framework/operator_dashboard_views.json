{
  "schema_version": "1.0",
  "system_name": "universal_execution_framework",
  "config_name": "operator_dashboard_views",
  "purpose": "Define the operator dashboard views used to monitor liveness, coordination health, blocker pressure, handoff throughput, and round readiness for the multi-chat execution control plane.",
  "default_view_id": "coordination_overview",
  "data_sources": [
    "chat_heartbeat",
    "sync_checkpoint",
    "handoff_ticket",
    "dependency_request",
    "dependency_response",
    "blocker_report",
    "escalation_event",
    "merge_window",
    "coordination_snapshot"
  ],
  "views": [
    {
      "view_id": "coordination_overview",
      "display_name": "Coordination Overview",
      "purpose": "Show one row per chat with the latest status, liveness state, owned package, and most recent checkpoint outcome.",
      "primary_entities": [
        "chat_heartbeat",
        "sync_checkpoint"
      ],
      "group_by": [
        "chat_id"
      ],
      "sort_by": [
        "silence_state",
        "status",
        "latest_progress_at_utc"
      ],
      "columns": [
        "chat_id",
        "chat_kind",
        "owned_package_ids",
        "heartbeat_status",
        "heartbeat_age_minutes",
        "checkpoint_status",
        "current_item_refs",
        "last_progress_at_utc",
        "next_planned_action",
        "risk_flag"
      ],
      "alert_rules": [
        "highlight chats beyond warn_after",
        "pin blocked chats to the top",
        "show protocol drift when a status change lacks a checkpoint"
      ]
    },
    {
      "view_id": "blocker_pressure",
      "display_name": "Blocker Pressure",
      "purpose": "Rank active blockers by severity, blocker type, owning chat, and impact window.",
      "primary_entities": [
        "blocker_report",
        "escalation_event"
      ],
      "group_by": [
        "severity",
        "blocker_type"
      ],
      "sort_by": [
        "severity",
        "opened_at_utc"
      ],
      "columns": [
        "blocker_id",
        "severity",
        "blocker_type",
        "owner_chat_id",
        "impacted_package_ids",
        "status",
        "next_action_owner",
        "opened_at_utc",
        "due_at_utc",
        "escalation_state"
      ],
      "alert_rules": [
        "always pin sev1 and sev2 blockers",
        "mark blockers with missed due_at_utc as aging",
        "show escalation requirement when severity and taxonomy require it"
      ]
    },
    {
      "view_id": "handoff_queue",
      "display_name": "Handoff Queue",
      "purpose": "Track every open handoff by receiver, SLA, scope quality, and completion evidence.",
      "primary_entities": [
        "handoff_ticket"
      ],
      "group_by": [
        "to_chat_id",
        "status"
      ],
      "sort_by": [
        "severity",
        "response_due_at_utc"
      ],
      "columns": [
        "handoff_id",
        "handoff_kind",
        "from_chat_id",
        "to_chat_id",
        "package_id",
        "status",
        "severity",
        "response_due_at_utc",
        "ownership_mode",
        "requested_outcome",
        "acceptance_criteria_count",
        "evidence_refs_count"
      ],
      "alert_rules": [
        "show overdue acknowledgement",
        "show missing acceptance criteria as invalid",
        "show done handoffs without evidence as invalid"
      ]
    },
    {
      "view_id": "dependency_flow",
      "display_name": "Dependency Flow",
      "purpose": "Follow dependency demand and response latency across packages without direct package-to-package coordination.",
      "primary_entities": [
        "dependency_request",
        "dependency_response",
        "handoff_ticket"
      ],
      "group_by": [
        "requested_from_chat_id",
        "status"
      ],
      "sort_by": [
        "severity",
        "requested_due_at_utc"
      ],
      "columns": [
        "dependency_id",
        "requesting_chat_id",
        "requested_from_chat_id",
        "package_id",
        "status",
        "severity",
        "requested_due_at_utc",
        "latest_response_status",
        "linked_handoff_id",
        "impact_summary"
      ],
      "alert_rules": [
        "flag requests with no response before due time",
        "flag mismatched request and response package scope",
        "show dependency chains linked to active blockers"
      ]
    },
    {
      "view_id": "silence_and_cadence",
      "display_name": "Silence and Cadence",
      "purpose": "Detect silent chats, stale heartbeats, and stale checkpoints using the formal cadence rules.",
      "primary_entities": [
        "chat_heartbeat",
        "sync_checkpoint"
      ],
      "group_by": [
        "chat_id"
      ],
      "sort_by": [
        "heartbeat_age_minutes",
        "checkpoint_age_minutes"
      ],
      "columns": [
        "chat_id",
        "profile_id",
        "heartbeat_every",
        "checkpoint_every",
        "warn_after",
        "escalate_after",
        "heartbeat_age_minutes",
        "checkpoint_age_minutes",
        "silence_state",
        "enforcement_action"
      ],
      "alert_rules": [
        "warn when heartbeat exceeds warn_after",
        "open control-plane attention when heartbeat exceeds escalate_after",
        "mark checkpoint drift after required status changes"
      ]
    },
    {
      "view_id": "merge_window_readiness",
      "display_name": "Merge Window Readiness",
      "purpose": "Show package readiness for integration windows and surface conflicts before bundles collide.",
      "primary_entities": [
        "merge_window",
        "sync_checkpoint",
        "coordination_snapshot"
      ],
      "group_by": [
        "window_status",
        "package_id"
      ],
      "sort_by": [
        "window_start_at_utc",
        "package_id"
      ],
      "columns": [
        "merge_window_id",
        "window_status",
        "package_id",
        "checkpoint_status",
        "open_blocker_count",
        "open_handoff_count",
        "ready_for_integration",
        "evidence_refs_count",
        "latest_snapshot_ref"
      ],
      "alert_rules": [
        "block packages with active sev1 quality blockers",
        "flag packages without done checkpoints",
        "flag cross-package conflicts before window opens"
      ]
    }
  ],
  "saved_filters": [
    {
      "filter_id": "active_critical_items",
      "applies_to_view_ids": [
        "blocker_pressure",
        "handoff_queue",
        "dependency_flow"
      ],
      "conditions": [
        "status != done",
        "severity in [sev1, sev2]"
      ]
    },
    {
      "filter_id": "silent_chats_only",
      "applies_to_view_ids": [
        "coordination_overview",
        "silence_and_cadence"
      ],
      "conditions": [
        "silence_state in [warning, escalated]"
      ]
    },
    {
      "filter_id": "ready_for_merge",
      "applies_to_view_ids": [
        "merge_window_readiness"
      ],
      "conditions": [
        "checkpoint_status == done",
        "open_blocker_count == 0",
        "open_handoff_count == 0"
      ]
    }
  ],
  "package_map": [
    {
      "package_id": "01-identity-access-and-trust",
      "chat_id": "chat.01-identity-access-and-trust"
    },
    {
      "package_id": "02-domain-data-and-persistence",
      "chat_id": "chat.02-domain-data-and-persistence"
    },
    {
      "package_id": "03-service-contracts-and-orchestration",
      "chat_id": "chat.03-service-contracts-and-orchestration"
    },
    {
      "package_id": "04-experience-clients-and-interactions",
      "chat_id": "chat.04-experience-clients-and-interactions"
    },
    {
      "package_id": "05-platform-infrastructure-and-delivery",
      "chat_id": "chat.05-platform-infrastructure-and-delivery"
    },
    {
      "package_id": "06-quality-release-and-operations",
      "chat_id": "chat.06-quality-release-and-operations"
    }
  ]
}
