  "routing_table": [
    {
      "message_type": "chat_heartbeat",
      "source_chat_kinds": [
        "mission_control",
        "package_worker"
      ],
      "required_channel_id": "channel.heartbeats",
      "handled_by": "governance-control"
    },
    {
      "message_type": "sync_checkpoint",
      "source_chat_kinds": [
        "mission_control",
        "package_worker"
      ],
      "required_channel_id": "channel.sync_checkpoints",
      "handled_by": "governance-control"
    },
    {
      "message_type": "handoff_ticket",
      "source_chat_kinds": [
        "mission_control",
        "package_worker"
      ],
      "required_channel_id": "channel.handoffs",
      "handled_by": "governance-control"
    },
    {
      "message_type": "dependency_request",
      "source_chat_kinds": [
        "package_worker"
      ],
      "required_channel_id": "channel.dependencies",
      "handled_by": "governance-control"
    },
    {
      "message_type": "dependency_response",
      "source_chat_kinds": [
        "mission_control"
      ],
      "required_channel_id": "channel.dependencies",
      "handled_by": "governance-control"
    },
    {
      "message_type": "blocker_report",
      "source_chat_kinds": [
        "mission_control",
        "package_worker"
      ],
      "required_channel_id": "channel.blockers",
      "handled_by": "governance-control"
    },
    {
      "message_type": "escalation_event",
      "source_chat_kinds": [
        "mission_control"
      ],
      "required_channel_id": "channel.escalations",
      "handled_by": "governance-control"
    },
    {
      "message_type": "merge_window",
      "source_chat_kinds": [
        "mission_control"
      ],
      "required_channel_id": "channel.merge_windows",
      "handled_by": "governance-control"
    }
  ]
