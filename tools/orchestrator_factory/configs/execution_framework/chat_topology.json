{
  "schema_version": "1.0",
  "system_name": "universal_execution_framework",
  "config_name": "chat_topology",
  "mission_control_chat_id": "governance-control",
  "topology_mode": "hub_and_spoke",
  "purpose": "Define the official chat graph, ownership boundaries, and coordination channels for deterministic multi-chat execution.",
  "rules": {
    "direct_package_to_package_messages_allowed": false,
    "all_cross_package_coordination_flows_through": "governance-control",
    "operator_visibility_required_for": [
      "blockers",
      "escalations",
      "dependency handoffs",
      "merge windows",
      "run and round checkpoints"
    ],
    "package_chats_may_only_claim_work_for_owned_package_ids": true,
    "state_changes_must_be_published_to_channels": [
      "checkpoints",
      "blockers",
      "handoffs"
    ]
  },
  "channels": [
    {
      "channel_id": "channel.heartbeats",
      "display_name": "Heartbeats",
      "message_types": [
        "chat_heartbeat"
      ],
      "publishers": [
        "governance-control",
        "chat.01-identity-access-and-trust",
        "chat.02-domain-data-and-persistence",
        "chat.03-service-contracts-and-orchestration",
        "chat.04-experience-clients-and-interactions",
        "chat.05-platform-infrastructure-and-delivery",
        "chat.06-quality-release-and-operations"
      ],
      "subscribers": [
        "governance-control"
      ],
      "retention_policy": {
        "retain_latest_per_chat": 20,
        "retain_window_hours": 24
      },
      "purpose": "Liveness and cadence monitoring."
    },
    {
      "channel_id": "channel.sync_checkpoints",
      "display_name": "Sync Checkpoints",
      "message_types": [
        "sync_checkpoint",
        "coordination_snapshot"
      ],
      "publishers": [
        "governance-control",
        "chat.01-identity-access-and-trust",
        "chat.02-domain-data-and-persistence",
        "chat.03-service-contracts-and-orchestration",
        "chat.04-experience-clients-and-interactions",
        "chat.05-platform-infrastructure-and-delivery",
        "chat.06-quality-release-and-operations"
      ],
      "subscribers": [
        "governance-control"
      ],
      "retention_policy": {
        "retain_latest_per_chat": 10,
        "retain_window_hours": 72
      },
      "purpose": "Round state and work completion visibility."
    },
    {
      "channel_id": "channel.handoffs",
      "display_name": "Handoffs",
      "message_types": [
        "handoff_ticket"
      ],
      "publishers": [
        "governance-control",
        "chat.01-identity-access-and-trust",
        "chat.02-domain-data-and-persistence",
        "chat.03-service-contracts-and-orchestration",
        "chat.04-experience-clients-and-interactions",
        "chat.05-platform-infrastructure-and-delivery",
        "chat.06-quality-release-and-operations"
      ],
      "subscribers": [
        "governance-control"
      ],
      "retention_policy": {
        "retain_latest_per_chat": 50,
        "retain_window_hours": 168
      },
      "purpose": "Explicit transfer of work items, ownership, and evidence."
    },
    {
      "channel_id": "channel.dependencies",
      "display_name": "Dependency Requests",
      "message_types": [
        "dependency_request",
        "dependency_response"
      ],
      "publishers": [
        "chat.01-identity-access-and-trust",
        "chat.02-domain-data-and-persistence",
        "chat.03-service-contracts-and-orchestration",
        "chat.04-experience-clients-and-interactions",
        "chat.05-platform-infrastructure-and-delivery",
        "chat.06-quality-release-and-operations"
      ],
      "subscribers": [
        "governance-control"
      ],
      "retention_policy": {
        "retain_latest_per_chat": 50,
        "retain_window_hours": 168
      },
      "purpose": "Cross-package dependency negotiation without ad-hoc chat."
    },
    {
      "channel_id": "channel.blockers",
      "display_name": "Blockers",
      "message_types": [
        "blocker_report"
      ],
      "publishers": [
        "governance-control",
        "chat.01-identity-access-and-trust",
        "chat.02-domain-data-and-persistence",
        "chat.03-service-contracts-and-orchestration",
        "chat.04-experience-clients-and-interactions",
        "chat.05-platform-infrastructure-and-delivery",
        "chat.06-quality-release-and-operations"
      ],
      "subscribers": [
        "governance-control"
      ],
      "retention_policy": {
        "retain_latest_per_chat": 100,
        "retain_window_hours": 168
      },
      "purpose": "Triage queue for execution blockers."
    },
    {
      "channel_id": "channel.escalations",
      "display_name": "Escalations",
      "message_types": [
        "escalation_event"
      ],
      "publishers": [
        "governance-control"
      ],
      "subscribers": [
        "governance-control"
      ],
      "retention_policy": {
        "retain_latest_per_chat": 100,
        "retain_window_hours": 336
      },
      "purpose": "Traceable escalation records and decisions."
    },
    {
      "channel_id": "channel.merge_windows",
      "display_name": "Merge Windows",
      "message_types": [
        "merge_window"
      ],
      "publishers": [
        "governance-control"
      ],
      "subscribers": [
        "governance-control",
        "chat.01-identity-access-and-trust",
        "chat.02-domain-data-and-persistence",
        "chat.03-service-contracts-and-orchestration",
        "chat.04-experience-clients-and-interactions",
        "chat.05-platform-infrastructure-and-delivery",
        "chat.06-quality-release-and-operations"
      ],
      "retention_policy": {
        "retain_latest_per_chat": 20,
        "retain_window_hours": 168
      },
      "purpose": "Scheduled integration windows to reduce bundle collisions."
    }
  ],
  "chats": [
    {
      "chat_id": "governance-control",
      "display_name": "Governance Control",
      "chat_kind": "mission_control",
      "role": "coordination_hub",
      "owns_package_ids": [],
      "may_publish_to_channels": [
        "channel.heartbeats",
        "channel.sync_checkpoints",
        "channel.handoffs",
        "channel.blockers",
        "channel.escalations",
        "channel.merge_windows"
      ],
      "may_consume_from_channels": [
        "channel.heartbeats",
        "channel.sync_checkpoints",
        "channel.handoffs",
        "channel.dependencies",
        "channel.blockers",
        "channel.escalations",
        "channel.merge_windows"
      ],
      "allowed_actions": [
        "open and resolve handoffs",
        "route dependency requests",
        "triage blockers",
        "declare escalations",
        "open merge windows",
        "publish coordination snapshots",
        "enforce cadence and protocol"
      ],
      "forbidden_actions": [
        "editing package-owned source files",
        "claiming package execution ownership",
        "bypassing published protocol state transitions"
      ]
    },
    {
      "chat_id": "chat.01-identity-access-and-trust",
      "display_name": "Identity, Access, and Trust",
      "chat_kind": "package_worker",
      "role": "package_execution",
      "owns_package_ids": [
        "01-identity-access-and-trust"
      ],
      "may_publish_to_channels": [
        "channel.heartbeats",
        "channel.sync_checkpoints",
        "channel.handoffs",
        "channel.dependencies",
        "channel.blockers"
      ],
      "may_consume_from_channels": [
        "channel.handoffs",
        "channel.merge_windows"
      ],
      "allowed_actions": [
        "execute owned package work",
        "emit heartbeat and checkpoints",
        "request dependencies through mission control",
        "report blockers with evidence",
        "accept or reject a handoff directed to owned package"
      ],
      "forbidden_actions": [
        "direct messaging another package chat",
        "changing ownership outside owned package",
        "closing escalations",
        "declaring merge windows"
      ]
    },
    {
      "chat_id": "chat.02-domain-data-and-persistence",
      "display_name": "Domain, Data, and Persistence",
      "chat_kind": "package_worker",
      "role": "package_execution",
      "owns_package_ids": [
        "02-domain-data-and-persistence"
      ],
      "may_publish_to_channels": [
        "channel.heartbeats",
        "channel.sync_checkpoints",
        "channel.handoffs",
        "channel.dependencies",
        "channel.blockers"
      ],
