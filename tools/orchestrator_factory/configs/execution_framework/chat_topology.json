        "declaring merge windows"
      ]
    },
    {
      "chat_id": "chat.03-service-contracts-and-orchestration",
      "display_name": "Service Contracts and Orchestration",
      "chat_kind": "package_worker",
      "role": "package_execution",
      "owns_package_ids": [
        "03-service-contracts-and-orchestration"
      ],
      "may_publish_to_channels": [
