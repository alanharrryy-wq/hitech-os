{
  "schema_version": "1.0",
  "system_name": "universal_execution_framework",
  "config_name": "chat_capability_matrix",
  "purpose": "Route work to the correct chat by capability, package ownership, and protocol responsibility.",
  "routing_principles": [
    "Use package ownership before capability breadth.",
    "Use governance control for cross-package coordination.",
    "Escalations, dependency arbitration, and merge windows belong to mission control.",
    "Package chats execute only the work that lands inside owned paths and package scope.",
    "If a task touches more than one package, split it into handoffs or dependency requests instead of assigning it directly."
  ],
  "capabilities": [
    {
      "capability_id": "package_execution",
      "description": "Produce package-local outputs, manifests, and evidence for owned paths.",
      "owned_by_chat_kinds": [
        "package_worker"
      ],
      "routing_rule": "Route to the single package chat that owns the target package_id."
    },
    {
      "capability_id": "dependency_coordination",
      "description": "Receive, validate, prioritize, and answer dependency requests.",
      "owned_by_chat_kinds": [
        "mission_control"
      ],
      "routing_rule": "Route to governance control, then forward the accepted work as an explicit handoff."
    },
    {
      "capability_id": "handoff_management",
      "description": "Create, accept, reject, resolve, and audit handoff tickets.",
      "owned_by_chat_kinds": [
        "mission_control",
        "package_worker"
      ],
      "routing_rule": "Creation and routing go through governance control; package chats may only act on tickets addressed to them."
    },
    {
      "capability_id": "blocker_triage",
      "description": "Classify blockers, set severity, and drive next action.",
      "owned_by_chat_kinds": [
        "mission_control",
        "package_worker"
      ],
      "routing_rule": "Package chats may report and update evidence; governance control owns final triage state."
    },
    {
      "capability_id": "cadence_enforcement",
      "description": "Monitor heartbeat and checkpoint compliance.",
      "owned_by_chat_kinds": [
        "mission_control"
      ],
      "routing_rule": "Route all liveness monitoring to governance control."
    },
    {
      "capability_id": "merge_window_management",
      "description": "Open, adjust, and close integration windows.",
      "owned_by_chat_kinds": [
        "mission_control"
      ],
      "routing_rule": "Route to governance control only."
    },
    {
      "capability_id": "coordination_snapshot",
      "description": "Assemble round-wide state from checkpoints, blockers, handoffs, and heartbeats.",
      "owned_by_chat_kinds": [
        "mission_control"
      ],
      "routing_rule": "Route to governance control only."
    }
  ],
  "chat_matrix": [
