  "routing_decisions": [
    {
      "decision_id": "route-by-package",
      "when": "A task has exactly one package_id and no cross-package dependency.",
      "route_to": "matching package chat",
      "why": "Preserves package ownership and keeps execution local."
    },
    {
      "decision_id": "route-cross-package-to-governance",
      "when": "A task references more than one package_id, requires arbitration, or needs a contract from another package.",
      "route_to": "governance-control",
      "why": "Cross-package work must become a governed handoff or dependency flow."
    },
    {
      "decision_id": "route-liveness-to-governance",
      "when": "A task computes late heartbeats, stale checkpoints, or silent chats.",
      "route_to": "governance-control",
      "why": "Cadence is a control-plane responsibility."
    },
    {
      "decision_id": "route-merge-window-to-governance",
      "when": "A task reserves or changes integration timing.",
      "route_to": "governance-control",
      "why": "Merge windows must be globally serialized."
    }
  ]
