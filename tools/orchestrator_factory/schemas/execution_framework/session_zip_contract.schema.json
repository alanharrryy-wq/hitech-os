{
  "schema_version": "1.0",
  "name": "session_zip_contract",
  "required_fields": {
    "schema_version": "string",
    "contract_version": "string",
    "zip_path": "string",
    "files": "array",
    "flags": "object",
    "validation": "object"
  },
  "optional_fields": {
    "x-contract": "object"
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hitech.local/orchestrator_factory/schemas/execution_framework/session_zip_contract.schema.json",
  "title": "One Button Session ZIP Contract v1.2",
  "description": "Contract descriptor and validation report schema for canonical one-button session exports. The guardrail validate_session_zip_contract.py consumes the x-contract metadata below and emits validation reports conforming to this structure.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "contract_version",
    "zip_path",
    "files",
    "flags",
    "validation"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "contract_version": {
      "type": "string",
      "const": "1.2"
    },
    "zip_path": {
      "type": "string",
      "minLength": 1
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "size_bytes",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 0
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-fA-F0-9]{64}$"
          }
        }
      }
    },
    "flags": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "packets_generated",
        "prompts_generated"
      ],
      "properties": {
        "packets_generated": {
          "type": "boolean"
        },
        "prompts_generated": {
          "type": "boolean"
        }
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required_files_present",
        "conditional_requirements_satisfied",
        "session_manifest_valid",
        "acceptance_report_valid",
        "session_file_index_valid",
        "errors",
        "warnings"
      ],
      "properties": {
        "required_files_present": {
          "type": "boolean"
        },
        "conditional_requirements_satisfied": {
          "type": "boolean"
        },
        "session_manifest_valid": {
          "type": "boolean"
        },
        "acceptance_report_valid": {
          "type": "boolean"
        },
        "session_file_index_valid": {
          "type": "boolean"
        },
        "errors": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  },
  "x-contract": {
    "required_files": [
      "session/session_manifest.json",
      "session/session_summary.md",
      "session/operator_instructions.md",
      "session/intake_normalized.md",
      "session/session_file_index.json",
      "project/project_manifest.json",
      "run/run_manifest.json",
      "round/round_manifest.json",
      "round/coordination/snapshots/coordination_snapshot.latest.json",
      "round/coordination/snapshots/coordination_snapshot.latest.md",
      "round/reports/readiness_report.json",
      "round/reports/acceptance_report.json"
    ],
    "conditional_groups": [
      {
        "name": "packets",
        "condition_flag": "packets_generated",
        "required_patterns": [
          "^round/packets/.+/work_packet\\.json$"
        ],
        "minimum_matches": 1
      },
      {
        "name": "prompts",
        "condition_flag": "prompts_generated",
        "required_patterns": [
          "^round/prompts/.+\\.prompt\\.md$",
          "^round/prompts/mission-control\\.prompt\\.md$"
        ],
        "minimum_matches": 2
      }
    ],
    "required_vs_optional": {
      "required": [
        "session/session_manifest.json",
        "session/session_summary.md",
        "session/operator_instructions.md",
        "session/intake_normalized.md",
        "session/session_file_index.json",
        "project/project_manifest.json",
        "run/run_manifest.json",
        "round/round_manifest.json",
        "round/coordination/snapshots/coordination_snapshot.latest.json",
        "round/coordination/snapshots/coordination_snapshot.latest.md",
        "round/reports/readiness_report.json",
        "round/reports/acceptance_report.json"
      ],
      "optional": [
        "round/packets/<package_id>/work_packet.json",
        "round/prompts/<package_id>.prompt.md",
        "round/prompts/mission-control.prompt.md",
        "session/*.tmp",
        "logs/*",
        "metrics/*"
      ]
    },
    "acceptance_report": {
      "required_fields": [
        "schema_version",
        "project_id",
        "run_id",
        "round_id",
        "generated_at_utc",
        "overall_status",
        "package_results"
      ],
      "stub_valid_if": {
        "overall_status": "pending",
        "package_results": []
      },
      "optional_fields": [
        "has_bundles",
        "accepted_bundles",
        "rejected_bundles",
        "notes"
      ]
    }
  }
}
