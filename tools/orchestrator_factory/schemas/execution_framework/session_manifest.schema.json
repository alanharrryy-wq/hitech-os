{
  "schema_version": "1.0",
  "name": "session_manifest",
  "required_fields": {
    "schema_version": "string",
    "session_id": "string",
    "launcher_version": "string",
    "created_at_utc": "string",
    "session_mode": "string",
    "policy": "string",
    "status": "string",
    "project": "object",
    "run": "object",
    "round": "object",
    "intent": "object",
    "checks": "object",
    "idempotency": "object",
    "lock": "object",
    "artifacts": "object",
    "issues": "array"
  },
  "optional_fields": {},
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hitech.local/orchestrator_factory/schemas/execution_framework/session_manifest.schema.json",
  "title": "One Button Session Manifest v1.2",
  "description": "Authoritative schema for the exported session/session_manifest.json payload produced by the one-button session launcher.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "session_id",
    "launcher_version",
    "created_at_utc",
    "session_mode",
    "policy",
    "status",
    "project",
    "run",
    "round",
    "intent",
    "checks",
    "idempotency",
    "lock",
    "artifacts",
    "issues"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "session_id": {
      "type": "string",
      "minLength": 1
    },
    "launcher_version": {
      "type": "string",
      "minLength": 1
    },
    "created_at_utc": {
      "type": "string",
      "format": "date-time",
      "description": "UTC timestamp in ISO-8601 format. Example: 2026-03-27T18:22:10Z"
    },
    "session_mode": {
      "type": "string",
      "enum": [
        "existing_project",
        "new_project"
      ]
    },
    "policy": {
      "type": "string",
      "enum": [
        "resume_latest_round",
        "open_new_round",
        "upgrade"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "ready_for_dispatch",
        "blocked",
        "failed",
        "reused"
      ]
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "project_id",
        "project_name",
        "initiative_type"
      ],
      "properties": {
        "project_id": {
          "type": "string",
          "minLength": 1
        },
        "project_name": {
          "type": "string",
          "minLength": 1
        },
        "initiative_type": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run_id",
        "action"
      ],
      "properties": {
        "run_id": {
          "type": "string",
          "minLength": 1
        },
        "action": {
          "type": "string",
          "enum": [
            "reuse_existing_run",
            "create_new_run"
          ]
        }
      }
    },
    "round": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "round_id",
        "parent_round_id"
      ],
      "properties": {
        "round_id": {
          "type": "string",
          "minLength": 1
        },
        "parent_round_id": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "intent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "raw",
        "normalized"
      ],
      "properties": {
        "raw": {
          "type": "string"
        },
        "normalized": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "checks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contracts",
        "smoke",
        "readiness_stage_install",
        "readiness_stage_round"
      ],
      "properties": {
        "contracts": {
          "type": "string",
          "enum": [
            "pass",
            "fail"
          ]
        },
        "smoke": {
          "type": "string",
          "enum": [
            "pass",
            "fail"
          ]
        },
        "readiness_stage_install": {
          "type": "string",
          "enum": [
            "ready",
            "not_ready"
          ]
        },
        "readiness_stage_round": {
          "type": "string",
          "enum": [
            "ready",
            "not_ready"
          ]
        }
      }
    },
    "idempotency": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "decision",
        "context_hashes"
      ],
      "properties": {
        "key": {
          "type": "string",
          "minLength": 64
        },
        "decision": {
          "type": "string",
          "enum": [
            "new_session",
            "reused",
            "retry_required"
          ]
        },
        "context_hashes": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "project_manifest_sha256",
            "run_manifest_sha256",
            "round_manifest_sha256"
          ],
          "properties": {
            "project_manifest_sha256": {
              "$ref": "#/$defs/shaOrNone"
            },
            "run_manifest_sha256": {
              "$ref": "#/$defs/shaOrNone"
            },
            "round_manifest_sha256": {
              "$ref": "#/$defs/shaOrNone"
            }
          }
        }
      }
    },
    "lock": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lock_id",
        "lock_path",
        "pid",
        "host"
      ],
      "properties": {
        "lock_id": {
          "type": "string",
          "minLength": 1
        },
        "lock_path": {
          "type": "string",
          "minLength": 1
        },
        "pid": {
          "type": "integer",
          "minimum": 0
        },
        "host": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "session_zip_path",
        "session_zip_sha256",
        "session_zip_size_bytes",
        "handoff_copy_path"
      ],
      "properties": {
        "session_zip_path": {
          "type": "string",
          "minLength": 1
        },
        "session_zip_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "session_zip_size_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "handoff_copy_path": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "severity",
          "message"
        ],
        "properties": {
          "code": {
            "type": "string",
            "minLength": 1
          },
          "severity": {
            "type": "string",
            "enum": [
              "warning",
              "error"
            ]
          },
          "message": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-fA-F0-9]{64}$"
    },
    "shaOrNone": {
      "type": "string",
      "pattern": "^(none|[a-fA-F0-9]{64})$"
    }
  }
}
