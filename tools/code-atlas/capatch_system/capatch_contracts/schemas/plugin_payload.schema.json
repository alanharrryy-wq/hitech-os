{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "capatch.plugin_payload.schema.json",
  "title": "PluginPayload",
  "type": "object",
  "required": [
    "plugin_id",
    "plugin_kind",
    "plugin_phase",
    "schema_version"
  ],
  "properties": {
    "plugin_id": {
      "type": "string",
      "minLength": 1
    },
    "plugin_kind": {
      "type": "string",
      "enum": [
        "guard",
        "target-detector",
        "context-enricher",
        "collector",
        "analyzer",
        "recommender",
        "fixer",
        "verifier",
        "exporter"
      ]
    },
    "plugin_phase": {
      "type": "string",
      "enum": [
        "resolve-target",
        "collect",
        "enrich",
        "analyze",
        "recommend",
        "fix",
        "verify",
        "export"
      ]
    },
    "schema_version": {
      "type": "string",
      "const": "2.0.0"
    },
    "summary": {
      "type": "string"
    },
    "skip_reason": {
      "type": "string"
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "recommendations": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "fixes": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "verification_results": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "metadata": {
      "type": "object"
    }
  },
  "additionalProperties": true
}
