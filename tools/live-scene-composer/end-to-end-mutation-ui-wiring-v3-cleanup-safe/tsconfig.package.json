{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "strict": false,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": [
    "source/**/*.ts",
    "source/**/*.d.ts"
  ],
  "exclude": [
    "source/**/__tests__/**"
  ]
}
