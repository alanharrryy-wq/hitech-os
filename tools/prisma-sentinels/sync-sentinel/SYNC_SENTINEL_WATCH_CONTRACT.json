    "tools/prisma-sentinels/sync-sentinel/sync_sentinel/evidence.py",
    "tools/prisma-sentinels/sync-sentinel/sync_sentinel/safety.py",
    "tools/prisma-sentinels/sync-sentinel/sync_sentinel/watch.py",
