  "scanPatterns": [
    "tools/prisma-sentinels/sync-sentinel/README.md",
    "tools/prisma-sentinels/sync-sentinel/docs/**",
    "tools/prisma-sentinels/sync-sentinel/tests/**",
    "tools/prisma-sentinels/sync-sentinel/sync_sentinel/__init__.py",
    "tools/prisma-sentinels/sync-sentinel/sync_sentinel/progress.py"
  ],
  "events": {
    "pullRequest": "classify changed files; NONE/SCAN/CERTIFY",
    "pushMain": "classify changed files; relevant impact gets current-SHA certify",
    "schedule": "force CERTIFY weekly regardless of paths",
    "workflowDispatch": "force CERTIFY"
  },
  "weeklySchedule": "17 10 * * 1",
  "concurrency": {
    "pullRequest": "one active run per PR; cancel obsolete in-progress SHA",
    "main": "group by main SHA; never cancel evidence for a different canonical SHA",
    "schedule": "one weekly safety-net run"
  },
  "artifacts": {
    "retentionDays": 30,
    "alwaysForScanOrCertify": true,
    "sanitized": true,
    "requiredFields": [
      "canonical head",
      "impact classification",
      "wake files",
      "source drift",
      "cleanup",
      "owned process state",
      "live DB safety",
      "negative fixtures",
      "failure localization",
      "timeline",
      "assertions",
      "environment sanitized",
      "contracts",
      "certification"
    ]
  }
}
