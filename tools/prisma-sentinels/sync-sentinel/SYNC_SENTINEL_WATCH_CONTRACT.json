{
  "schemaVersion": "prisma.sync-sentinel.watch.v1",
  "capabilityId": "tooling.sync_sentinel",
  "policy": {
    "levels": ["NONE", "SCAN", "CERTIFY"],
    "none": "No sync relevance: emit a clean skip and do not install the runtime dependency islands.",
    "scan": "Sentinel-only or low-risk tooling/documentation: self-test plus scan.",
    "certify": "Sync contract/runtime/Prisma/dependency/Mobile owner impact: self-test, scan, diagnose and isolated certify.",
    "unknownFailsClosed": true,
    "passOpensIssue": false,
    "productionCertified": false
  },
  "canonicalRuntimes": {
    "tablet": 3120,
    "pc": 3130,
    "mobile": 3140
  },
