{
  "schema": "prisma.visual-promotion.corpus-certification.contract.v1",
  "version": "1.0.0",
  "phase": "CANDIDATE_CORPUS_CERTIFICATION_PARALLEL",
  "candidateOnly": true,
  "expectedCorpusCount": 2097,
  "certificationLabels": [
    "VALID_ELIGIBLE_CANDIDATE",
    "VALID_REGISTER_TARGET_FIRST",
    "VALID_BLOCKED",
    "VALID_NOT_APPLICABLE",
    "INVALID_SCHEMA",
    "INVALID_REFERENCE",
    "INVALID_PROVENANCE"
