    "unknownHeadHashOrShape": "FAIL_CLOSED"
  },
  "semanticReview": {
    "separateFromCollisionFingerprint": true,
    "candidateFingerprintIsSemanticUniquenessProof": false,
    "recipeEqualityImpliesNeutralMeaning": false,
    "allNullNoMatchGroupsExcluded": true,
    "canonicalIdsAssigned": false
  },
  "hardStops": {
    "currentlyAuthorizedCanonicalPromotions": 0,
    "runtimeVisualGreen": false,
    "wholeSurfaceApplyReady": false,
    "productRuntimeMutation": false,
    "globalIdentityRifatNdcTargetIndexPromotion": false,
    "materialityCatalogPolicy": "STANDBY_USER_INVOKED_ONLY",
    "broadRediscoveryAllowed": false
  }
}
