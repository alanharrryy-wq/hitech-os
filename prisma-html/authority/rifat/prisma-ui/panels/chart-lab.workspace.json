  "required_checks": [
    "node tools/quality/ui-certainty.mjs self-test --strict",
    "node tools/quality/ui-certainty.mjs certify --surface chart-lab --strict",
    "node tools/quality/ui-certainty.mjs contracts --surface chart-lab --strict",
    "node tools/quality/ui-certainty.mjs anchors --surface chart-lab --strict",
    "node tools/quality/ui-certainty.mjs selectors --surface chart-lab --strict",
    "node tools/quality/ui-certainty.mjs zero-important",
    "node tools/quality/ui-certainty.mjs scope --all"
