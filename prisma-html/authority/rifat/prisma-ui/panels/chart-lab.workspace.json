  "owner_component": "products/chart-lab/app/src/components/PrismaChartLabShell.tsx",
  "owner_css_module": null,
  "canonical_selectors": [
    "[data-prisma-panel=\"chart-lab.workspace\"]"
  ],
  "required_anchors": [
    {
      "attribute": "data-prisma-panel",
      "value": "chart-lab.workspace"
    },
    {
      "attribute": "data-prisma-surface",
      "value": "chart-lab"
    },
    {
      "attribute": "data-prisma-route",
      "value": "/"
    }
  ],
  "allowed_files": [
    ".prisma-ui/current/**",
    ".prisma-ui/panels/**",
    ".prisma-ui/panels/chart-lab.workspace.json",
    ".prisma-ui/registry.json",
    ".prisma-ui/surfaces.json",
    "docs/quality/UI_CERTAINTY_SUPREME_MESH.md",
    "package.json",
    "tools/quality/ui-certainty.mjs",
    "tools/quality/ui-certainty/**",
    "products/chart-lab/app/src/components/PrismaChartLabShell.tsx"
  ],
  "forbidden_surfaces": [
    "web",
    "tablet",
    "pc",
    "mobile",
    "control-center"
  ],
  "target_strings": [
    "chart-lab.workspace",
    "chart-lab",
    "/",
    "products/chart-lab/app/src/components/PrismaChartLabShell.tsx"
  ],
