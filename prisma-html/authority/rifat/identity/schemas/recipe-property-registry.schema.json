{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "prisma.identity.recipe-property-registry.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "version",
    "registryDriven",
    "valueModes",
    "properties"
  ],
  "properties": {
    "schema": {
      "const": "prisma.identity.recipe-property-registry.v1"
    },
    "version": {
      "type": "string"
    },
    "registryDriven": {
      "const": true
    },
    "valueModes": {
      "type": "array",
      "minItems": 7,
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "properties": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "propertyId",
          "cssProperty",
          "domains",
          "valueType",
          "zeroSemantics",
          "rendererStatus"
        ],
        "properties": {
          "propertyId": {
            "type": "string"
          },
          "cssProperty": {
            "type": [
              "string",
              "null"
            ]
          },
          "domains": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "valueType": {
            "type": "string"
          },
          "zeroSemantics": {
            "type": "string"
          },
          "rendererStatus": {
            "const": "INSTRUCTION_ONLY_NO_RUNTIME_RENDERER"
          }
        }
      }
    }
  }
}
