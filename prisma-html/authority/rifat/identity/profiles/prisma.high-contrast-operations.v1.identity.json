{
  "schema": "prisma.identity.profile.v1",
  "id": "prisma.high-contrast-operations.v1",
  "version": "1.0.0",
  "status": "CANDIDATE",
  "name": "PRISMA High Contrast Operations",
  "intent": "Contraste operacional reforzado para lectura veloz, foco visible y estados inequívocos.",
  "traits": [
    "high-contrast",
    "accessible",
    "decisive",
    "operational",
    "low-ambiguity"
  ],
  "tokenOverrides": {
    "color.canvas": "#f7f8fa",
    "color.surface": "#ffffff",
    "color.surfaceElevated": "#ffffff",
    "color.surfaceMuted": "#e9edf2",
    "color.textPrimary": "#0d1522",
    "color.textSecondary": "#344054",
    "color.textMuted": "#526173",
    "color.accent": "#003cc5",
    "color.focus": "#006dff",
    "material.surfaceFill": "#ffffff",
    "material.surfaceBorder": "rgba(13,21,34,0.28)",
